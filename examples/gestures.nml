// Gestures. A gesture is a clip that only moves an effect's controls: give it rows for the effect and no
// `instrument:` or notes, and it plays once, puts the controls back, and sounds like the effect doing its thing.
// Here two of them stutter a break and a third fires a hit like a machine gun. On a controller, `launch:` puts each on a pad (notes 36 to 38, and 40), and
// `quantize:` lands it on the next sixteenth, so a pad hit a little early is still in time. In a file, as below,
// `at` starts them in turn so you can render it. Pad 39 is different: it holds the stutter for as long as the key
// is down, because `ctl held = midi.note(39)` is open while the key is.
// Render with:  niminal-live render examples/gestures.nml --out gestures.wav --bars 4
config { channels: stereo }
tempo 130bpm

brk = sample("break.wav").beats(4)
chops = brk.slices(16)

bus break_audio: stereo

instr break_voice(sample) {
  break_audio += chops(sample: sample)
}

// A persistent fx reads the bus, so the stutter keeps hearing the break across notes. `repeat_last` freezes the
// last `length` of the sound and repeats it for as long as `hold` is above zero, then lets the sound through
// again. Each repeat is `fade` times the level of the one before and `shrink` times the length, `pitch` (in
// semitones) changes the speed the piece is read at, `gate` is how much of each repeat sounds, and a `reverse`
// above zero plays it backwards. `shape` fades each repeat out (above zero) or swells it in (below), and `damp`
// darkens each repeat more than the last, like a tape echo. `attack` is how much of a repeat it takes to rise to full
// level, `bend` turns the straight `shape` fade into an exponential one (a pluck), and `accent` makes every second
// repeat quieter, so a roll has a beat in it.
ctl held = midi.note(39)

fx break_stutter(
  hold: 0..1 = 0, length: 1ms..1sec = 1/4beat, pitch: -12..12 = 0, fade: 0..1 = 0.9,
  shrink: 0.5..1 = 1, gate: 0.05..1 = 1, reverse: 0..1 = 0, shape: -1..1 = 0, damp: 0..0.95 = 0,
  attack: 0..1 = 0, bend: 0..1 = 0, accent: 0..1 = 0
) {
  out = break_audio.repeat_last(hold: hold + held, length: length, pitch: pitch, fade: fade, shrink: shrink, gate: gate, reverse: reverse,
    shape: shape, damp: damp, attack: attack, bend: bend, accent: accent)
}


// A macro is one control that moves several: the controller on CC 1 sweeps the stutter's tape-echo `damp` and its
// `shape` together (a range written backwards runs the other way). Nothing needs to be playing: it only sets the
// controls, so the gestures below sound different as it moves. The dock shows it as a slider, too.
macro tension {
  input: midi.cc(1)
  break_stutter {
    damp:  0..0.6
    shape: 0..0.8
  }
}

clip chop {
  instrument: break_voice
  notes: [s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13 s14 s15]
}

// pad 36: a machine gun. This one plays the chopper instead of moving the effect: the stutter can only repeat
// what was just heard, which in a break is often a short tick, so the gun fires the hit itself, sixteen times in
// half a bar. Change `s0` to another slice for a different hit.
clip gun {
  instrument: break_voice
  notes: [s0!16]
  length: 1/2bar
  times: 1
  quantize: 1/4beat
  launch: midi.note(36)
}

// pad 40: the same gun made with the stutter, which repeats the last `1/4beat` of the sound. It needs a hit just
// before it, so it lands on the half beat (`quantize: 1/2beat`); fired right after a quiet slice it would click.
clip echo_gun {
  length: 1/2bar
  times: 1
  quantize: 1/2beat
  launch: midi.note(40)
  break_stutter {
    hold:   xxxx xxxx
    length: 1/4beat
    gate:   0.2
    shape:  1
    bend:   0.5
  }
}

// pad 37: a roll that speeds up, with its pitch gliding up an octave over the last beat (`env[...]` ramps a
// control; a list of levels steps it), then lets go
clip roll {
  length: 1bar
  times: 1
  quantize: 1/4beat
  launch: midi.note(37)
  break_stutter {
    hold:   .... .... .... xxxx
    shrink: [1@12 0.7@4]
    pitch:  env[0 3/4bar 0 1/4bar 12]
    accent: [0@12 0.5@4]
  }
}

// pad 38: a rewind
clip rewind {
  length: 1/2bar
  times: 1
  quantize: 1/4beat
  launch: midi.note(38)
  break_stutter {
    hold:    .... xxxx
    reverse: 1
    shape:   -0.8
  }
}

chop.start
at 1bar gun.start
at 2bars roll.start
at 3bars rewind.start
