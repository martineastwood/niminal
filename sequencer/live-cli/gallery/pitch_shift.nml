// family: modifiers
// The sample, looped, with its pitch shifted but its spectral shape kept.
// shift: -24..12
// mix: 0.5..1
use std/spectral
config { channels: stereo }
tempo 100bpm
src = sample("{sample}").loop(forward)
instr voice() {
  dry = src()
  shifted = spectral_pitch(dry, shift: {shift}, size: 2048, overlap: 8)
  (dry * (1 - {mix}) + shifted * {mix}) * env[0 5ms 1 | 300ms 0] * 0.6
}
voice() for 2bars
