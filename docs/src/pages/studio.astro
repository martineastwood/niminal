---
import '../styles/landing.css';
import '../styles/web.css';
import '../styles/studio.css';

const REPO = 'https://github.com/martineastwood/niminal';
// What the page offers to start from; the files are copied to /web/examples by scripts/build-web.sh.
// [file, title, bars to render by default]. Pieces built from hand-written functions run on the interpreter in
// a browser (there is no native-code generator in WebAssembly), so they render slower and start with fewer bars.
const examples: [string, string, number][] = [
  ['functions', 'Instruments built from functions', 8],
  ['kernels', 'A piece made of hand-written functions', 4],
  ['acid', 'An acid bassline', 8],
  ['physical_models', 'Physical models', 8],
  ['modal', 'Modal resonators', 8],
  ['array_bank', 'A bank of arrays', 8],
];
---
<!doctype html>
<html lang="en" data-mode="ink" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0b0b" />
    <title>niminal studio</title>
    <meta name="description" content="Write niminal in the browser and hear it. The engine runs in your browser as WebAssembly: nothing to install." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;800;900&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        var light = false;
        try {
          var saved = localStorage.getItem('starlight-theme');
          light = saved === 'light';
          if (!saved) localStorage.setItem('starlight-theme', 'dark');
        } catch (e) {}
        var root = document.documentElement;
        root.setAttribute('data-mode', light ? 'paper' : 'ink');
        root.setAttribute('data-theme', light ? 'light' : 'dark');
      })();
    </script>
  </head>
  <body class="studio">
    <header class="nav">
      <a class="brand" href="/"><span class="mark" aria-hidden="true"></span>niminal</a>
      <nav>
        <a href="/guide/getting-started/">Docs</a>
        <a href="/reference/opcodes/">Opcodes</a>
        <a href="/guide/live-coding/">Live coding</a>
        <a href="/try/">Try it</a>
        <a href="/studio/">Studio</a>
        <a href={REPO}>GitHub</a>
      </nav>
      <div class="nav-end">
        <div class="ground" role="group" aria-label="Colour scheme">
          <button data-ground="ink">ink</button><button data-ground="paper">paper</button>
        </div>
        <a class="btn btn-solid btn-sm" href="/guide/getting-started/">Install</a>
      </div>
    </header>

    <div class="st" id="st" data-pane="code">
      <div class="st-bar">
        <button class="btn btn-solid" id="runall" disabled title="Start the whole piece from the top (Ctrl/Cmd + Shift + Enter)">▶ Run all</button>
        <button class="btn" id="stop" disabled title="Silence everything; Run plays again">■ Stop</button>
        <span class="st-now" id="now" aria-live="off"></span>
        <span class="spacer"></span>
        <div class="st-more" id="more">
          <button class="btn st-more-toggle" id="more-toggle" aria-expanded="false" aria-controls="more-body">More ▾</button>
          <div class="st-more-body" id="more-body">
            <button class="btn" id="run" disabled title="Run the selection, or the block the cursor is in (Ctrl/Cmd + Enter)">Run block</button>
            <button class="btn" id="reset" disabled title="Back to the piece as it was, and stop">↺ Reset</button>
            <label class="st-piece">
              <span class="sr-only">Piece</span>
              <select id="example" aria-label="Piece">
                {examples.map(([file, title, bars]) => <option value={file} data-bars={bars}>{title}</option>)}
              </select>
            </label>
            <details class="pg-export">
              <summary class="btn">Export</summary>
              <div class="pg-export-body">
                <label>bars <input type="number" id="bars" value="8" min="1" max="64" /></label>
                <button class="btn" id="play" disabled>Render &amp; play</button>
                <button class="btn" id="download" disabled>Download WAV</button>
              </div>
            </details>
            <button class="btn" id="share">Copy link</button>
          </div>
        </div>
      </div>
      <div class="pg-progress st-progress"><div id="progress"></div></div>

      <div class="st-tabs" role="tablist" aria-label="Show">
        <button role="tab" data-pane="code" aria-selected="true">Code</button>
        <button role="tab" data-pane="perform" aria-selected="false">Perform</button>
      </div>

      <div class="st-main">
        <section class="st-code" aria-label="Code">
          <div id="editor" class="pg-editor" aria-label="niminal source"></div>
        </section>
        <aside class="st-perform" aria-label="Perform">
          <h2>Pads</h2>
          <div class="st-pads" id="pads"></div>
          <p class="st-empty" id="pads-empty">Press <b>Run all</b>. Each clip in the piece appears here as a pad you can tap to start or stop at the next bar.</p>
        </aside>
      </div>

      <div class="st-drawer" id="drawer">
        <button class="st-drawer-bar" id="drawer-toggle" aria-expanded="false" aria-controls="drawer-body">
          <span class="chevron" aria-hidden="true">▴</span>
          <span id="status" role="status">Loading the engine…</span>
          <span class="count" id="count"></span>
        </button>
        <div class="st-drawer-body" id="drawer-body">
          <ul class="pg-errors" id="errors"></ul>
          <p class="st-help">
            <b>Run block</b> (or the ▶ in the margin) plays the code you have selected, or the block the cursor is in, and it joins in at
            the next bar. <b>Run all</b> starts the whole piece again from the top. <b>Stop</b> silences everything, and <b>Reset</b>
            puts the piece back as it was. Nothing is saved on a server: <b>Copy link</b> puts your piece in the address. Pieces that read
            sample files do not run here yet, and heavy pieces built from hand-written functions run slower in a browser than in
            <a href="/reference/stage/"><u>Stage</u></a>.
          </p>
        </div>
      </div>
    </div>
    <div class="st-keys" id="keys" role="toolbar" aria-label="Code keys"></div>

    <script>
      import { createEditor } from '../web/editor';
      import { setupKeyRow } from '../web/keys';
      import {
        byteToIndex, createEngine, decodePiece, encodePiece, lineColumn, shiftDiagnostics, wavFile,
        type Diagnostic, type Status,
      } from '../web/engine';

      const root = document.documentElement;
      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const shell = $('st');
      const runButton = $<HTMLButtonElement>('run');
      const runAllButton = $<HTMLButtonElement>('runall');
      const stop = $<HTMLButtonElement>('stop');
      const resetButton = $<HTMLButtonElement>('reset');
      const play = $<HTMLButtonElement>('play');
      const download = $<HTMLButtonElement>('download');
      const share = $<HTMLButtonElement>('share');
      const exampleSelect = $<HTMLSelectElement>('example');
      const bars = $<HTMLInputElement>('bars');
      const status = $('status');
      const errors = $('errors');
      const progress = $('progress');
      const now = $('now');
      const pads = $('pads');
      const padsEmpty = $('pads-empty');
      const drawer = $('drawer');
      const drawerToggle = $('drawer-toggle');
      const more = $('more');
      const moreToggle = $('more-toggle');
      const count = $('count');
      const setStatus = (text: string) => { status.textContent = text; };

      // ---- the page fits what is visible: on a touch screen the keyboard takes half of it
      const viewport = window.visualViewport;
      const fit = () => {
        if (!viewport) return;
        root.style.setProperty('--vvh', `${viewport.height}px`);
        // the page itself must not scroll: everything fits above the keyboard
        if (window.scrollY !== 0) window.scrollTo(0, 0);
      };
      viewport?.addEventListener('resize', fit);
      viewport?.addEventListener('scroll', fit);
      fit();

      // ---- Code or Perform, when there is room for only one
      const showPane = (pane: string) => {
        shell.dataset.pane = pane;
        document.querySelectorAll<HTMLButtonElement>('.st-tabs button').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.pane === pane)));
      };
      document.querySelectorAll<HTMLButtonElement>('.st-tabs button').forEach((b) => b.addEventListener('click', () => showPane(b.dataset.pane!)));

      // ---- the less used buttons: always shown when there is room, behind "More" when there is not
      moreToggle.addEventListener('click', () => { const open = !more.hasAttribute('data-open'); more.toggleAttribute('data-open', open); moreToggle.setAttribute('aria-expanded', String(open)); });
      // a tap outside the menu closes it
      document.addEventListener('pointerdown', (e) => { if (!more.contains(e.target as Node)) { more.removeAttribute('data-open'); moreToggle.setAttribute('aria-expanded', 'false'); } });

      // ---- messages: closed unless something needs saying
      const setDrawer = (open: boolean) => { drawer.toggleAttribute('data-open', open); drawerToggle.setAttribute('aria-expanded', String(open)); };
      drawerToggle.addEventListener('click', () => setDrawer(!drawer.hasAttribute('data-open')));

      document.querySelectorAll<HTMLButtonElement>('[data-ground]').forEach((b) =>
        b.addEventListener('click', () => {
          const mode = b.dataset.ground as 'ink' | 'paper';
          root.setAttribute('data-mode', mode);
          root.setAttribute('data-theme', mode === 'paper' ? 'light' : 'dark');
          try { localStorage.setItem('starlight-theme', mode === 'paper' ? 'light' : 'dark'); } catch {}
          code.applyGround();
        }));

      // ---- what the running session says about itself
      let clipNames = '';
      const padButtons = new Map<string, HTMLButtonElement>();
      function showSession(m: Status) {
        const s = m.status;
        if (!s) { now.textContent = ''; return; }
        now.textContent = `bar ${s.bar} · beat ${Math.floor(s.beat)} · ${Math.round(s.bpm)} bpm`;
        now.title = `engine load ${(m.load * 100).toFixed(0)}%, ${m.buffered.toFixed(2)} s ahead, ${m.underruns} gaps`;
        now.toggleAttribute('data-warn', m.underruns > 0 || m.load > 0.85);
        // the clips of the piece are pads
        const names = s.clips.map((c) => c.name).join('|');
        if (names !== clipNames) {
          clipNames = names;
          pads.replaceChildren();
          padButtons.clear();
          for (const clip of s.clips) {
            const pad = document.createElement('button');
            pad.className = 'st-pad';
            pad.textContent = clip.name;
            pad.addEventListener('click', () => void tapPad(clip.name));
            pads.append(pad);
            padButtons.set(clip.name, pad);
          }
          padsEmpty.hidden = s.clips.length > 0;
        }
        for (const clip of s.clips) {
          const pad = padButtons.get(clip.name);
          if (!pad) continue;
          pad.toggleAttribute('data-on', clip.running && !clip.muted);
          pad.toggleAttribute('data-muted', clip.muted);
        }
      }
      async function tapPad(name: string) {
        const on = padButtons.get(name)?.hasAttribute('data-on');
        const reply = await engine.run(`${name}.${on ? 'stop' : 'start'}`);
        setStatus(reply.ok ? `${name} ${on ? 'stops' : 'starts'} at bar ${reply.landed.bar}.` : (reply.message || `Could not ${on ? 'stop' : 'start'} ${name}.`));
      }

      const engine = createEngine({
        onStatus: showSession,
        onLost: () => { setStatus('The engine stopped unexpectedly. Run all starts it again.'); now.textContent = ''; },
        onBroken: () => setStatus('The engine could not be loaded in this browser.'),
      });
      const code = createEditor({
        parent: $('editor'),
        exchange: engine.exchange,
        onRun: () => void runPart(),
        onRunAll: () => void runAll(),
      });
      setupKeyRow($('keys'), code, () => void runPart());

      function showErrors(source: string, diagnostics: Diagnostic[], message: string, warnings: string[] = []) {
        errors.replaceChildren();
        for (const d of diagnostics) {
          const from = byteToIndex(source, d.start);
          const to = byteToIndex(source, d.end);
          const { line, column } = lineColumn(source, from);
          const item = document.createElement('li');
          const where = document.createElement('span');
          where.className = 'where';
          where.textContent = `line ${line}, column ${column}: `;
          item.append(where, d.message);
          if (d.help) {
            const help = document.createElement('span');
            help.className = 'help';
            help.textContent = d.help;
            item.append(help);
          }
          item.addEventListener('click', () => { showPane('code'); code.select(from, Math.max(to, from + 1)); });
          errors.append(item);
        }
        for (const text of [message, ...warnings].filter(Boolean)) {
          const item = document.createElement('li');
          if (text !== message) item.className = 'warn';
          item.textContent = text;
          errors.append(item);
        }
        count.textContent = errors.childElementCount ? String(errors.childElementCount) : '';
        // a mistake opens the messages; a clean run closes what a mistake opened
        setDrawer(errors.childElementCount > 0);
      }

      // ---- the live session
      let busy = false;
      let pristine = '';

      async function runAll() {
        if (busy || runButton.disabled) return;
        busy = true;
        stopPlaying();
        try {
          setStatus('Starting…');
          const text = code.value;
          const reply = await engine.start(text);
          if (!reply.ok) {
            setStatus(reply.internal ? 'The engine stopped unexpectedly.' : 'There is a mistake in the piece, so it did not start.');
            showErrors(text, reply.diagnostics, reply.message);
            return;
          }
          showErrors(text, [], '');
          code.flash(0, code.view.state.doc.length);
          setStatus('Playing. Tap ▶ in the margin to run a block, or a pad to start or stop a clip.');
        } catch {
          setStatus('Audio could not be started in this browser.');
        } finally { busy = false; }
      }

      async function runPart() {
        if (busy || runButton.disabled) return;
        // nothing is playing yet, so there is nothing to change: start the piece
        if (!engine.sessionOn) return runAll();
        const part = code.target();
        if (!part) { setStatus('Put the cursor in some code, or select some, and press Run block.'); return; }
        busy = true;
        stopPlaying();
        try {
          const text = code.value;
          const reply = await engine.run(text.slice(part.from, part.to));
          if (!reply.ok) {
            // the engine located the mistakes within the piece it was given: move them into the whole text
            setStatus(reply.internal ? 'The engine stopped unexpectedly.' : 'There is a mistake in that code, so it was not run.');
            showErrors(text, shiftDiagnostics(text, part.from, reply.diagnostics), reply.message);
            return;
          }
          showErrors(text, [], '');
          code.flash(part.from, part.to);
          const what = reply.landed.changes.length ? reply.landed.changes.join(', ') : 'nothing changed';
          setStatus(`Sent: ${what}. It lands at bar ${reply.landed.bar}.`);
        } finally { busy = false; }
      }

      async function stopAll() {
        stopPlaying();
        if (!engine.sessionOn) return;
        await engine.hush();
        setStatus('Stopped. Run block plays again, and Run all starts the piece from the top.');
      }

      async function reset() {
        if (code.value !== pristine && !confirm('Put the piece back as it was? Your changes will be lost.')) return;
        stopPlaying();
        await engine.stop();
        now.textContent = '';
        code.value = pristine;
        showErrors(pristine, [], '');
        setStatus('Back to the start. Run all plays it.');
      }

      // ---- Export: render the whole piece, then play it
      let source: AudioBufferSourceNode | undefined;
      let last: { channels: Float32Array[]; sampleRate: number } | undefined;
      let frame = 0;

      function stopPlaying() {
        cancelAnimationFrame(frame);
        progress.style.width = '0';
        try { source?.stop(); } catch {}
        source = undefined;
      }

      async function renderAndPlay() {
        if (play.disabled) return;
        stopPlaying();
        // the context must be made or resumed inside the click, before anything is awaited
        const ctx = engine.context();
        // the live session and a render would play over each other
        await engine.stop();
        now.textContent = '';
        play.disabled = true;
        download.disabled = true;
        const text = code.value;
        // the render happens in a worker, so the page can keep counting while it waits
        const waitingSince = performance.now();
        const say = () => setStatus(`Rendering… ${Math.floor((performance.now() - waitingSince) / 1000)} s`);
        say();
        const waiting = setInterval(say, 250);
        showErrors(text, [], '');
        const result = await engine.render(text, Number(bars.value) || 8);
        clearInterval(waiting);
        play.disabled = false;
        if (!result.ok) {
          setStatus(result.internal ? 'The engine stopped unexpectedly.' : 'There is a mistake in the piece.');
          showErrors(text, result.diagnostics, result.message);
          return;
        }
        showErrors(text, [], '', result.warnings);
        last = { channels: result.channels, sampleRate: result.sampleRate };
        download.disabled = false;
        const frames = result.channels[0].length;
        const buffer = ctx.createBuffer(result.channels.length, frames, result.sampleRate);
        result.channels.forEach((c, i) => buffer.copyToChannel(c, i));
        source = ctx.createBufferSource();
        source.buffer = buffer;
        source.connect(ctx.destination);
        const seconds = frames / result.sampleRate;
        const started = ctx.currentTime;
        source.onended = () => { stopPlaying(); setStatus(`Played ${seconds.toFixed(1)} s (rendered in ${(result.renderMs / 1000).toFixed(2)} s).`); };
        source.start();
        setStatus(`Playing ${seconds.toFixed(1)} s (rendered in ${(result.renderMs / 1000).toFixed(2)} s).`);
        const tick = () => {
          progress.style.width = `${Math.min(100, ((ctx.currentTime - started) / seconds) * 100)}%`;
          frame = requestAnimationFrame(tick);
        };
        tick();
      }

      play.addEventListener('click', renderAndPlay);
      runButton.addEventListener('click', () => void runPart());
      runAllButton.addEventListener('click', () => void runAll());
      stop.addEventListener('click', () => void stopAll());
      resetButton.addEventListener('click', () => void reset());

      download.addEventListener('click', () => {
        if (!last) return;
        const link = document.createElement('a');
        link.href = URL.createObjectURL(wavFile(last.channels, last.sampleRate));
        link.download = 'niminal.wav';
        link.click();
        setTimeout(() => URL.revokeObjectURL(link.href), 10_000);
      });

      // ---- sharing: the piece, compressed, in the address
      share.addEventListener('click', async () => {
        let url: string;
        try {
          url = `${location.origin}${location.pathname}#c=${await encodePiece(code.value)}&b=${Number(bars.value) || 8}`;
        } catch { setStatus('Could not make a link in this browser.'); return; }
        history.replaceState(null, '', url);
        try {
          await navigator.clipboard.writeText(url);
          setStatus('The link, with your piece in it, is copied.');
        } catch { setStatus('The link, with your piece in it, is in the address bar.'); }
      });

      // ---- starting points
      async function loadExample(name: string) {
        const wanted = exampleSelect.querySelector<HTMLOptionElement>(`option[value="${name}"]`)?.dataset.bars;
        if (wanted) bars.value = wanted;
        const response = await fetch(`/web/examples/${name}.nml`);
        pristine = response.ok ? await response.text() : '// could not load the example';
        code.value = pristine;
        showErrors(pristine, [], '');
      }
      exampleSelect.addEventListener('change', async () => {
        stopPlaying();
        await engine.stop();
        now.textContent = '';
        history.replaceState(null, '', location.pathname);
        await loadExample(exampleSelect.value);
        setStatus('Run all plays it.');
      });

      (async () => {
        const shared = new URLSearchParams(location.hash.slice(1));
        const hash = shared.get('c');
        if (Number(shared.get('b')) > 0) bars.value = String(Math.min(64, Number(shared.get('b'))));
        if (hash) {
          try { pristine = await decodePiece(hash); code.value = pristine; } catch { await loadExample(exampleSelect.value); }
        } else {
          await loadExample(exampleSelect.value);
        }
        await engine.warm();
        for (const b of [runButton, runAllButton, resetButton, play, stop]) b.disabled = false;
        setStatus('Ready. Press Run all to start the piece.');
      })();
    </script>
  </body>
</html>
