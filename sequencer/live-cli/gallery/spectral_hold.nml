// family: manglers
// The looped sample's spectrum is captured and held, while its movement carries on or stops.
// capture: 0.2..2
// keep: 0..1
// room: 0..0.8
config { channels: stereo }
tempo 100bpm
src = sample("{sample}").loop(forward)
instr voice() {
  grab = env[0 {capture}sec 0 1ms 1]
  held = spectral_hold(src(), magnitude: grab, frequency: grab * {keep}, size: 2048, overlap: 8)
  (held + held.reverb(room: {room}, damp: 0.5) * 0.25) * env[0 30ms 1 | 400ms 0] * 0.6
}
voice() for 2bars
