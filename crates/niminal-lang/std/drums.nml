/// A bubbling blip: random pitch steps over a band-passed hiss.
instr blip(
  freq: hz = c3,
  attack: 0.1ms..50ms = 0.5ms,
  decay: 5ms..10sec = 600ms,
  mod_amount: -48..48 = 24,
  mod_rate: 1hz..4khz = 14hz,
  noise_freq: 20hz..20khz = 3khz,
  noise_q: 0..1 = 0.6,
  noise_attack: 0.1ms..200ms = 1ms,
  noise_decay: 5ms..10sec = 600ms,
  mix: 0..1 = 0.2,
  drive: 0..1 = 0.3,
  eq_freq: 20hz..20khz = 1khz,
  eq_gain: -24db..24db = 0db,
  amp: db = -10db,
  gain: db = 0db,
  osc_vel: 0..1 = 0.5,
  noise_vel: 0..1 = 0.5,
  mod_vel: 0..1 = 0.1
) {
  drum(
    freq: 900hz * (freq / c3),
    mod_mode: random,
    noise_filter: band,
    attack: attack,
    decay: decay,
