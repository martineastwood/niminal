// Curated drum presets: `use std/drums.{kick_808, snare_tri, hat_closed}`.
// c3 plays each at its designed tuning; gain sets both loudness and strike brightness.
// decay always controls the audible tail. For the full drum-machine controls, use drum(...).
// Each preset can be copied and edited independently. Hats share the `hats` choke group.

// folder: drums/kicks

/// A deep sub kick with a long tail. Punch sets the pitch drop; click adds a beater.
instr kick_deep(
  freq: hz = c3,
  decay: 20ms..3sec = 900ms,
  punch: 0..48 = 24,
  click: 0..0.5 = 0.04,
  drive: 0..1 = 0.1,
  gain: db = 0db
) {
  hit = (1 * gain).max(0).min(1)
  drum(
    freq: 42hz * (freq / c3),
    noise_filter: high,
    attack: 0.5ms,
    decay: decay,
    mod_amount: punch,
    mod_rate: 35hz,
    noise_freq: 2khz,
    noise_q: 0.3,
    noise_attack: 1ms,
    noise_decay: 6ms,
    mix: click,
    drive: drive,
    eq_freq: 1khz,
    eq_gain: 0db,
    amp: -3db,
    vel: hit,
    osc_vel: 0.5,
    noise_vel: 0.5,
    mod_vel: 0.1
  ).gain(gain)
}

// folder: drums/kicks

/// A weighty sine kick with a short pitch drop and a rounded amplitude shoulder.
/// A quiet octave component keeps the body audible on smaller speakers; drive adds warmth and click a beater.
instr kick_808(
  freq: hz = c3,
  decay: 20ms..3sec = 450ms,
  punch: 0..48 = 30,
  click: 0..0.5 = 0.08,
  drive: 0..1 = 0.25,
  gain: db = 0db
) {
  hit = (1 * gain).max(0).min(1)
  length = decay.max(20ms).min(3sec)
  push = drive.max(0).min(1)
  tuning = 52hz * (freq / c3).max(0).min(16)
  drop = env[1 25ms.exp 0] * punch.max(0).min(48) * (0.8 + hit * 0.2)
  level = env[0 0.5ms 1 (length * 0.15).exp 0.85 (length * 0.85).exp 0]
  voice = oversample(2) {
    pitch_drop = tuning * exp(drop * 0.057762265)
    fundamental = osc(sine, pitch_drop)
    body_harmonic = osc(sine, pitch_drop * 2) * (0.18 + push * 0.35)
    thump = (fundamental + body_harmonic) * level
    beater = noise(seed: 79).hpf(cutoff: 2khz) * perc(attack: 0.1ms, decay: 5ms) * click.max(0).min(0.5)
    (thump * (1 + push * (1 + hit)) + beater).tanh
  }
  voice * 0.75 * gain
}

// folder: drums/kicks

/// A hard triangle kick. Drive adds weight; click mixes in a short noise attack.
instr kick_punch(
  freq: hz = c3,
  decay: 20ms..3sec = 260ms,
  punch: 0..48 = 40,
  click: 0..0.5 = 0,
  drive: 0..1 = 0.7,
  gain: db = 0db
) {
  hit = (1 * gain).max(0).min(1)
  drum(
    freq: 58hz * (freq / c3),
    wave: tri,
    attack: 0.5ms,
    decay: decay,
    mod_amount: punch,
    mod_rate: 90hz,
    noise_freq: 4khz,
    noise_q: 0.3,
    noise_attack: 1ms,
    noise_decay: 150ms,
    mix: click,
    drive: drive,
    eq_freq: 250hz,
    eq_gain: -4db,
    amp: -4db,
    vel: hit,
    osc_vel: 0.5,
    noise_vel: 0.5,
    mod_vel: 0.1
  ).gain(gain)
}

