// Glitching a break: several glitches at the same time. The one-bar loop in break.wav is chopped
// into 16 slices and played for two bars through an effect with four lanes (a stutter, a rewind,
// a tape-stop and a crush), each drawn as a row of steps in the `glitch` block of the clip. Where rows
// overlap they are heard together: bar 2 ends with a stutter and a rewind at once, and a crush
// covers its middle. Change a row and render again.
// `use std/glitch` brings in the three lane functions. The `glitch` effect in `std/fx` is this same effect, ready to
// put on a tracker track.
// Render with:  niminal render examples/glitch.nml --out glitch.wav --bars 4
use std/glitch
config { channels: stereo }
tempo 130bpm

brk = sample("break.wav").beats(4)
chops = brk.slices(16)

bus break_audio: stereo

instr break_voice(sample) {
  break_audio += chops(sample: sample)
}

// A persistent fx reads the bus, so every lane keeps hearing the break across notes. The lanes run
// side by side on the same sound, and the ones that are held are added together.
fx break_glitch(
  stutter_hold: 0..1 = 0, stutter_length: 1ms..1sec = 1/8beat, stutter_pitch: -24..24 = 0,
  rewind_hold: 0..1 = 0, rewind_length: 1ms..1sec = 1/4beat,
  slow_hold: 0..1 = 0, slow_time: 10ms..1sec = 400ms,
  crush_hold: 0..1 = 0, crush_bits: 2..16 = 5, crush_rate: 200hz..20000hz = 4000hz
) {
  stuttered = break_audio.repeat_last(hold: stutter_hold, length: stutter_length, pitch: stutter_pitch)
  rewound = break_audio.rewind_last(hold: rewind_hold, length: rewind_length)
  slowed = break_audio.slow_down(hold: slow_hold, time: slow_time)
  crushed = break_audio.bitcrush(rate: crush_rate, bits: crush_bits)
  lanes = (stutter_hold > 0) + (rewind_hold > 0) + (slow_hold > 0) + (crush_hold > 0)
  heard = stuttered * (stutter_hold > 0) + rewound * (rewind_hold > 0) + slowed * (slow_hold > 0) + crushed * (crush_hold > 0)
  out = heard / sqrt(lanes.max(1)) + break_audio * (lanes < 0.5)
}

// bar 1 as recorded, bar 2 re-cut
cuts = [s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13 s14 s15  s0 s0 s2 s3 s4 s4 s6 s7 s8 s9 s2 s11 s12 s5 s14 s15]

clip glitched {
  instrument: break_voice
  length: 2bars
  notes: cuts
  // one row per glitch, a step each: . is off, x is on, and a digit divides the row's first setting,
  // so 248 is a stutter that rolls from 1/8 to 1/16 to 1/32 of a beat. Adjacent steps are one hold.
  break_glitch: glitch {
    stutter(length: 1/4beat): .... .... .... 248. .... .... .... 448.
    rewind(length: 1/4beat):  .... .... x2.. .... .... .... .... .22.
    slow:                     ...x xxx. .... .... .... .... .... ....
    crush(bits: 8):           .... .... .... .... .... xxxx 2222 ....
  }
  // anything the rows can't say is still an ordinary lane
  break_glitch.stutter_pitch: [0@14 5 0@16 -7]
}

glitched.start

// The same four glitches as mini-notation, with chance in it: `~` is off, `x?` happens half the time (the
// same way every time), `<a b>` takes a turn each bar (a clip with no `length:` runs a bar at a time), and `x(3,8)` spreads three hits over eight steps.
// `glitch(mutate)` makes the choices come out differently each time the clip starts: stop it and start it again
// for another variation (a render is the same every time; `glitch(seed: 7)` fixes one variation).
// Evaluate it live (or swap `glitched.start` for `mutated.start`) and glitch the break differently each bar.
clip mutated {
  instrument: break_voice
  notes: [s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13 s14 s15]
  break_glitch: glitch(mutate) {
    stutter(length: 1/4beat): [~ ~ ~ ~  ~ ~ ~ ~  <x 2> ~ x? 4?  8? ~ ~ ~]
    rewind(length: 1/4beat):  [<~ x> ~ ~ ~  x? ~ ~ ~  ~ ~ ~ ~  ~ ~ 2? ~]
    crush(bits: 6):           [x(3,16)]
  }
}
