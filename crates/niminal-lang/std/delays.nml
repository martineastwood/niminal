// Delays beyond the one `delay` opcode: `use std/delays`.

/// Echoes at several times from one delay line: `x.multitap([120ms, 250ms, 410ms], [0.6, 0.4, 0.3])`.
/// The output is `x` plus the echoes, each scaled by its gain. `max` is the longest time, in samples.
fn multitap(x, times: [sec], gains: [num], max: const int = 96000) {
  state ring = zeros(max)
  state pos = 0
  ring[pos] = x
  echoes = ring.taps(times.map(it.num * sample_rate.num), pos)
  pos = (pos + 1).mod(max)
  x + echoes.dot(gains)
}

/// A feedback delay whose echoes are darker each time round: `time` between repeats, `feedback` kept
/// of each, and `damp` the cutoff of the low-pass in the loop. `max` is the longest time, in samples.
fn tape(x, time: sec, feedback: 0..1 = 0.5, damp: hz = 4khz, max: const int = 96000) {
  state ring = zeros(max)
  state pos = 0
  state lp = 0
  a = exp(-2 * pi * damp / sample_rate)
  echo = ring.at(pos - time.num * sample_rate.num, interp: linear)
  lp = echo * (1 - a) + lp * a
  ring[pos] = x + lp * feedback
  pos = (pos + 1).mod(max)
  x + echo
}
