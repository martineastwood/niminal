// Ready-made effects, a shelf to take from: the tracker copies one into a project as it stands, and in code
// you name the ones you want, `use std/fx.{echo, room_reverb}`; nothing else comes in. Each reads the sound
// coming in as `in`, and `mix` blends it with the original where there is one. They are complete on their
// own, so you can edit them from there. The glitch effect is
// made of the opcodes `repeat_last`, `rewind_last` and `slow_down`, and `apply`.

// folder: filters

/// Remove high frequencies. Resonance shapes the filter around cutoff. `sweep_depth` (in octaves) moves the
/// cutoff up and down at `sweep_rate`; at 0 it stays put.
fx lowpass(
  cutoff: 20hz..20000hz = 2400hz,
  resonance: 0..0.95 = 0.2,
  sweep_rate: 0.01hz..20hz = 0.3hz,
  sweep_depth: 0..4 = 0,
  mix: 0..1 = 1
) {
  moving = cutoff * exp(lfo(sweep_rate).smooth * sweep_depth * 0.693147)
  out = in.crossfade(in.lpf(cutoff: moving, res: resonance), mix)
}

/// A warmer low-pass in the style of a transistor ladder: four soft stages, and `drive` pushes the sound
/// into them. Resonance near 1 rings and sings at the cutoff. `sweep_depth` (in octaves) moves the cutoff at
/// `sweep_rate`.
fx ladder_lowpass(
  cutoff: 20hz..20000hz = 1200hz,
  resonance: 0..1 = 0.3,
  drive: 0.25..8 = 1,
  sweep_rate: 0.01hz..20hz = 0.3hz,
  sweep_depth: 0..4 = 0,
  mix: 0..1 = 1
) {
  moving = cutoff * exp(lfo(sweep_rate).smooth * sweep_depth * 0.693147)
  out = in.crossfade(in.ladder(cutoff: moving, res: resonance, drive: drive), mix)
}

/// Remove low frequencies. Resonance shapes the filter around cutoff. `sweep_depth` (in octaves) moves the
/// cutoff up and down at `sweep_rate`.
fx highpass(
  cutoff: 20hz..20000hz = 200hz,
  resonance: 0..0.95 = 0.2,
  sweep_rate: 0.01hz..20hz = 0.3hz,
  sweep_depth: 0..4 = 0,
  mix: 0..1 = 1
) {
  moving = cutoff * exp(lfo(sweep_rate).smooth * sweep_depth * 0.693147)
  out = in.crossfade(in.hpf(cutoff: moving, res: resonance), mix)
}

/// Keep a band of frequencies around the cutoff. `sweep_depth` (in octaves) moves the band up and down at
/// `sweep_rate`.
fx bandpass(
  cutoff: 20hz..20000hz = 1200hz,
  resonance: 0..0.95 = 0.2,
  sweep_rate: 0.01hz..20hz = 0.3hz,
  sweep_depth: 0..4 = 0,
  mix: 0..1 = 1
) {
  moving = cutoff * exp(lfo(sweep_rate).smooth * sweep_depth * 0.693147)
  out = in.crossfade(in.bpf(cutoff: moving, res: resonance), mix)
}

/// Cut a narrow band of frequencies around the cutoff. `sweep_depth` (in octaves) moves the band up and down
/// at `sweep_rate`.
fx band_cut(
  cutoff: 20hz..20000hz = 1200hz,
  resonance: 0..0.95 = 0.2,
  sweep_rate: 0.01hz..20hz = 0.3hz,
  sweep_depth: 0..4 = 0,
  mix: 0..1 = 1
) {
  moving = cutoff * exp(lfo(sweep_rate).smooth * sweep_depth * 0.693147)
  out = in.crossfade(in.notch(cutoff: moving, res: resonance), mix)
}

// folder: eq

/// Raise or cut the lows, a band in the middle, and the highs.
fx equalizer(
  low: -18db..18db = 0db,
  low_freq: 20hz..1000hz = 120hz,
  mid: -18db..18db = 0db,
  mid_freq: 100hz..10000hz = 1000hz,
  high: -18db..18db = 0db,
  high_freq: 1000hz..20000hz = 6000hz
) {
  out = in.low_shelf(cutoff: low_freq, gain: low).peak_eq(cutoff: mid_freq, gain: mid, q: 1).high_shelf(cutoff: high_freq, gain: high)
}

// folder: time/delay

/// Echoes with independent left/right timing, feedback and a dry/wet blend.
fx echo(
  left: 1ms..2sec = 250ms,
  right: 1ms..2sec = 375ms,
  feedback: 0..0.95 = 0.35,
  mix: 0..1 = 0.3
) {
  wet = in.delay(time: [left, right], feedback: feedback, max: 2sec)
  out = in.crossfade(wet, mix)
}

// folder: time/glitch

/// Glitches on the same sound, one after another: stutter repeats the last piece, rewind plays it backwards,
/// slow winds the sound down like a stopping tape, and crush reduces its sample rate and bit depth. Each is
/// switched on by its own control (automate them, or set them from a command column) and the sound passes
/// through untouched while all are off. A `stutter_shrink` below 1 makes a held stutter roll faster, a `stutter_gate` below 1 makes the repeats staccato, and a `stutter_reverse` above 0 plays them backwards, a `stutter_shape` gives each a fade-out (above 0) or swell (below 0), `stutter_damp` darkens each repeat more than the last, `stutter_attack` and `stutter_bend` shape the envelope of each repeat (a slow attack, or an exponential pluck), and `stutter_accent` makes every second repeat quieter.
fx glitch(
  stutter: 0..1 = 0,
  stutter_length: 1ms..1sec = 125ms,
  stutter_pitch: -24..24 = 0,
  stutter_shrink: 0.5..1 = 1,
  stutter_gate: 0.05..1 = 1,
  stutter_reverse: 0..1 = 0,
  stutter_shape: -1..1 = 0,
  stutter_damp: 0..0.95 = 0,
  stutter_attack: 0..1 = 0,
  stutter_bend: 0..1 = 0,
  stutter_accent: 0..1 = 0,
  rewind: 0..1 = 0,
  rewind_length: 1ms..1sec = 250ms,
  slow: 0..1 = 0,
  slow_time: 10ms..1sec = 400ms,
  crush: 0..1 = 0,
  crush_bits: 2..16 = 5,
  crush_rate: 200hz..20000hz = 4000hz,
  mix: 0..1 = 1
) {
  glitched = in
    .repeat_last(hold: stutter, length: stutter_length, pitch: stutter_pitch, shrink: stutter_shrink,
      gate: stutter_gate, reverse: stutter_reverse,
      shape: stutter_shape, damp: stutter_damp,
      attack: stutter_attack, bend: stutter_bend, accent: stutter_accent)
    .rewind_last(hold: rewind, length: rewind_length)
    .slow_down(hold: slow, time: slow_time)
    .apply(fn(s) { s.bitcrush(rate: crush_rate, bits: crush_bits) }, when: crush)
  out = in.crossfade(glitched, mix)
}

// folder: time/reverb

/// A room or hall: `room` is its size, `damp` how quickly the highs die away in it.
fx room_reverb(
  room: 0..1 = 0.6,
  damp: 0..1 = 0.5,
  mix: 0..1 = 0.3
) {
  out = in.crossfade(in.reverb(room: room, damp: damp), mix)
}

// folder: modulation

/// Gently widen the signal with a modulated delay chorus.
fx ensemble(
  rate: 0.05hz..8hz = 0.8hz,
  depth: 0..1 = 0.3,
  time: 1ms..40ms = 15ms,
  mix: 0..1 = 0.4
) {
  out = in.chorus(rate: rate, depth: depth, time: time, mix: mix)
}

/// A sweeping phaser: notches that move around `center`, fed back on themselves.
fx swirl(
  rate: 0.05hz..8hz = 0.4hz,
  depth: 0..1 = 0.6,
  center: 100hz..8000hz = 800hz,
  feedback: 0..0.9 = 0.4,
  mix: 0..1 = 0.5
) {
  out = in.phaser(rate: rate, depth: depth, center: center, feedback: feedback, mix: mix)
}

/// Amplitude tremolo. shape selects the LFO: 0 sine, 1 triangle, 2 square, 3 saw.
fx tremolo(
  rate: 0.1hz..20hz = 4hz,
  depth: 0..1 = 0.5,
  shape: 0..3 = 0
) {
  wave = ((shape < 0.5) * lfo(rate, shape: sine) + (shape >= 0.5 and shape < 1.5) * lfo(rate, shape: tri) + (shape >= 1.5 and shape < 2.5) * lfo(rate, shape: square) + (shape >= 2.5) * lfo(rate, shape: saw)).smooth
  out = in * (1 - depth * (wave * 0.5 + 0.5))
}

// folder: dynamics

/// Turn loud parts down: above the threshold the level is reduced by the ratio, and makeup brings
/// the whole signal back up. `knee` rounds the corner at the threshold. `link` is how much the
/// channels of a stereo sound share one squeeze: at 1 the loudest decides for both, so the image
/// stays put; at 0 each side is squeezed on its own.
fx compressor(
  threshold: -60db..0db = -18db,
  ratio: 1..20 = 4,
  attack: 1ms..100ms = 10ms,
  release: 10ms..1sec = 120ms,
  makeup: 0db..24db = 3db,
  knee: 0db..24db = 6db,
  link: 0..1 = 1
) {
  level = in.map(abs(it))
  side = level * (1 - link) + level.max * link
  out = in.compress(threshold: threshold, ratio: ratio, attack: attack, release: release, makeup: makeup, sidechain: side, knee: knee)
}

// folder: distortion

/// Warm or hard distortion. `drive` is how hard the signal is pushed, `tone` how bright it is. It runs
/// at twice the sample rate, so bright sounds pushed hard don't fold harmonics back down as noise.
fx overdrive(
  drive: 0..1 = 0.4,
  tone: 0..1 = 0.5,
  mix: 0..1 = 1
) {
  push = 1 + drive * 12
  bright = tone
  wet = mix
  out = oversample(2) { in.distortion(drive: push, tone: bright, mix: wet) }
}

/// Lo-fi: fewer bits and a lower sample rate, for grit.
fx lofi(
  rate: 1khz..48khz = 12khz,
  bits: 2..16 = 8,
  mix: 0..1 = 1
) {
  out = in.crossfade(in.bitcrush(rate: rate, bits: bits), mix)
}

/// Round off peaks that would clip, with no delay. `drive` is how hard the signal is pushed into the curve; the
/// output is scaled so a full-scale input still reaches full scale. For a hard ceiling on the whole mix, the
/// master has a lookahead limiter of its own.
fx soft_clip(
  drive: 0..1 = 0.3,
  mix: 0..1 = 1
) {
  push = 1 + drive * 8
  wet = in.map(tanh(it * push)) / tanh(push)
  out = in.crossfade(wet, mix)
}
