// A drum grid like the one `drum_grid(theme: house, density: 0.8, chaos: 0.3, seed: 4, hat: 0.6)` makes,
// written out as ordinary code to edit.
// Change a step by hand, or make another with a new seed. Render with:
//   niminal render examples/generated_drums.nml --out generated_drums.wav --bars 4
use std/drums.{kick_deep, clap, hat_closed, hat_open, rim}
config { channels: stereo }
tempo 124bpm

kit_house = kit {
  kick: kick_deep
  clap: clap
  hat: hat_closed
  open: hat_open
  perc: rim
}

beat = grid {
  kick: x... x... x... x...
  clap: .... x... .... x...
  hat:  x.x. x.x. x.x. ..x.
  open: ..x. ..x. ..x. ..x.
  perc: .... .... .... ....
}

clip drums {
  instrument: kit_house
  notes: beat
}

drums.start
at +4bars hush
