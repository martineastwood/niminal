// family: glitch
// The last stretch of the break is cut into slices and played back shuffled, with some reversed,
// repeated, dropped or detuned. The same seed shuffles the same way.
// every: 4..8 int
// duty: 0.5..0.9
// slices: 4..16 int
// reverse: 0..0.6
// repeat: 0..0.6
// drop: 0..0.4
// detune: 0..7
config { channels: stereo }
tempo 100bpm
src = sample("{sample}").loop(forward)
instr voice() {
  hold = phasor((1 / ({every}beats).num).hz) > 1 - {duty}
  src().scatter(hold: hold, length: 4beats, slices: {slices}, seed: {seed}, reverse: {reverse},
    repeat: {repeat}, drop: {drop}, detune: {detune}) * env[0 5ms 1 | 300ms 0] * 0.6
}
voice() for 2bars
