---
import '../styles/landing.css';
import '../styles/web.css';
import '../styles/studio.css';

const REPO = 'https://github.com/martineastwood/niminal';
// What the page offers to start from, as [path under /web, title, bars to render when exporting]. The live sets (docs/studio)
// are made to be played: they have clips for the Clips panel and controls for the sliders. The examples are the repository's,
// copied by scripts/build-web.sh; pieces built from hand-written functions run on the interpreter in a browser (there
// is no native-code generator in WebAssembly), so they render slower and start with fewer bars.
const live: [string, string, number][] = [
  ['studio/house', 'A live set: house', 8],
  ['studio/ambient', 'A live set: ambient', 8],
  ['studio/kit', 'A live set: the starter kit (recorded samples)', 8],
  ['studio/blank', 'A blank page to build on', 4],
];
const examples: [string, string, number][] = [
  ['examples/functions', 'Instruments built from functions', 8],
  ['examples/kernels', 'A piece made of hand-written functions', 4],
  ['examples/acid', 'An acid bassline', 8],
  ['examples/physical_models', 'Physical models', 8],
  ['examples/modal', 'Modal resonators', 8],
  ['examples/array_bank', 'A bank of arrays', 8],
];
---
<!doctype html>
<html lang="en" data-mode="ink" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0b0b" />
    <title>niminal studio</title>
    <meta name="description" content="Write niminal in the browser and hear it. The engine runs in your browser as WebAssembly: nothing to install." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;800;900&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        var light = false;
        try {
          var saved = localStorage.getItem('starlight-theme');
          light = saved === 'light';
          if (!saved) localStorage.setItem('starlight-theme', 'dark');
        } catch (e) {}
        var root = document.documentElement;
        root.setAttribute('data-mode', light ? 'paper' : 'ink');
        root.setAttribute('data-theme', light ? 'light' : 'dark');
      })();
    </script>
  </head>
  <body class="studio">
    <header class="nav">
      <a class="brand" href="/"><span class="mark" aria-hidden="true"></span>niminal</a>
      <nav>
        <a href="/guide/getting-started/">Docs</a>
        <a href="/reference/opcodes/">Opcodes</a>
        <a href="/guide/live-coding/">Live coding</a>
        <a href="/try/">Try it</a>
        <a href="/studio/">Studio</a>
        <a href={REPO}>GitHub</a>
      </nav>
      <div class="nav-end">
        <div class="ground" role="group" aria-label="Colour scheme">
          <button data-ground="ink">ink</button><button data-ground="paper">paper</button>
        </div>
        <a class="btn btn-solid btn-sm" href="/guide/getting-started/">Install</a>
      </div>
    </header>

    <div class="st" id="st" data-pane="code">
      <div class="st-bar">
        <button class="btn btn-solid" id="runall" disabled title="Start the whole piece from the top (Ctrl/Cmd + Shift + Enter)">▶ Run all</button>
        <button class="btn" id="stop" disabled title="Silence everything; Run plays again">■ Stop</button>
        <span class="st-now" id="now" aria-live="off"></span>
        <span class="st-beats" id="beats" aria-hidden="true"></span>
        <span class="spacer"></span>
        <div class="st-more" id="more">
          <button class="btn st-more-toggle" id="more-toggle" aria-expanded="false" aria-controls="more-body">More ▾</button>
          <div class="st-more-body" id="more-body">
            <button class="btn" id="run" disabled title="Run the selection, or the block the cursor is in (Ctrl/Cmd + Enter)">Run block</button>
            <button class="btn" id="reset" disabled title="Back to the piece as it was, and stop">↺ Reset</button>
            <label class="st-piece">
              <span class="sr-only">Piece</span>
              <select id="example" aria-label="Piece">
                <optgroup label="Live sets">
                  {live.map(([file, title, bars]) => <option value={file} data-bars={bars}>{title}</option>)}
                </optgroup>
                <optgroup label="Examples">
                  {examples.map(([file, title, bars]) => <option value={file} data-bars={bars}>{title}</option>)}
                </optgroup>
              </select>
            </label>
            <details class="pg-export">
              <summary class="btn">Export</summary>
              <div class="pg-export-body">
                <label>bars <input type="number" id="bars" value="8" min="1" max="64" /></label>
                <button class="btn" id="play" disabled>Render &amp; play</button>
                <button class="btn" id="download" disabled>Download WAV</button>
              </div>
            </details>
            <button class="btn" id="share">Copy link</button>
          </div>
        </div>
      </div>
      <div class="pg-progress st-progress"><div id="progress"></div></div>

      <div class="st-tabs" role="tablist" aria-label="Show">
        <button role="tab" data-pane="code" aria-selected="true">Code</button>
        <button role="tab" data-pane="perform" aria-selected="false">Perform</button>
      </div>

      <div class="st-main">
        <section class="st-code" aria-label="Code">
          <div id="editor" class="pg-editor" aria-label="niminal source"></div>
          <div class="st-toast" id="toast" role="status" aria-live="polite"></div>
        </section>
        <aside class="st-perform" aria-label="Perform">
          <div class="st-perform-head">
            <h2>Clips</h2>
            <label class="st-lands">lands
              <select id="lands" aria-label="When a clip change lands">
                <option value="">next bar</option>
                <option value="beat">next beat</option>
                <option value="now">at once</option>
              </select>
            </label>
          </div>
          <div class="st-clips" id="clips"></div>
          <p class="st-empty" id="clips-empty">Press <b>Run all</b>. Each clip in the piece appears here: tap one to start or stop it.</p>
          <div class="st-perform-head"><h2>Sliders</h2></div>
          <div class="st-sliders" id="sliders"></div>
          <p class="st-empty" id="sliders-empty">A <code>ctl</code> line in the piece becomes a slider here. Add <code>// range 300hz..12khz</code> after it to say how far it goes.</p>
        </aside>
      </div>

      <div class="st-drawer" id="drawer">
        <button class="st-drawer-bar" id="drawer-toggle" aria-expanded="false" aria-controls="drawer-body">
          <span class="chevron" aria-hidden="true">▴</span>
          <span id="status" role="status">Loading the engine…</span>
          <span class="count" id="count"></span>
        </button>
        <div class="st-drawer-body" id="drawer-body">
          <ul class="pg-errors" id="errors"></ul>
          <p class="st-help">
            The <b>▶</b> in the margin runs that line of code: <code>hook.start</code> or a note that sounds. The <b>↻</b> updates a
            definition (a clip, instrument, effect or control; <code>use</code> and <code>config</code> are read by Run all): if the piece is playing it changes at the next bar, and if not you hear nothing until
            something uses it. <b>Run block</b> does the same for the selection or the block the cursor is in. <b>Run all</b> starts the whole piece
            again from the top. <b>Stop</b> silences everything, and <b>Reset</b> puts the piece back as it was. Nothing is saved on a server: <b>Copy link</b>
            puts your piece in the address. Pieces that read sample files do not run here yet, and heavy pieces built from hand-written
            functions run slower in a browser than in <a href="/reference/stage/"><u>Stage</u></a>.
          </p>
        </div>
      </div>
    </div>
    <div class="st-keys" id="keys" role="toolbar" aria-label="Code keys"></div>

    <script>
      import { createEditor } from '../web/editor';
      import { setupKeyRow } from '../web/keys';
      import { annotatedRanges, clipCode, describe, format, positionOf, valueAt, type ControlSpec, type PerformCommand, type PerformState, type Range } from '../web/perform';
      import {
        byteToIndex, createEngine, decodePiece, encodePiece, lineColumn, shiftDiagnostics, wavFile,
        type Diagnostic, type Status,
      } from '../web/engine';

      const root = document.documentElement;
      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const shell = $('st');
      const runButton = $<HTMLButtonElement>('run');
      const runAllButton = $<HTMLButtonElement>('runall');
      const stop = $<HTMLButtonElement>('stop');
      const resetButton = $<HTMLButtonElement>('reset');
      const play = $<HTMLButtonElement>('play');
      const download = $<HTMLButtonElement>('download');
      const share = $<HTMLButtonElement>('share');
      const exampleSelect = $<HTMLSelectElement>('example');
      const bars = $<HTMLInputElement>('bars');
      const status = $('status');
      const errors = $('errors');
      const progress = $('progress');
      const now = $('now');
      const clipList = $('clips');
      const clipsEmpty = $('clips-empty');
      const slidersBox = $('sliders');
      const slidersEmpty = $('sliders-empty');
      const lands = $<HTMLSelectElement>('lands');
      const drawer = $('drawer');
      const drawerToggle = $('drawer-toggle');
      const more = $('more');
      const moreToggle = $('more-toggle');
      const count = $('count');
      const setStatus = (text: string) => { status.textContent = text; };

      // ---- the page fits what is visible: on a touch screen the keyboard takes half of it
      const viewport = window.visualViewport;
      const fit = () => {
        if (!viewport) return;
        root.style.setProperty('--vvh', `${viewport.height}px`);
        // the page itself must not scroll: everything fits above the keyboard
        if (window.scrollY !== 0) window.scrollTo(0, 0);
      };
      viewport?.addEventListener('resize', fit);
      viewport?.addEventListener('scroll', fit);
      fit();

      // ---- Code or Perform, when there is room for only one
      const showPane = (pane: string) => {
        shell.dataset.pane = pane;
        document.querySelectorAll<HTMLButtonElement>('.st-tabs button').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.pane === pane)));
      };
      document.querySelectorAll<HTMLButtonElement>('.st-tabs button').forEach((b) => b.addEventListener('click', () => showPane(b.dataset.pane!)));

      // ---- the less used buttons: always shown when there is room, behind "More" when there is not
      moreToggle.addEventListener('click', () => { const open = !more.hasAttribute('data-open'); more.toggleAttribute('data-open', open); moreToggle.setAttribute('aria-expanded', String(open)); });
      // a tap outside the menu closes it
      document.addEventListener('pointerdown', (e) => { if (!more.contains(e.target as Node)) { more.removeAttribute('data-open'); moreToggle.setAttribute('aria-expanded', 'false'); } });

      // ---- messages: closed unless something needs saying
      const setDrawer = (open: boolean) => { drawer.toggleAttribute('data-open', open); drawerToggle.setAttribute('aria-expanded', String(open)); };
      drawerToggle.addEventListener('click', () => setDrawer(!drawer.hasAttribute('data-open')));

      document.querySelectorAll<HTMLButtonElement>('[data-ground]').forEach((b) =>
        b.addEventListener('click', () => {
          const mode = b.dataset.ground as 'ink' | 'paper';
          root.setAttribute('data-mode', mode);
          root.setAttribute('data-theme', mode === 'paper' ? 'light' : 'dark');
          try { localStorage.setItem('starlight-theme', mode === 'paper' ? 'light' : 'dark'); } catch {}
          code.applyGround();
        }));

      // ---- Perform: the clips and sliders of the running piece, from its description
      let ranges = new Map<string, Range>();
      let rangesFor: unknown;
      const clipBoxes = new Map<string, { button: HTMLButtonElement; caption: HTMLElement }>();
      let clipNames = '';
      const sliderRows = new Map<string, { input: HTMLInputElement; readout: HTMLOutputElement; spec: ControlSpec; held: boolean; moved: number }>();
      let sliderKey = '';

      /** What a clip button or a slider asks for. The same commands could come from another device. */
      async function perform(command: PerformCommand) {
        if (command.kind === 'control') { await engine.control(command.name, command.value, command.unit); return; }
        // the clip answers at once: it is waiting, and says for how long, until the change lands
        const wait: Waiting = { action: command.action, landed: null, since: performance.now() };
        waiting.set(command.name, wait);
        showWaiting();
        const reply = await engine.run(clipCode(command), command.when ?? '');
        const verb = { start: 'starts', stop: 'stops' }[command.action];
        if (reply.ok) wait.landed = { bar: reply.landed.bar, beat: reply.landed.beat };
        else waiting.delete(command.name);
        setStatus(reply.ok ? `${command.name} ${verb} at bar ${reply.landed.bar}.` : (reply.message || `Could not ${command.action} ${command.name}.`));
        showWaiting();
      }

      // ---- the clock the page keeps, between the engine's reports: where the music is that you can hear now
      const clock = { bar: 1, beat: 1, bpm: 120, at: 0, behind: 0, perBar: 4, on: false };
      type Waiting = { action: string; landed: { bar: number; beat: number } | null; since: number; doneAt?: number };
      const waiting = new Map<string, Waiting>();
      const heard = () => {
        // beats since the start, as they are being heard: the engine's report, moved on by the time since, less what is still buffered
        const elapsed = (performance.now() - clock.at) / 1000;
        return (clock.bar - 1) * clock.perBar + (clock.beat - 1) + (elapsed - clock.behind) * (clock.bpm / 60);
      };
      let shownBeat = -1;
      function showBeats() {
        const box = $('beats');
        if (box.childElementCount !== clock.perBar) {
          box.replaceChildren(...Array.from({ length: clock.perBar }, () => document.createElement('i')));
        }
        const at = clock.on ? Math.floor(((heard() % clock.perBar) + clock.perBar) % clock.perBar) : -1;
        if (at === shownBeat) return;
        shownBeat = at;
        [...box.children].forEach((dot, i) => dot.toggleAttribute('data-now', i === at));
      }
      /** The caption of every clip that is waiting for a boundary: what it will do, and in how many beats. */
      function showWaiting() {
        for (const [name, wait] of waiting) {
          const box = clipBoxes.get(name);
          if (!box) { waiting.delete(name); continue; }
          const verb = { start: 'starts', stop: 'stops' }[wait.action];
          let text = `${verb}…`;
          if (wait.landed) {
            const left = (wait.landed.bar - 1) * clock.perBar + (wait.landed.beat - 1) - heard();
            // the change has landed in the engine's books, so the clip is only waiting for the sound
            text = left > 1.5 ? `${verb} in ${Math.round(left)} beats` : left > 0.5 ? `${verb} next beat` : `${verb} now`;
          }
          box.button.dataset.waiting = wait.action;
          box.caption.textContent = text;
          // give up on a change that never shows
          if (performance.now() - wait.since > 30_000) waiting.delete(name);
        }
        for (const [name, box] of clipBoxes) if (!waiting.has(name)) { delete box.button.dataset.waiting; box.caption.textContent = ''; }
      }
      const animate = () => { showBeats(); showWaiting(); requestAnimationFrame(animate); };
      requestAnimationFrame(animate);

      function showClips(state: PerformState) {
        const names = state.clips.map((c) => c.name).join('|');
        if (names !== clipNames) {
          clipNames = names;
          clipList.replaceChildren();
          clipBoxes.clear();
          for (const clip of state.clips) {
            const box = document.createElement('div');
            box.className = 'st-clipbox';
            const button = document.createElement('button');
            button.className = 'st-clip';
            const label = document.createElement('span');
            label.textContent = clip.name;
            const caption = document.createElement('small');
            button.append(label, caption);
            button.addEventListener('click', () => {
              const on = button.hasAttribute('data-on');
              void perform({ kind: 'clip', name: clip.name, action: on ? 'stop' : 'start', when: lands.value });
            });
            box.append(button);
            clipList.append(box);
            clipBoxes.set(clip.name, { button, caption });
          }
          clipsEmpty.hidden = state.clips.length > 0;
        }
        for (const clip of state.clips) {
          const box = clipBoxes.get(clip.name);
          if (!box) continue;
          box.button.toggleAttribute('data-on', clip.running && !clip.muted);
          box.button.toggleAttribute('data-muted', clip.muted);
          // the wait is over when the clip shows what was asked, a moment after the sound should have started, and
          // never later than that: a caption must not outlive the change
          const wait = waiting.get(clip.name);
          if (wait) {
            const done = { start: clip.running && !clip.muted, stop: !clip.running }[wait.action];
            const left = wait.landed ? (wait.landed.bar - 1) * clock.perBar + (wait.landed.beat - 1) - heard() : Infinity;
            if (done) wait.doneAt ??= performance.now();
            if ((done && (left < 0.2 || performance.now() - (wait.doneAt ?? 0) > 700)) || left < -2) waiting.delete(clip.name);
          }
        }
      }

      function showSliders(state: PerformState) {
        const key = state.controls.map((c) => `${c.name}:${c.range.min}:${c.range.max}:${c.range.unit}`).join('|');
        if (key !== sliderKey) {
          sliderKey = key;
          slidersBox.replaceChildren();
          sliderRows.clear();
          for (const spec of state.controls) {
            const label = document.createElement('label');
            const name = document.createElement('span');
            name.textContent = spec.label;
            const input = document.createElement('input');
            input.type = 'range';
            input.min = '0'; input.max = '1000'; input.step = '1';
            input.setAttribute('aria-label', spec.label);
            const readout = document.createElement('output');
            const row = { input, readout, spec, held: false, moved: 0 };
            let queued = false;
            input.addEventListener('pointerdown', () => { row.held = true; });
            for (const end of ['pointerup', 'pointercancel', 'blur']) input.addEventListener(end, () => { row.held = false; });
            input.addEventListener('input', () => {
              const v = valueAt(spec.range, Number(input.value) / 1000);
              readout.textContent = format(spec.range, v);
              row.moved = performance.now();
              // one message per frame at most, however fast the finger moves
              if (queued) return;
              queued = true;
              requestAnimationFrame(() => {
                queued = false;
                void perform({ kind: 'control', name: spec.name, value: valueAt(spec.range, Number(input.value) / 1000), unit: spec.range.unit });
              });
            });
            label.append(name, input, readout);
            slidersBox.append(label);
            sliderRows.set(spec.name, row);
          }
          slidersEmpty.hidden = state.controls.length > 0;
        }
        // a slider follows its control unless a finger is on it, or has just been
        for (const spec of state.controls) {
          const row = sliderRows.get(spec.name);
          if (!row || row.held || performance.now() - row.moved < 700) continue;
          row.input.value = String(Math.round(positionOf(spec.range, spec.value) * 1000));
          row.readout.textContent = format(spec.range, spec.value);
        }
      }

      function showSession(m: Status) {
        const s = m.status;
        if (!s) { now.textContent = ''; clock.on = false; return; }
        now.textContent = `bar ${s.bar} · beat ${Math.floor(s.beat)} · ${Math.round(s.bpm)} bpm`;
        now.title = `engine load ${(m.load * 100).toFixed(0)}%, ${m.buffered.toFixed(2)} s ahead, ${m.underruns} gaps`;
        now.toggleAttribute('data-warn', m.underruns > 0 || m.load > 0.85);
        // the clock the page keeps follows what the engine says, and what it has buffered ahead of the speakers
        clock.bar = s.bar; clock.beat = s.beat; clock.bpm = s.bpm; clock.at = performance.now(); clock.behind = m.buffered; clock.on = true;
        clock.perBar = Number.isFinite(s.beats_per_bar) ? Math.max(1, Math.round(s.beats_per_bar)) : 4;
        // the ranges are read again when the text has changed
        if (rangesFor !== code.view.state.doc) { rangesFor = code.view.state.doc; ranges = annotatedRanges(code.value); }
        const state = describe(s, ranges);
        showClips(state);
        showSliders(state);
      }

      const engine = createEngine({
        onStatus: showSession,
        onLost: () => { setStatus('The engine stopped unexpectedly. Run all starts it again.'); now.textContent = ''; clock.on = false; },
        onBroken: () => setStatus('The engine could not be loaded in this browser.'),
      });
      const code = createEditor({
        parent: $('editor'),
        exchange: engine.exchange,
        onRun: () => void runPart(),
        onRunAll: () => void runAll(),
      });
      setupKeyRow($('keys'), code, () => void runPart());

      function showErrors(source: string, diagnostics: Diagnostic[], message: string, warnings: string[] = []) {
        errors.replaceChildren();
        for (const d of diagnostics) {
          const from = byteToIndex(source, d.start);
          const to = byteToIndex(source, d.end);
          const { line, column } = lineColumn(source, from);
          const item = document.createElement('li');
          const where = document.createElement('span');
          where.className = 'where';
          where.textContent = `line ${line}, column ${column}: `;
          item.append(where, d.message);
          if (d.help) {
            const help = document.createElement('span');
            help.className = 'help';
            help.textContent = d.help;
            item.append(help);
          }
          item.addEventListener('click', () => { showPane('code'); code.select(from, Math.max(to, from + 1)); });
          errors.append(item);
        }
        for (const text of [message, ...warnings].filter(Boolean)) {
          const item = document.createElement('li');
          if (text !== message) item.className = 'warn';
          item.textContent = text;
          errors.append(item);
        }
        count.textContent = errors.childElementCount ? String(errors.childElementCount) : '';
        // a mistake opens the messages; a clean run closes what a mistake opened
        setDrawer(errors.childElementCount > 0);
      }

      // ---- saying what a Run did: in the drawer, and for a moment over the editor, where the eyes already are
      const toast = $('toast');
      let toastTimer: number | undefined;
      const say = (text: string) => {
        setStatus(text);
        toast.textContent = text;
        toast.toggleAttribute('data-show', true);
        clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toast.removeAttribute('data-show'), 3500);
      };
      /** What a run changed, in words: "Updated clip hats" rather than the engine's own wording. */
      function describeChanges(changes: string[]) {
        const words = changes.map((c) => {
          const m = /^\s*(instr|mono|fx|clip|bus|ctl|scene)\s+([A-Za-z_]\w*)/.exec(c);
          if (m) return `Updated ${m[1] === 'mono' ? 'instrument' : m[1] === 'instr' ? 'instrument' : m[1]} ${m[2]}`;
          const t = c.trim().replace(/\s+/g, ' ');
          return t.length > 48 ? `${t.slice(0, 45)}…` : t;
        });
        if (words.length === 0) return 'Nothing changed';
        return words.length > 3 ? `${words.slice(0, 3).join(', ')} and ${words.length - 3} more` : words.join(', ');
      }

      // ---- the live session
      let busy = false;
      let pristine = '';

      async function runAll() {
        if (busy || runButton.disabled) return;
        busy = true;
        stopPlaying();
        try {
          setStatus('Starting…');
          const text = code.value;
          const reply = await engine.start(text);
          if (!reply.ok) {
            setStatus(reply.internal ? 'The engine stopped unexpectedly.' : 'There is a mistake in the piece, so it did not start.');
            showErrors(text, reply.diagnostics, reply.message);
            return;
          }
          showErrors(text, [], '');
          code.flash(0, code.view.state.doc.length);
          setStatus('Playing. Tap a clip to start or stop it, or ▶ in the margin to run a line of code (↻ updates a definition).');
        } catch {
          setStatus('Audio could not be started in this browser.');
        } finally { busy = false; }
      }

      async function runPart() {
        if (busy || runButton.disabled) return;
        // nothing is playing yet, so there is nothing to change: start the piece
        if (!engine.sessionOn) return runAll();
        const part = code.target();
        if (!part) { setStatus('Put the cursor in some code, or select some, and press Run block.'); return; }
        busy = true;
        stopPlaying();
        try {
          const text = code.value;
          const reply = await engine.run(text.slice(part.from, part.to));
          if (!reply.ok) {
            // the engine located the mistakes within the piece it was given: move them into the whole text
            setStatus(reply.internal ? 'The engine stopped unexpectedly.' : 'There is a mistake in that code, so it was not run.');
            showErrors(text, shiftDiagnostics(text, part.from, reply.diagnostics), reply.message);
            return;
          }
          showErrors(text, [], '');
          code.flash(part.from, part.to);
          say(`${describeChanges(reply.landed.changes)}. Heard from bar ${reply.landed.bar}.`);
        } finally { busy = false; }
      }

      async function stopAll() {
        stopPlaying();
        if (!engine.sessionOn) return;
        await engine.hush();
        setStatus('Stopped. Run block plays again, and Run all starts the piece from the top.');
      }

      async function reset() {
        if (code.value !== pristine && !confirm('Put the piece back as it was? Your changes will be lost.')) return;
        stopPlaying();
        await engine.stop();
        now.textContent = ''; clock.on = false;
        waiting.clear();
        code.value = pristine;
        showErrors(pristine, [], '');
        setStatus('Back to the start. Run all plays it.');
      }

      // ---- Export: render the whole piece, then play it
      let source: AudioBufferSourceNode | undefined;
      let last: { channels: Float32Array[]; sampleRate: number } | undefined;
      let frame = 0;

      function stopPlaying() {
        cancelAnimationFrame(frame);
        progress.style.width = '0';
        try { source?.stop(); } catch {}
        source = undefined;
      }

      async function renderAndPlay() {
        if (play.disabled) return;
        stopPlaying();
        // the context must be made or resumed inside the click, before anything is awaited
        const ctx = engine.context();
        // the live session and a render would play over each other
        await engine.stop();
        now.textContent = ''; clock.on = false;
        play.disabled = true;
        download.disabled = true;
        const text = code.value;
        // the render happens in a worker, so the page can keep counting while it waits
        const waitingSince = performance.now();
        const say = () => setStatus(`Rendering… ${Math.floor((performance.now() - waitingSince) / 1000)} s`);
        say();
        const waiting = setInterval(say, 250);
        showErrors(text, [], '');
        const result = await engine.render(text, Number(bars.value) || 8);
        clearInterval(waiting);
        play.disabled = false;
        if (!result.ok) {
          setStatus(result.internal ? 'The engine stopped unexpectedly.' : 'There is a mistake in the piece.');
          showErrors(text, result.diagnostics, result.message);
          return;
        }
        showErrors(text, [], '', result.warnings);
        last = { channels: result.channels, sampleRate: result.sampleRate };
        download.disabled = false;
        const frames = result.channels[0].length;
        const buffer = ctx.createBuffer(result.channels.length, frames, result.sampleRate);
        result.channels.forEach((c, i) => buffer.copyToChannel(c, i));
        source = ctx.createBufferSource();
        source.buffer = buffer;
        source.connect(ctx.destination);
        const seconds = frames / result.sampleRate;
        const started = ctx.currentTime;
        source.onended = () => { stopPlaying(); setStatus(`Played ${seconds.toFixed(1)} s (rendered in ${(result.renderMs / 1000).toFixed(2)} s).`); };
        source.start();
        setStatus(`Playing ${seconds.toFixed(1)} s (rendered in ${(result.renderMs / 1000).toFixed(2)} s).`);
        const tick = () => {
          progress.style.width = `${Math.min(100, ((ctx.currentTime - started) / seconds) * 100)}%`;
          frame = requestAnimationFrame(tick);
        };
        tick();
      }

      play.addEventListener('click', renderAndPlay);
      runButton.addEventListener('click', () => void runPart());
      runAllButton.addEventListener('click', () => void runAll());
      stop.addEventListener('click', () => void stopAll());
      resetButton.addEventListener('click', () => void reset());

      download.addEventListener('click', () => {
        if (!last) return;
        const link = document.createElement('a');
        link.href = URL.createObjectURL(wavFile(last.channels, last.sampleRate));
        link.download = 'niminal.wav';
        link.click();
        setTimeout(() => URL.revokeObjectURL(link.href), 10_000);
      });

      // ---- sharing: the piece, compressed, in the address
      share.addEventListener('click', async () => {
        let url: string;
        try {
          url = `${location.origin}${location.pathname}#c=${await encodePiece(code.value)}&b=${Number(bars.value) || 8}`;
        } catch { setStatus('Could not make a link in this browser.'); return; }
        history.replaceState(null, '', url);
        try {
          await navigator.clipboard.writeText(url);
          setStatus('The link, with your piece in it, is copied.');
        } catch { setStatus('The link, with your piece in it, is in the address bar.'); }
      });

      // ---- starting points
      async function loadExample(name: string) {
        const wanted = exampleSelect.querySelector<HTMLOptionElement>(`option[value="${name}"]`)?.dataset.bars;
        if (wanted) bars.value = wanted;
        const response = await fetch(`/web/${name}.nml`);
        pristine = response.ok ? await response.text() : '// could not load the example';
        code.value = pristine;
        showErrors(pristine, [], '');
      }
      exampleSelect.addEventListener('change', async () => {
        stopPlaying();
        await engine.stop();
        now.textContent = ''; clock.on = false;
        history.replaceState(null, '', location.pathname);
        await loadExample(exampleSelect.value);
        setStatus('Run all plays it.');
      });

      (async () => {
        const shared = new URLSearchParams(location.hash.slice(1));
        const hash = shared.get('c');
        if (Number(shared.get('b')) > 0) bars.value = String(Math.min(64, Number(shared.get('b'))));
        if (hash) {
          try { pristine = await decodePiece(hash); code.value = pristine; } catch { await loadExample(exampleSelect.value); }
        } else {
          await loadExample(exampleSelect.value);
        }
        await engine.warm();
        for (const b of [runButton, runAllButton, resetButton, play, stop]) b.disabled = false;
        setStatus('Ready. Press Run all to start the piece.');
      })();
    </script>
  </body>
</html>
