// A pluck played through a pitch-shifting multi-tap delay: sixteen repeats that climb in pitch, bunched up towards the
// end like a ball bouncing to rest and thrown left and right, with a band-pass on every tap, a little feedback through
// its own octave shift, and a gentle wobble. In the third bar of every four the delay plays backwards, and in the fourth it freezes.
// pluck -> tap_delay (shifts, step, curve, filter, feedback, wobble, reverse, freeze)
// Render: niminal render examples/rain.nml --bars 12 --out rain.wav
config { channels: stereo }
tempo 90bpm

use std/blocks

fn plucks() { impulse((1 / (2beat).num).hz) }

instr rain() {
  open = gate_length(plucks(), length: 90ms).smooth(3ms)
  hit = osc(saw, 196hz).lpf(cutoff: 1.5khz) * open * 0.5
  phase = clock.bar.mod(4)
  frozen = if phase > 3 { 1 } else { 0 }
  backwards = if phase > 2 and phase <= 3 { 1 } else { 0 }
  echoes = tap_delay(hit, time: 3/16 * clock.beat_length, taps: 16, shifts: [0, 0, 7, 12], step: 0, decay: 0.82, curve: 0.8, spread: 0.8, filter: bandpass, cutoffs: [600hz, 1.2khz, 2.4khz, 4khz], resonance: 0.35, feedback: 0.35, feedback_shift: 12, feedback_tone: 0.2, wobble: 0.3, wobble_rate: 0.4hz, reverse: backwards, freeze: frozen)
  [hit * 0.4 + echoes.left, hit * 0.4 + echoes.right] * 1.2
}

// Times are relative to where the file is evaluated, so evaluate it on a bar line.
at +0bars rain() for 12bars
