// Samples and kits. Every .wav in the folder is a sample you can name in a pattern.
// Give a drum its own node for effects; name that node in a grid row and the
// hits go through its strip. Rows can take pan/gain/pitch and mini-notation.
// Render with:  niminal render examples/drums.nml --out drums.wav --bars 4
config { channels: stereo }
tempo 100bpm

bus room: stereo
processor room_return {
  out = room.reverb(room: 0.35, damp: 0.5).gain(0.7)
}

drums = kit("drums")

part beat { instrument = drums }
processor snare_fx {
  out = it.gain(-1db)
  room += out.gain(-12db)
}
part snare {
  instrument = drums.snare
  output = snare_fx
}
processor hat_fx {
  out = it.hpf(cutoff: 6khz)
}
part hat {
  instrument = drums.hat
  output = hat_fx
}

beat.play(grid {
  kick:             x... x... x... x..x
  snare(pan: 8deg): [~ x ~ [x o]]
  hat(gain: -4db):  [x*2 x x(3,8)]
})
