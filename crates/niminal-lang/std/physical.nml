// Models of struck and plucked things: `use std/physical`. `modal`, the bank of resonators they are made
// of, is an opcode.

/// A plucked string (Karplus-Strong). Feed it a short burst of noise or an impulse; the burst circulates in
/// a delay line of one period that loses a little each time round, so it settles into a tone at `freq`.
/// `decay` near 1 rings longer and `damp` is how fast the highs die away (0 keeps them). `max` is the
/// longest period, so the lowest `freq` is 1 / `max`. It is `comb` with the delay tuned to the pitch.
fn string(x, freq: init hz, decay: 0..1 = 0.996, damp: 0..0.95 = 0.5, max: const sec = 50ms) {
  x.comb(time: 1sec / freq.num - 1sec * damp / (1 - damp) / sample_rate.num, feedback: decay, damp: damp, max: max)
}

const drum_modes = [1, 1.593, 2.136, 2.296, 2.653, 2.918, 3.156, 3.501]
const free_bar_modes = [1, 2.756, 5.404, 8.933, 13.34, 18.64]
const bell_modes = [0.5, 1, 1.19, 1.56, 2, 2.51, 2.66, 3.01, 4.1]

/// A drum: the first modes of an ideal circular membrane. Strike it with a click or a short burst.
fn membrane(x, freq: init hz, decay: 10ms..10sec = 150ms) {
  x.modal(freq, drum_modes, decay: decay)
}

/// A free bar, as in a glockenspiel: the partials are far from harmonic.
fn free_bar(x, freq: init hz, decay: 10ms..10sec = 500ms) {
  x.modal(freq, free_bar_modes, decay: decay)
}

/// A bell, with a hum tone an octave below the strike note.
fn bell(x, freq: init hz, decay: 10ms..10sec = 750ms) {
  x.modal(freq, bell_modes, decay: decay)
}
