// Clips select instruments. Fx declarations own persistent effects. Buses collect shared sends.
// Render with:  nimlive render examples/fx.nml --out fx.wav
config { channels: stereo }
tempo 110bpm

bus space: stereo
bus echo: stereo

instr pluck(freq: hz, bright: 0..1 = 0.5) {
  voice = osc(saw, freq).lpf(cutoff: freq * (2 + bright * 8), res: 0.25) * perc(decay: 400ms)
  voice.pan(azimuth: 0deg)
}

// Persistent fx declarations read the shared buses.
fx hall { out = space.reverb(room: 0.8, damp: 0.4).gain(0.8) }
fx slap { out = echo.lpf(cutoff: 6khz).gain(-1db) }

// Each instrument routes its summed voices through a dedicated fx.
fx bass_fx {
  out = bass_fx_audio.lpf(cutoff: 1500hz).gain(-3db)
  space     += out.gain(-16db)
}
bus bass_fx_audio: stereo
instr bass_voice(freq: hz) {
  voice = pluck(bright: 0.2, freq: freq)
  bass_fx_audio += voice
}
clip bass {
  instrument: bass_voice
}

fx lead_fx {
  out        = lead_fx_audio.gain(-6db)
  space     += out.gain(-1db)
  echo      += out.delay(time: 3/8beat, feedback: 0.6).gain(-8db)
}
bus lead_fx_audio: stereo
instr lead_voice(freq: hz) {
  voice = pluck(bright: 0.8, freq: freq)
  lead_fx_audio += voice
}
clip lead { instrument: lead_voice }

bass.play([c2 ~ c2 eb2 ~ g1 bb1 ~])
lead.play([c4 e4 g4 b4].every(2, it.reverse))
at +4bars hush
