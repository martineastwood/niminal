// Building blocks to wire together, in the manner of modules in a rack: `use std/blocks`.
// A block takes signals in, so another block (a grid, an envelope, a random signal) can drive any of its parameters.

/// Weights for scanning an array: centre 0 selects its first member, 1 its last. Width is in
/// members: 1 crossfades neighbours, larger values open a wider triangular window.
/// The weights sum to one wherever the array is nonempty. Empty arrays return empty weights.
fn scan_weights(count: const int, centre: 0..1 = 0.5, width: 1..64 = 1) {
  _position = centre.max(0).min(1) * (count - 1).max(0)
  _weights = (0..<count).map((1 - abs(it - _position) / width.max(1).min(64)).max(0))
  if count > 0 { _weights / _weights.sum.max(0.001) } else { _weights }
}

/// Scan across signals, harmonics or effect returns. At width 1, centre crossfades adjacent inputs;
/// a wider window blends more of them. A constant input stays constant while the window moves.
fn scan_mix(signals: [num], centre: 0..1 = 0.5, width: 1..64 = 1) {
  if signals.len > 0 { (signals * scan_weights(signals.len, centre: centre, width: width)).sum } else { 0 }
}

/// A harmonic source with mixed and individual, levelled partial outputs. Brightness tilts the series;
/// odd_even selects odd (1) or even (-1) harmonics. Scan moves an emphasis through the spectrum,
/// width sets its breadth in partials, and focus blends from the whole series to that window.
/// Gates multiply individual partials (missing gates stay open). All partial outputs share the mixed
/// output's normalization, so summing them reproduces mixed. Above 45% of sample rate they are silent.
fn harmonic_bank(
  freq: hz,
  gates: [num] = [1],
  count: const int = 16,
  brightness: 0..1 = 0.5,
  odd_even: -1..1 = 0,
  gate_smooth: sec = 4ms,
  centre: 0..1 = 0.5,
  width: 1..64 = 2,
  focus: 0..1 = 0
) -> (mixed, partials) {
  _slope = 2 - 1.9 * brightness.max(0).min(1)
  _balance = odd_even.max(-1).min(1)
  _window = scan_weights(count, centre: centre, width: width)
  _focus = focus.max(0).min(1)
  _levels = for i in 0..<count {
    _parity = if i.mod(2) == 0 { 1 + _balance.min(0) } else { 1 - _balance.max(0) }
    pow(i + 1, 0 - _slope) * _parity * if freq * (i + 1) < sample_rate * 0.45 { 1 } else { 0 }
  }
  _selected = _levels * (1 - _focus + _window * _focus)
  _heard = for i in 0..<count {
    _selected[i] * if i < gates.len { gates[i].max(0).min(1).smooth(gate_smooth.max(0sec)) } else { 1 }
  }
  _frequencies = (0..<count).map(freq * (it + 1))
  partials = osc(sine, _frequencies) * _heard / _selected.sum.max(0.001)
  mixed = partials.sum
}

/// The mixed output of harmonic_bank. Focus 0 keeps the full series; raise it to scan the spectrum.
fn harmonic_osc(
  freq: hz,
  gates: [num] = [1],
  count: const int = 16,
  brightness: 0..1 = 0.5,
  odd_even: -1..1 = 0,
  gate_smooth: sec = 4ms,
  centre: 0..1 = 0.5,
  width: 1..64 = 2,
  focus: 0..1 = 0
) {
  harmonic_bank(freq, gates: gates, count: count, brightness: brightness, odd_even: odd_even,
    gate_smooth: gate_smooth, centre: centre, width: width, focus: focus).mixed
}

/// A shape that repeats against the transport, from 0 up to 1 and back: `cycle` beats long, rising for the first
/// `rise` of them (a share, 0 to 1) and falling for the rest. `curve` bends both sides: 1 is straight, above 1
/// holds back at the bottom, below 1 hurries away from it. It follows the tempo and the bar, so a swell
/// `function_gen(cycle: 32, rise: 0.75)` always peaks on the same beat of every eight bars of four beats.
fn function_gen(cycle: num = 8, rise: 0..1 = 0.5, curve: 0.1..10 = 1) {
  _phase = (clock.beat / cycle.max(0.001)).mod(1)
  _up = _phase / rise.max(0.001)
  _down = (1 - _phase) / (1 - rise).max(0.001)
  pow(_up.min(_down).max(0).min(1), curve.max(0.001))
}

/// A triggered rise/fall contour. A positive edge starts a rise from the current level, then a fall.
/// Holding trigger high does not retrigger. Cycle starts immediately and repeats until switched off;
/// switching it off finishes the current contour. Rise/fall are full-scale travel times, up to 60sec.
/// Zero time takes one sample. Curve 1 is linear; higher curves hold the output closer to zero.
/// Outputs: value (0..1), eor and eoc (one-sample pulses at end of rise and end of cycle).
fn contour(
  trigger: num = 0,
  rise: 0sec..60sec = 10ms,
  fall: 0sec..60sec = 300ms,
  curve: 0.1..10 = 1,
  cycle: 0..1 = 0
) -> (value, eor, eoc) {
  state _level = 0
  state _stage = 0
  state _previous = 0
  _high = if trigger > 0 { 1 } else { 0 }
  if (_high > 0 and _previous <= 0) or (_stage == 0 and cycle > 0) {
    _stage = 1
  }
  _previous = _high
  eor = 0
  eoc = 0
  if _stage == 1 {
    _level = (_level + 1 / (rise.num.max(0).min(60) * sample_rate.num).max(1)).min(1)
    if _level >= 1 {
      _stage = 2
      eor = 1
    }
  } else {
    if _stage == 2 {
      _level = (_level - 1 / (fall.num.max(0).min(60) * sample_rate.num).max(1)).max(0)
      if _level <= 0 {
        _stage = 0
        eoc = 1
      }
    }
  }
  value = pow(_level, curve.max(0.1).min(10))
}

/// Random values from -1 to 1, a new one every `beats` beats: `stepped` holds each until the next, `smooth` slides
/// to it over most of the beats. The same `seed` is the same run every time, and another seed is another run.
fn wobble(beats: num = 0.5, shape: (stepped | smooth) = stepped, seed: const num = 0) {
  _rate = 1hz * (clock.bpm / 60 / beats.max(0.001))
  if shape == stepped {
    random_steps(_rate, seed: seed)
  } else {
    random_glide(_rate, glide: clock.beat_length * beats.max(0.001) * 0.9, seed: seed).smooth(10ms)
  }
}

/// A gate that follows the transport: high for the first `width` (a share, 0 to 1) of every `beats` beats, so
/// `clock_div(1/2)` is eighth notes, `clock_div(3/2)` is a dotted quarter against the bar, and `clock_div(4)` is a
/// bar of four. Several at different `beats` make clocks that drift against each other and meet again.
fn clock_div(beats: num = 1, width: 0..1 = 0.5) {
  if (clock.beat / beats.max(0.001)).mod(1) < width { 1 } else { 0 }
}

/// Echoes of `x` and nothing else, to be blended with the dry sound: `x.crossfade(x.echo_loop(...), mix)`.
/// `time` follows the tempo (`3/16beat` is a dotted eighth) and `feedback` is how much of each echo goes round
/// again. `filter` is a low-pass in the loop, so each repeat is darker than the one before. `duck` (0 to 1) pulls the
/// echoes down while `x` is loud and lets them back up when it stops, so they clear the way for the next note.
/// `ping_pong: on` mixes `x` to one channel and bounces the echoes between left and right, the first on the right. `max` is the
/// longest the loop can be, in seconds, and for a ping-pong at least twice `time`.
fn echo_loop(
  x,
  time: division = 3/16 * clock.beat_length,
  feedback: 0..0.95 = 0.5,
  filter: 20hz..20khz = 3khz,
  duck: 0..1 = 0,
  ping_pong: (off | on) = off,
  max: const sec = 2sec
) {
  _mono = x.sum / x.channels.len
  _wet = if ping_pong == on {
    // the right hears echoes 1, 3, 5... and the left 2, 4, 6..., each `feedback` quieter than the one before
    _first = _mono.delay(time, damp: filter, max: max)
    _right = _first + _first.delay(time * 2, feedback: feedback * feedback, damp: filter, max: max) * feedback * feedback
    [_right.delay(time, damp: filter, max: max) * feedback, _right]
  } else {
    x.delay(time, feedback: feedback, damp: filter, max: max)
  }
  _wet * (1 - duck * (follow(_mono, attack: 5ms, release: 200ms) * 3).min(1))
}

/// Stereo wet-only repeats: skew offsets left/right times around time (0 gives equal timing).
/// Lower colour darkens the feedback; diffusion smears the returned echoes through allpass stages.
/// Motion adds independent 0.17hz/0.23hz read-head drift, up to 3ms, for tape-like pitch movement.
/// Time changes use the native smoothed, speed-limited read head and bend pitch. Duck clears space for the incoming sound.
/// Stereo inputs keep their channels; mono is sent to both sides. Longer arrays use first/last.
/// Drive saturates the repeats like tape does, softly rounding peaks and adding warmth; 0 leaves them clean.
/// This is two independent feedback lines, not a cross-feedback or ping-pong network.
fn stereo_echo(
  x,
  time: sec = 3/16 * clock.beat_length,
  feedback: 0..0.95 = 0.5,
  colour: 0..1 = 0.5,
  skew: -1..1 = 0.25,
  diffusion: 0..1 = 0.2,
  motion: 0..1 = 0.1,
  duck: 0..1 = 0,
  drive: 0..1 = 0,
  max: const sec = 4sec
) {
  _skew = skew.max(-1).min(1) * 0.5
  _motion = motion.max(0).min(1) * 3ms
  _times = [(time * (1 - _skew)) + osc(sine, 0.17hz) * _motion,
    (time * (1 + _skew)) + osc(sine, 0.23hz) * _motion]
  _input = [x[0], x[x.channels.len - 1]]
  _cutoff = 400hz * pow(40, colour.max(0).min(1))
  _wet = _input.delay(time: _times.map(it.max(1ms).min(max)), feedback: feedback.max(0).min(0.95), damp: _cutoff, max: max)
  _smear = _wet.allpass(time: [17ms, 23ms], feedback: 0.6)
    .allpass(time: [31ms, 43ms], feedback: 0.6)
  _level = follow(_input.map(abs(it)).max, attack: 5ms, release: 200ms)
  _mixed = _wet.crossfade(_smear, diffusion.max(0).min(1))
  _push = 1 + drive.max(0).min(1) * 3
  _tape = _mixed.crossfade((_mixed * _push).tanh / _push.sqrt, drive.max(0).min(1))
  _tape * (1 - duck.max(0).min(1) * (_level * 3).min(1))
}

/// A wet-only stereo space. Size moves the tank geometry; decay controls its feedback.
/// Absorption darkens the circulating tail, diffusion changes scattering in the tank, and tilt balances
/// bass against treble on the return (up to 6db each way). Motion moves size by up to 0.02 at rate,
/// bending the existing tail without resetting it. Predelay separates the source from its space.
/// Duck responds to the louder input channel, including opposite-polarity stereo sounds.
fn space_reverb(
  x,
  size: 0..1 = 0.5,
  decay: 0..1 = 0.65,
  absorption: 0..1 = 0.4,
  diffusion: 0..1 = 0.7,
  motion: 0..1 = 0.2,
  rate: 0.01hz..4hz = 0.07hz,
  predelay: 0ms..200ms = 20ms,
  tilt: -1..1 = 0,
  duck: 0..1 = 0
) {
  _input = [x[0], x[x.channels.len - 1]]
  _size = (size.max(0).min(1) + osc(sine, rate.max(0.01hz).min(4hz)) * motion.max(0).min(1) * 0.02).max(0).min(1)
  _feed = _input.delay(time: predelay.max(0ms).min(200ms), max: 200ms)
  _wet = _feed.mverb(size: _size, decay: decay.max(0).min(1),
    damp: absorption.max(0).min(1), density: diffusion.max(0).min(1),
    predelay: 0ms, early_mix: 0.85, mix: 1)
  _tone = tilt.max(-1).min(1)
  _coloured = _wet.low_shelf(cutoff: 300hz, gain: pow(2, 0 - _tone))
    .high_shelf(cutoff: 3khz, gain: pow(2, _tone))
  _level = follow(_input.map(abs(it)).max, attack: 5ms, release: 200ms)
  _coloured * (1 - duck.max(0).min(1) * (_level * 3).min(1))
}

/// A state-variable filter with all four responses at once: low, band, high and notch come from the same
/// two integrators, so they can be crossfaded, summed or sent to different places. Stable for any cutoff
/// (held to 10hz..45% of the sample rate) and any resonance, including changes at audio rate; stereo input
/// is filtered channel by channel. Resonance 1 rings long without running away: above 0.6 the filter
/// saturates more as it rises, so low and band stay near ±1.5 for a full-scale input. Band has the
/// same gain as low at the cutoff: 0.5 at resonance 0, rising with resonance. `drive` (0..1) pushes the input into a
/// soft clip and saturates the filter at any resonance, for a thicker, rounder sound.
fn multimode_filter(x, cutoff: hz = 1khz, res: 0..1 = 0.2, drive: 0..1 = 0) -> (low, band, high, notch) {
  state _s1 = x * 0
  state _s2 = x * 0
  _drive = drive.max(0).min(1)
  _res = res.max(0).min(1)
  _push = 1 + _drive * 7
  _in = x.crossfade((x * _push).tanh, _drive)
  _g = tan(pi * cutoff.max(10hz).min(sample_rate * 0.45) / sample_rate)
  _k = 2 - 1.95 * _res
  _a1 = 1 / (1 + _g * (_g + _k))
  _v1 = _a1 * _s1 + _g * _a1 * (_in - _s2)
  _v2 = _s2 + _g * _v1
  _next = 2 * _v1 - _s1
  _s1 = _next.crossfade((_next / 1.5).tanh * 1.5, _drive.max((_res - 0.6) * 2.5).min(1))
  _s2 = 2 * _v2 - _s2
  low = _v2
  band = _v1
  high = _in - _k * _v1 - _v2
  notch = _in - _k * _v1
}

/// A low-pass gate: one control opens a filter and an amplifier together, the way a light-dependent
/// resistor does, so a sound darkens as it fades. `ping` strikes it on each positive edge; the default, 1,
/// strikes once as a note starts. A strike opens it in a few milliseconds and lets it close over about
/// `decay`, quickly at first and then lingering. `level` (0..1) holds it open on top of the strikes, for a
/// gate driven by an envelope or a slow shape. `mode` opens the filter and amplifier together (`both`), the
/// filter alone or the amplifier alone; `res` adds a little ring. Outputs: sound, and opening (0..1) to drive other things.
fn low_pass_gate(
  x,
  ping: num = 1,
  level: 0..1 = 0,
  decay: 10ms..10sec = 400ms,
  res: 0..1 = 0.1,
  mode: (both | filter | gate) = both
) -> (sound, opening) {
  state _light = 0
  state _rising = 0
  state _previous = 0
  _high = if ping > 0 { 1 } else { 0 }
  if _high > 0 and _previous <= 0 {
    _rising = 1
  }
  _previous = _high
  if _rising > 0 {
    _light = _light + (1 - _light) * 0.004
    if _light > 0.98 {
      _light = 1
      _rising = 0
    }
  } else {
    _fall = exp(-6.9 / (decay.num.max(0.01).min(10) * sample_rate.num))
    _light = _light * pow(_fall, 0.35 + 0.65 * _light)
  }
  opening = _light.max(level.max(0).min(1).smooth(5ms))
  _cutoff = 60hz * pow(250, opening)
  _filtered = if mode == gate { x } else { x.multimode_filter(cutoff: _cutoff, res: res.max(0).min(1) * 0.6).low }
  sound = if mode == filter { _filtered } else { _filtered * opening * opening }
}

/// Two sines wired together: a modulator at `ratio` times `freq` bends the main sine's phase (`index` is the
/// depth in radians, through zero) and can ring it (`am`, 0 to 1). The result goes through a sine fold:
/// `fold` (0..1) adds bright, folded harmonics and `symmetry` (-1..1) tips the fold for even ones. Folding
/// eases off above 2khz to keep high notes from aliasing. Whole-number and simple ratios sound harmonic;
/// others clang like bells. Within ±1 unfolded; folding (its offset removed) peaks a little higher,
/// and the output never passes ±1.2. Outputs: sound, and the modulator on its own.
fn complex_osc(
  freq: hz,
  ratio: 0.125..16 = 2,
  index: 0..8 = 1,
  am: 0..1 = 0,
  fold: 0..1 = 0,
  symmetry: -1..1 = 0
) -> (sound, modulator) {
  _freq = freq.max(0hz).min(sample_rate * 0.45)
  modulator = osc(sine, _freq * ratio.max(0.125).min(16))
  _main = osc(sine, _freq, phase_mod: modulator * index.max(0).min(8) / 6.283185)
  _ringed = _main.crossfade(_main * modulator, am.max(0).min(1))
  _fold = fold.max(0).min(1) * (2khz / _freq.max(2khz))
  _folded = sin(1.570796 * (_ringed * (1 + 5 * _fold) + symmetry.max(-1).min(1) * _fold)).dc_block
  sound = _ringed.crossfade(_folded, (_fold * 4).min(1)).clip(level: 1.2)
}

/// A looping random sequence in the manner of a shift register. On each positive edge of `clock` it steps to
/// the next of `length` stored values, and `lock` is the chance of keeping that value: 1 repeats the loop
/// exactly, 0 makes every step new, and in between the loop slowly changes. The same `seed` gives the same
/// run. Outputs: value (-1..1, held between steps) and gate, high while the clock is high on steps whose
/// value is above 0, so the loop's rhythm repeats with its pitches. Quantize value before using it as pitch.
fn shift_random(clock: num = 0, lock: 0..1 = 0.75, length: const int = 8, seed: const num = 0) -> (value, gate) {
  state _register = (0..<length).map(fract(sin((it + 1) * 12.9898 + seed * 78.233) * 43758.5453) * 2 - 1)
  state _step = 0
  state _previous = 0
  _draw = noise(seed: seed)
  _chance = noise(seed: seed + 1) * 0.5 + 0.5
  _high = if clock > 0 { 1 } else { 0 }
  if _high > 0 and _previous <= 0 {
    _step = (_step + 1).mod(length)
    if _chance > lock {
      _register[_step] = _draw
    }
  }
  _previous = _high
  value = _register[_step]
  gate = if _high > 0 and value > 0 { 1 } else { 0 }
}

/// A cloud of grains cut from a sample or table, with every control held to a range that cannot run away.
/// `position` (0 to 1) is where in the source the grains start and `spread` (0 to 1) scatters them either side of it,
/// up to 400ms of the source. Each grain is `size` long (5ms to 500ms) and `density` of them start every second
/// (1hz to 100hz); a grain is a smooth bell shape, so the cloud has no clicks. `pitch` transposes in semitones, `detune`
/// adds up to that many semitones either way to each grain at random, and `width` spreads grains across the stereo
/// field. The level is scaled down as the grains overlap more, so a thick cloud is no louder than a thin one. The same
/// `seed` gives the same cloud each time. Move `position` with a slow signal, like `phasor(0.1hz)`, to scan the source.
fn texture(
  source: [num],
  position: 0..1 = 0.5,
  size: 5ms..500ms = 100ms,
  density: 1hz..100hz = 20hz,
  pitch: -24..24 = 0,
  spread: 0..1 = 0.2,
  detune: 0..12 = 0,
  width: 0..1 = 0.5,
  gain: 0..2 = 1,
  seed: const num = 0
) {
  _size = size.max(5ms).min(500ms)
  _density = density.max(1hz).min(100hz)
  _overlap = (_density.num * _size.num).max(1)
  granular(source, density: _density, duration: _size, position: position.max(0).min(1),
    pitch: pitch.max(-24).min(24), spray: spread.max(0).min(1) * 400ms,
    pitch_scatter: detune.max(0).min(12), spread: width.max(0).min(1),
    gain: gain.max(0).min(2) / sqrt(_overlap), seed: seed)
}

/// Snap a note number (semitones) to the nearest note of a scale. `scale` lists the scale's notes within one octave
/// (the default is major; `[0, 3, 5, 7, 10]` is minor pentatonic, `[0, 2, 3, 5, 7, 8, 10]` natural minor, `[0, 7]` fifths),
/// `root` moves the scale up or down and `amount` blends between the note as it came (0) and the snapped note (1).
/// Notes are held to ±1000 semitones. A note exactly between two scale notes goes to the lower one. Works on any value, not only pitch: `shift_random(...)
/// .value * 12` quantized is a melody, and a slow LFO quantized is a staircase.
fn quantize(note: num, scale: [num] = [0, 2, 4, 5, 7, 9, 11], root: -12..12 = 0, amount: 0..1 = 1) {
  _count = scale.len * 3
  _note = note.max(-1000).min(1000)
  _rel = _note - root.max(-12).min(12)
  _octave = floor(_rel / 12)
  _within = _rel - _octave * 12
  _degrees = for i in 0.._count - 1 { scale[i.mod(scale.len)] + 12 * (floor(i / scale.len) - 1) }
  _distance = _degrees.map(abs(_within - it) + it * 0.000001)
  _nearest = _distance.min
  _chosen = for i in 0.._count - 1 { if _distance[i] <= _nearest { _degrees[i] } else { 0 } }
  _tied = for i in 0.._count - 1 { if _distance[i] <= _nearest { 1 } else { 0 } }
  _note.crossfade(root.max(-12).min(12) + _octave * 12 + _chosen.sum / _tied.sum.max(1), amount.max(0).min(1))
}

/// A channel vocoder: the loudness of `modulator` in each of `bands` frequency bands (from `low` to `high`, spaced
/// evenly in pitch) shapes the same bands of `carrier`, so a voice speaks through a synth. Use a rich carrier,
/// such as a saw or a chord. `width` narrows the bands (more is sharper), `attack` and `release` set how fast
/// each band follows the modulator, and `hiss` lets the modulator's consonants through as noise. Stereo
/// inputs are mixed to mono.
fn vocoder(
  carrier,
  modulator,
  bands: const int = 16,
  low: 40hz..2khz = 120hz,
  high: 1khz..16khz = 8khz,
  width: 0.5..8 = 3,
  attack: 1ms..100ms = 4ms,
  release: 5ms..500ms = 40ms,
  hiss: 0..1 = 0.3
) {
  _low = low.max(40hz).min(2khz)
  _high = high.max(_low * 2).min(sample_rate * 0.4)
  _centres = (0..<bands).map(_low * pow(_high / _low, it / (bands - 1).max(1)))
  _res = width.max(0.5).min(8) * 0.15
  _speech = modulator.sum
  _bands = _speech.bpf(_centres, res: _res).follow(attack: attack.max(1ms).min(100ms), release: release.max(5ms).min(500ms))
  _voiced = (carrier.sum.bpf(_centres, res: _res) * _bands).sum
  _hissy = noise() * _speech.hpf(_high * 0.7).follow(attack: 2ms, release: 20ms) * hiss.max(0).min(1)
  (_voiced * 4 / sqrt(bands) + _hissy).clip(level: 1.5)
}

/// Two signals into one, the way a mixer of ring modulators and folders does. Inputs `a` and `b` are held to ±16.
/// `ring` multiplies them, `fold` lets `b`'s size push `a` into a wavefolder, and `diode` multiplies `a` by `b` and by
/// the positive half of `b`, so `a` also comes through while `b` is positive, with rougher overtones. Silence in `a` is
/// silence out in every mode, and `ring` and `diode` are silent when `b` is too. `amount` (0 to 1) blends from `a` untouched to the full effect. `aux`
/// is the plain product of the two, to use on its own. Outputs stay within ±1.2.
fn cross_mod(
  a,
  b,
  mode: (ring | fold | diode) = ring,
  amount: 0..1 = 0.5
) -> (sound, aux) {
  _a = a.max(-16).min(16)
  _b = b.max(-16).min(16)
  _amount = amount.max(0).min(1)
  _ring = _a * _b
  _fold = sin(1.570796 * _a * (1 + 6 * _amount * abs(_b))).dc_block
  _diode = _a * (_b * 0.5 + _b.max(0))
  _wet = if mode == ring { _ring } else { if mode == fold { _fold } else { _diode } }
  sound = _a.crossfade(_wet, _amount).clip(level: 1.2)
  aux = _ring.clip(level: 1.2)
}

/// Follow a signal with separate `rise` and `fall` times, so it climbs quickly and falls slowly, or the other way round.
/// It works on any signal: smooth a stepped random value, turn a gate into an envelope, add portamento to a pitch,
/// or make a sound swell in and decay out. `smooth` takes the time to cover about two thirds of the distance, with fast
/// moves starting quickly and slowing down; `linear` takes that time to travel a full 1.0 at a steady rate. A time of 0
/// follows at once. Stereo signals are followed channel by channel.
fn slew(x, rise: 0sec..60sec = 10ms, fall: 0sec..60sec = 100ms, shape: (smooth | linear) = smooth) {
  state _y = x * 0
  _x = x.max(-1000000).min(1000000)
  _diff = _x - _y
  _rising = (_diff * 1000000000).max(-1).min(1) * 0.5 + 0.5
  _time = fall.num.max(0).min(60) + (rise.num.max(0).min(60) - fall.num.max(0).min(60)) * _rising
  _samples = _time * sample_rate.num
  if shape == smooth {
    _y = _y + _diff * (1 - exp(0 - 1 / _samples.max(0.0001)))
  } else {
    _step = 1 / _samples.max(1)
    _y = _y + _diff.max(0 - _step).min(_step)
  }
  _y
}

/// A band-limited oscillator that morphs through four shapes: `shape` 0 is a sine, 1/3 a triangle, 2/3 a saw and 1 a
/// pulse, with the shapes in between blended. `width` is the pulse's duty cycle (5% to 95%). Outputs: sound
/// (within ±1.3: band-limited shapes overshoot a little, most near the top of the range) and sub, a sine an octave below. Frequencies are held to 45% of the sample rate.
fn morph_osc(freq: hz, shape: 0..1 = 0, width: 0.05..0.95 = 0.5) -> (sound, sub) {
  _freq = freq.max(0hz).min(sample_rate * 0.45)
  _width = width.max(0.05).min(0.95)
  _pulse = (osc(pulse, _freq, width: _width) - (2 * _width - 1)) / (1 + abs(2 * _width - 1))
  sound = scan_mix([osc(sine, _freq), osc(tri, _freq), osc(saw, _freq), _pulse], centre: shape.max(0).min(1))
  sub = osc(sine, _freq * 0.5)
}

/// Fold a signal back on itself: a waveshaper that turns a plain tone into a rich one. `amount` is how hard it is
/// pushed (0 leaves the signal alone, 1 folds it several times) and `symmetry` shifts the fold so even harmonics
/// appear. Two folds in a row, the second gentler, give the Buchla and Serge character. Folding makes harmonics
/// above the sample rate that alias; for a clean sound run it inside `oversample(4) { ... }`. Output stays within ±1.2.
fn wavefolder(x, amount: 0..1 = 0.3, symmetry: -1..1 = 0) {
  _x = x.max(-16).min(16)
  _amount = amount.max(0).min(1)
  _shift = symmetry.max(-1).min(1) * _amount
  _first = sin(1.570796 * (_x * (1 + 4 * _amount) + _shift))
  _second = sin(1.570796 * (_first * (1 + 2 * _amount) + _shift * 0.5))
  _x.crossfade(_second.dc_block, (_amount * 4).min(1)).clip(level: 1.2)
}

/// A low-frequency oscillator with four outputs a fixed phase apart, for motion that moves around a stereo or
/// surround space or drives several controls out of step. `rate` is in hz (for the tempo use
/// `1hz * clock.bpm / 60 / beats`). `shape` is where the peak falls in each cycle (a ramp at 0 or 1, a triangle at 0.5),
/// `smooth` rounds the corners towards a sine, and `shift` is the phase between neighbouring outputs in cycles:
/// 0.25 gives four quarter-turns, 0 gives four copies. Outputs run from -1 to 1.
fn multi_lfo(
  rate: 0.01hz..200hz = 1hz,
  shape: 0..1 = 0.5,
  smooth: 0..1 = 0.5,
  shift: 0..1 = 0.25
) -> (a, b, c, d) {
  _phase = phasor(rate.max(0.01hz).min(200hz))
  _rise = shape.max(0.02).min(0.98)
  _round = smooth.max(0).min(1)
  _shift = shift.max(0).min(1)
  _all = for i in 0..<4 {
    _p = (_phase + i * _shift).mod(1)
    _t = (_p / _rise).min((1 - _p) / (1 - _rise)).max(0).min(1)
    _t.crossfade(0.5 + 0.5 * sin(3.141593 * (_t - 0.5)), _round) * 2 - 1
  }
  a = _all[0]
  b = _all[1]
  c = _all[2]
  d = _all[3]
}

/// Three band-pass peaks that move together, the way the throat shapes a voice: put a sound through it and it
/// takes on vowels. `freq` is the lowest peak, `span` spreads the other two above it (0 close together, 1 far apart),
/// `res` narrows the peaks and `tilt` favours the low peak (-1) or the high one (1). Outputs: sound (the three mixed)
/// and low, mid and high, each peak on its own to send elsewhere. Stable for any setting; sound stays within ±2.
fn formant_filter(
  x,
  freq: 100hz..4khz = 600hz,
  span: 0..1 = 0.5,
  res: 0..1 = 0.6,
  tilt: -1..1 = 0
) -> (sound, low, mid, high) {
  _f1 = freq.max(100hz).min(4khz)
  _f2 = _f1 * (1.5 + span.max(0).min(1) * 2.5)
  _f3 = _f2 * (1.2 + span.max(0).min(1) * 0.8)
  _res = res.max(0).min(1)
  _gain = 1 / (0.5 + _res)
  low = x.multimode_filter(cutoff: _f1, res: _res).band * _gain
  mid = x.multimode_filter(cutoff: _f2, res: _res).band * _gain
  high = x.multimode_filter(cutoff: _f3, res: _res).band * _gain
  _tilt = tilt.max(-1).min(1)
  sound = (low * (1 - _tilt * 0.5) + mid * 0.7 + high * (0.5 + _tilt * 0.5)).clip(level: 2)
}

/// A random source for tunes and rhythms, in the manner of a stochastic sampler. Each rising edge of `clock` steps
/// through `length` stored draws. `deja_vu` is the chance of keeping each draw: 1 repeats the loop exactly, 0 makes every
/// step new, and in between it changes slowly. The draws are stored raw and shaped on the way out, so `spread` (how
/// far the values range, 0 to 1) and `bias` (where they centre, -1 to 1) can be moved while a loop plays. `steps` is
/// 1 for values held until the next step and lower for glides that take longer (0 slides across the whole step).
/// `density` is the share of steps that give a gate. The same `seed` gives the same run. Outputs: value (-1..1)
/// and gate, high while the clock is high on steps that have one. Quantize value before using it as pitch.
fn random_source(
  clock: num = 0,
  spread: 0..1 = 0.5,
  bias: -1..1 = 0,
  steps: 0..1 = 1,
  deja_vu: 0..1 = 0.5,
  density: 0..1 = 1,
  length: const int = 8,
  seed: const num = 0
) -> (value, gate) {
  state _draws = (0..<length).map(fract(sin((it + 1) * 12.9898 + seed * 78.233) * 43758.5453) * 2 - 1)
  state _chances = (0..<length).map(fract(sin((it + 1) * 78.233 + seed * 12.9898 + 5) * 43758.5453))
  state _step = 0
  state _previous = 0
  _new = noise(seed: seed)
  _new_chance = noise(seed: seed + 2) * 0.5 + 0.5
  _keep = noise(seed: seed + 1) * 0.5 + 0.5
  _high = if clock > 0 { 1 } else { 0 }
  if _high > 0 and _previous <= 0 {
    _step = (_step + 1).mod(length)
    if _keep > deja_vu.max(0).min(1) {
      _draws[_step] = _new
      _chances[_step] = _new_chance
    }
  }
  _previous = _high
  _bias = bias.max(-1).min(1)
  _held = (_bias + _draws[_step] * spread.max(0).min(1) * (1 - abs(_bias))).max(-1).min(1)
  state _out = 0
  _samples = (1 - steps.max(0).min(1)) * clock.beat_length.num * 0.9 * sample_rate.num
  _out = _out + (_held - _out) * (1 - exp(0 - 1 / _samples.max(0.0001)))
  value = _out
  gate = if _high > 0 and _chances[_step] <= density.max(0).min(1) { 1 } else { 0 }
}

/// One voice with five models, from a single set of controls, in the manner of a macro oscillator. `model` moves
/// through them: 0 analog (two detuned `morph_osc`), 0.25 FM (`complex_osc`), 0.5 additive (`harmonic_osc`), 0.75 a
/// vowel (a pulse through `formant_filter`) and 1 folded (`wavefolder` on a sine). Between two models it blends them.
/// `timbre`, `harmonics` and `morph` each do the most useful thing for the model: brightness, the number or spacing
/// of overtones, and the shape or position. The models are trimmed to about the same loudness, so `model` can be swept without jumps. Every model runs all the time, so it costs about five voices; use the
/// block you want directly when one sound is enough. Output stays within ±1.5.
fn multi_voice(
  freq: hz,
  model: 0..1 = 0,
  timbre: 0..1 = 0.5,
  harmonics: 0..1 = 0.5,
  morph: 0..1 = 0.5
) {
  _freq = freq.max(0hz).min(sample_rate * 0.45)
  _timbre = timbre.max(0).min(1)
  _harmonics = harmonics.max(0).min(1)
  _morph = morph.max(0).min(1)
  _analog = (morph_osc(_freq, shape: _morph).sound + morph_osc(_freq * (1.003 + _harmonics * 0.02), shape: _morph).sound) * 0.5
  _analog_open = _analog.multimode_filter(cutoff: _freq * (1.5 + _timbre * 30), res: 0.2).low
  _fm = complex_osc(_freq, ratio: 0.5 + _harmonics * 3.5, index: _timbre * 4, fold: _morph * 0.5).sound
  _additive = harmonic_osc(_freq, count: 12, brightness: _timbre, odd_even: _harmonics * 2 - 1, centre: _morph, width: 3, focus: 0.5)
  _vowel = morph_osc(_freq, shape: 1, width: 0.3).sound.formant_filter(freq: 250hz + _morph * 750hz, span: _harmonics, res: _timbre * 0.8).sound * 0.5
  _folded = wavefolder(osc(sine, _freq), amount: _timbre, symmetry: _morph * 2 - 1) * (1 - _harmonics * 0.5) + osc(sine, _freq * 2) * _harmonics * 0.3
  scan_mix([_analog_open * 3, _fm * 0.75, _additive * 1.3, _vowel * 2, _folded * 0.75], centre: model.max(0).min(1)).clip(level: 1.5)
}

/// Follows `x` while `gate` is high and freezes its last value when `gate` goes low, like a track-and-hold. Where
/// `sample_hold` takes one value per trigger, this follows a signal through the open part of a gate: a held pitch
/// that glides while a key is down. Values are held to ±1000, and a gate that is not above 0.5 holds.
fn track_hold(x, gate) {
  state _held = x * 0
  _held = if gate > 0.5 { x.max(-1000).min(1000) } else { _held }
  _held
}

/// Turns any signal into a gate, with a margin so a noisy signal doesn't chatter. `gate` goes to 1 when `x` rises
/// above `threshold` plus half of `hysteresis` and back to 0 when it falls below `threshold` minus half of it;
/// between those it keeps its last value. `inverted` is the opposite. `hysteresis` is in the units of `x`.
fn comparator(x, threshold = 0, hysteresis = 0.05) -> (gate, inverted) {
  state _on = x * 0
  _x = x.max(-1000).min(1000)
  _margin = hysteresis.max(0).min(1000) * 0.5
  _on = if _x > threshold + _margin { 1 } else { if _x < threshold - _margin { 0 } else { _on } }
  gate = _on
  inverted = 1 - _on
}

/// A lumpy, never-repeating modulation source from the Lorenz system. `rate` is roughly how many times a second it
/// swings round, and `chaos` (0 to 1) takes it from a settled loop to the full tangle. `x`, `y` and `z` are three
/// related views of the same motion, each held to ±1; `x` and `y` flip between two lobes at odd moments, `z` stays
/// positive-ish. It is bounded whatever the controls do.
fn chaos(rate: 0.01hz..200hz = 1hz, chaos: 0..1 = 0.8) -> (x, y, z) {
  state _px = 1
  state _py = 1
  state _pz = 1
  _dt = rate.max(0.01hz).min(200hz).num * 0.65 / sample_rate.num
  _rho = 20 + chaos.max(0).min(1) * 20
  _nx = _px + _dt * 10 * (_py - _px)
  _ny = _py + _dt * (_px * (_rho - _pz) - _py)
  _nz = _pz + _dt * (_px * _py - 8 / 3 * _pz)
  _px = _nx.max(-100).min(100)
  _py = _ny.max(-100).min(100)
  _pz = _nz.max(-100).min(100)
  x = (_px / 20).max(-1).min(1)
  y = (_py / 28).max(-1).min(1)
  z = ((_pz - 25) / 25).max(-1).min(1)
}

/// An eight-step shift register clocked by one signal and fed by another, after a classic self-playing patch. Each
/// rising edge of `clock` (the signal crossing zero upwards) shifts the register along one place and brings in a new
/// bit: whether `data` is positive, flipped when the bit coming out the end was a one. Feed it two oscillators at
/// unrelated speeds and the pattern wanders, then nearly repeats. `value` (0 to 1) is the last three bits read as a
/// number, steppy and good for pitch through `quantize`; `gate` pulses at each clock edge.
fn rungler(data, clock) -> (value, gate) {
  state _reg = 0
  state _previous = 0
  _high = if clock.sum > 0 { 1 } else { 0 }
  _edge = if _high > 0 and _previous <= 0 { 1 } else { 0 }
  _out = floor(_reg / 128)
  _bit = abs((if data.sum > 0 { 1 } else { 0 }) - _out)
  _reg = if _edge > 0 { (_reg * 2 - _out * 256) + _bit } else { _reg }
  _previous = _high
  _b0 = _reg - floor(_reg / 2) * 2
  _b1 = floor(_reg / 2) - floor(_reg / 4) * 2
  _b2 = floor(_reg / 4) - floor(_reg / 8) * 2
  value = (_b0 * 4 + _b1 * 2 + _b2) / 7
  gate = _edge
}

/// Rings a sound like a struck object, with eight tuned modes at once. Any sound can excite it: percussion hits and noise
/// become bars, strings and bells. `freq` is the pitch of the lowest mode. `structure` moves the overtones from a
/// string (0, whole-number overtones) through a bar (0.5) to a bell (1). `decay` is how long the lowest mode rings,
/// `damping` makes the higher ones die faster, and `brightness` lowers their level. `spread` detunes the modes against
/// each other. `mix` blends from the dry sound to the ringing one. A sound that matches a mode's pitch is boosted a lot, so the ringing is softly limited below ±1. Stereo inputs are mixed to mono and held to ±16.
fn resonant_body(
  x,
  freq: 20hz..4khz = 220hz,
  structure: 0..1 = 0.5,
  decay: 20ms..8sec = 1sec,
  damping: 0..1 = 0.5,
  brightness: 0..1 = 0.5,
  spread: 0..1 = 0,
  mix: 0..1 = 1
) {
  _string = [1, 2, 3, 4, 5, 6, 7, 8]
  _bar = [1, 2.756, 5.404, 8.933, 13.344, 18.64, 24.82, 31.88]
  _bell = [1, 2.32, 2.9, 3.7, 4.8, 6.1, 7.6, 9.2]
  _s = structure.max(0).min(1)
  _w1 = (1 - _s * 2).max(0)
  _w2 = 1 - abs(_s * 2 - 1)
  _w3 = (_s * 2 - 1).max(0)
  _ratios = _string * _w1 + _bar * _w2 + _bell * _w3
  _in = x.sum.max(-16).min(16)
  _pitch = freq.max(20hz).min(4khz)
  _freqs = (0..<8).map((_pitch * _ratios[it] * (1 + spread.max(0).min(1) * 0.01 * (it * 0.37 - floor(it * 0.37) - 0.5))).max(20hz).min(sample_rate * 0.45))
  _life = (0..<8).map(decay.max(20ms).min(8sec) * pow(1 - damping.max(0).min(1) * 0.9, it * 0.5))
  _level = (0..<8).map(pow(0.3 + brightness.max(0).min(1) * 0.7, it))
  _wet = (_in.resonator(_freqs, decay: _life) * _level).sum * 4
  _in.crossfade(_wet.tanh, mix.max(0).min(1))
}

/// Echoes that climb in pitch (or fall) with every repeat, in the way of a pitch-cascading echo. Four repeats come
/// `time` apart, each `shift` semitones further from the original than the one before (held to ±24 in total), each
/// `feedback` quieter. The repeats are alternately left and right and nothing feeds back, so it can't run away.
/// Returns only the repeats; the input is held to ±16. `window` sets the pitch-shifter's grain, as for `pitch_shift`.
fn shimmer_echo(
  x,
  time: sec = 3/16 * clock.beat_length,
  shift: -12..12 = 12,
  feedback: 0..1 = 0.6,
  window: 10ms..100ms = 40ms,
  max: const sec = 4sec
) {
  _mono = (x.sum / x.channels.len).max(-16).min(16)
  _t = time.max(1ms).min(max / 4)
  _s = shift.max(-12).min(12)
  _taps = _mono.delay([_t, _t * 2, _t * 3, _t * 4], max: max)
  _shifted = _taps.pitch_shift(shift: [_s, _s * 2, _s * 3, _s * 4].map(it.max(-24).min(24)), window: window.max(10ms).min(100ms))
  _f = feedback.max(0).min(1)
  _levels = [_f, _f * _f, _f * _f * _f, _f * _f * _f * _f]
  _heard = _shifted * _levels
  [_heard[0] + _heard[2], _heard[1] + _heard[3]]
}

fn _hilbert_stage(x, a) {
  x.biquad(a * a, 0, -1, 0, 0 - a * a)
}

/// Moves every frequency in a sound up or down by the same number of hertz, which breaks the overtones' whole-number
/// relationships and gives metallic, bell-like or underwater sounds. It is not a pitch shift: a 220 hz tone shifted by
/// 100 hz is 320 hz, and its second overtone goes from 440 hz to 540 hz. `up` is the sound shifted by `shift`, `down`
/// by the same amount the other way, so one of them is always there for a stereo spread. Stereo inputs are mixed to
/// mono and held to ±16. Accurate from about 100 hz to 18 khz.
fn freq_shifter(x, shift: -2khz..2khz = 100hz) -> (up, down) {
  _x = x.sum.max(-16).min(16)
  _i = _x._hilbert_stage(0.6923878)._hilbert_stage(0.9360654322959)._hilbert_stage(0.9882295226860)._hilbert_stage(0.9987488452737).delay(1sec / sample_rate.num, max: 1ms)
  _q = _x._hilbert_stage(0.4021921162426)._hilbert_stage(0.8561710882420)._hilbert_stage(0.9722909545651)._hilbert_stage(0.9952884791278)
  _hz = shift.num.max(-2000).min(2000)
  _phase = phasor(abs(_hz) * 1hz) * 2 * pi
  _sin = sin(_phase)
  _cos = cos(_phase)
  up = (_i * _cos + _q * _sin * sign(_hz)).clip(level: 1.5)
  down = (_i * _cos - _q * _sin * sign(_hz)).clip(level: 1.5)
}

/// A mixer of any number of inputs, each with its own level, so each can be driven by its own control. `inputs` and
/// `levels` are lists of the same length. Levels run from 0 to 1 and are shaped by `curve`: `linear` is the plain
/// level, `exponential` squares it, so the bottom of the range is quiet and finely controlled, as on a voltage-controlled
/// amplifier. `master` scales the sum. Levels outside 0 to 1 are held to that range, and each input to ±1000.
fn vca_mix(inputs: [num], levels: [num], curve: (linear | exponential) = linear, master: 0..1 = 1) {
  _l = levels.map(it.max(0).min(1))
  _shaped = if curve == exponential { _l * _l } else { _l }
  (inputs.map(it.max(-1000).min(1000)) * _shaped).sum * master.max(0).min(1)
}

/// Multiplies a clock: every rising edge of `clock` passes, and `factor` evenly spaced edges are added inside each
/// period, so a clock at 2 hz with a factor of 4 gives 8 pulses a second. `swing` (0 to 0.5) pushes every second pulse
/// late by that share of a step. The period is measured from the clock itself, so nothing comes out until two edges
/// have arrived, and it follows a clock that speeds up or slows down a period late. Pulses last one sample.
/// `factor` is held to 1 to 16 and rounded down.
fn clock_mult(clock, factor: 1..16 = 2, swing: 0..0.5 = 0) {
  state _since = 0
  state _period = 0
  state _previous = 0
  state _next = 1
  _high = if clock.sum > 0.5 { 1 } else { 0 }
  _edge = if _high > 0 and _previous <= 0 { 1 } else { 0 }
  _previous = _high
  _count = factor.max(1).min(16).floor
  _step = _period / _count
  _odd = _next - floor(_next / 2) * 2
  _due = _next * _step + _odd * swing.max(0).min(0.5) * _step
  _fire = if _edge > 0 { 1 } else { if _period > 0 and _next < _count and _since >= _due { 1 } else { 0 } }
  _measured = _since + 1
  _period = if _edge > 0 and _since > 0 { _measured } else { _period }
  _since = if _edge > 0 { 0 } else { (_since + 1).min(10000000) }
  _next = if _edge > 0 { 1 } else { if _fire > 0 { _next + 1 } else { _next } }
  _fire
}

/// Sends each trigger to one of two outputs by a coin flip: `a` with chance `probability`, otherwise `b`. A gate keeps
/// going to the output it was sent to for as long as it stays high, so it works on gates as well as triggers. Using only
/// `a` gives a probability gate. The same `seed` gives the same run of choices.
fn bernoulli(trigger, probability: 0..1 = 0.5, seed: const num = 0) -> (a, b) {
  state _previous = 0
  state _route = 0
  _high = if trigger.sum > 0.5 { 1 } else { 0 }
  _edge = if _high > 0 and _previous <= 0 { 1 } else { 0 }
  _previous = _high
  _draw = noise(seed: seed) * 0.5 + 0.5
  _route = if _edge > 0 { if _draw < probability.max(0).min(1) { 1 } else { 0 } } else { _route }
  a = _high * _route
  b = _high * (1 - _route)
}

/// A burst of pulses from each trigger, like a ratchet: `count` pulses (the first lands with the trigger), `rate` a
/// second, one sample long. `count` is held to 1 to 16, `rate` to 1 hz to 2 khz, and a new trigger starts the burst
/// again. `accelerate` (-0.5 to 0.5) makes each gap that much shorter (positive) or longer (negative) than the one before.
fn burst(trigger, count: 1..16 = 4, rate: 1hz..2khz = 20hz, accelerate: -0.5..0.5 = 0) {
  state _previous = 0
  state _left = 0
  state _wait = 0
  state _gap = 0
  _high = if trigger.sum > 0.5 { 1 } else { 0 }
  _edge = if _high > 0 and _previous <= 0 { 1 } else { 0 }
  _previous = _high
  _first = (sample_rate.num / rate.num.max(1).min(2000)).max(2)
  _due = if _edge <= 0 and _left > 0 and _wait <= 1 { 1 } else { 0 }
  _gap = if _edge > 0 { _first } else { if _due > 0 { (_gap * (1 - accelerate.max(-0.5).min(0.5))).max(2).min(sample_rate.num) } else { _gap } }
  _left = if _edge > 0 { count.max(1).min(16).floor - 1 } else { if _due > 0 { _left - 1 } else { _left } }
  _wait = if _edge > 0 or _due > 0 { _gap } else { _wait - 1 }
  if _edge > 0 or _due > 0 { 1 } else { 0 }
}

/// Stretches a trigger into a gate of `length`, so a one-sample pulse can open an envelope or a gate for a set time. A
/// new trigger while it is open starts the length again. `length` is held to 0 to 10 seconds.
fn gate_length(trigger, length: 0sec..10sec = 100ms) {
  state _previous = 0
  state _left = 0
  _high = if trigger.sum > 0.5 { 1 } else { 0 }
  _edge = if _high > 0 and _previous <= 0 { 1 } else { 0 }
  _previous = _high
  _left = if _edge > 0 { length.max(0sec).min(10sec).num * sample_rate.num } else { (_left - 1).max(0) }
  if _left > 0 { 1 } else { 0 }
}

/// A gate or trigger arriving `time` later. `time` is held to 0 to `max`, and the gate to ±1000.
fn gate_delay(gate, time: sec = 50ms, max: const sec = 2sec) {
  gate.sum.max(-1000).min(1000).delay(time.max(0sec).min(max), max: max)
}

/// Combines two gates: `and` (both high), `or` (either), `xor` (exactly one), and the inverted `nand`, `nor` and `xnor`. A
/// signal counts as high above 0.5. The result is 1 or 0.
fn gate_logic(a, b, mode: (and | or | xor | nand | nor | xnor) = and) {
  _a = if a.sum > 0.5 { 1 } else { 0 }
  _b = if b.sum > 0.5 { 1 } else { 0 }
  _and = _a * _b
  _or = (_a + _b).min(1)
  _xor = abs(_a - _b)
  if mode == and { _and } else { if mode == or { _or } else { if mode == xor { _xor } else { if mode == nand { 1 - _and } else { if mode == nor { 1 - _or } else { 1 - _xor } } } } }
}

/// Changes state on every rising edge of `trigger`: `q` goes 1, 0, 1, 0, so a clock becomes a clock at half the speed,
/// and `not_q` is the opposite. A high `reset` holds `q` at 0.
fn flip_flop(trigger, reset = 0) -> (q, not_q) {
  state _previous = 0
  state _state = 0
  _high = if trigger.sum > 0.5 { 1 } else { 0 }
  _edge = if _high > 0 and _previous <= 0 { 1 } else { 0 }
  _previous = _high
  _state = if reset.sum > 0.5 { 0 } else { if _edge > 0 { 1 - _state } else { _state } }
  q = _state
  not_q = 1 - _state
}

/// Whether `x` is between `low` and `high` (`inside`) or not (`outside`), as 1 or 0. The two limits can be given in
/// either order.
fn window_comparator(x, low = -0.5, high = 0.5) -> (inside, outside) {
  _x = x.max(-1000).min(1000)
  _lo = low.max(-1000).min(1000)
  _hi = high.max(-1000).min(1000)
  inside = if _x >= _lo.min(_hi) and _x <= _lo.max(_hi) { 1 } else { 0 }
  outside = 1 - inside
}

/// Picks one of `inputs` by `index`, rounded down and held to the first and last. An input that is not chosen is not
/// heard. The result is held to ±1000. For a smooth crossfade use `scan_mix`.
fn mux(inputs: [num], index) {
  inputs[index.max(0).min(inputs.len - 1).floor].max(-1000).min(1000)
}

/// A sequential switch: each rising edge of `clock` moves to the next of `inputs`, and after the last it goes back to
/// the first. A high `reset` returns to the first. `value` is the chosen input (held to ±1000) and `step` the step number from 0.
fn stepper(inputs: [num], clock, reset = 0) -> (value, step) {
  state _previous = 0
  state _step = 0
  _high = if clock.sum > 0.5 { 1 } else { 0 }
  _edge = if _high > 0 and _previous <= 0 { 1 } else { 0 }
  _previous = _high
  _count = inputs.len
  _step = if reset.sum > 0.5 { 0 } else { if _edge > 0 { (_step + 1) - floor((_step + 1) / _count) * _count } else { _step } }
  value = inputs[_step].max(-1000).min(1000)
  step = _step
}

/// An oscillator that restarts its own waveform each time a master oscillator at `freq` completes a cycle. `ratio` is the
/// speed of the restarting oscillator compared with the master: a whole number gives a plain tone, and sweeping it gives
/// the sharp, tearing sound of hard sync. `shape` moves from a saw (0) to a pulse of `width` (1). The master's pitch is
/// what you hear; `ratio` changes the colour. Within ±1.3.
fn sync_osc(freq: hz, ratio: 0.5..16 = 2, shape: 0..1 = 0, width: 0.05..0.95 = 0.5) {
  _freq = freq.max(0hz).min(sample_rate * 0.45)
  _reset = impulse(_freq)
  _speed = _freq * ratio.max(0.5).min(16)
  _saw = reset_on(_reset) { osc(saw, _speed.min(sample_rate * 0.45)) }
  _pulse = reset_on(_reset) { osc(pulse, _speed.min(sample_rate * 0.45), width: width.max(0.05).min(0.95)) }
  _saw.crossfade(_pulse, shape.max(0).min(1)).dc_block.clip(level: 1.3)
}

/// A row sequencer in the style of a hardware step sequencer with rows that hold a value, a length and a repeat count.
/// Each rising edge of `clock` is one tick. Row `n` gives `values[n]` (held between rows), `extras[n]` (a second value, for
/// a velocity or a filter), `durations[n]` (how many ticks the row lasts), `repeats[n]` (how many times it plays before the
/// next row) and `modes[n]`, which decides the gate: 0 rest (no gate), 1 gate (open for `gate_length` of the row's
/// duration), 2 trigger (one sample at the start of every repeat), 3 hold (open for the whole row, and into the next if
/// that is a gate or a hold, so the notes tie). Lists shorter than `values` repeat their last entry, so a single
/// `durations: [2]` gives every row two ticks.
/// `start` and `length` pick the rows that loop (row 0 is the first). A high `reset` puts the sequence back at `start`;
/// the next tick plays that row again. Nothing plays before the first tick. `value` and `extra` are held to ±1000.
/// `row` is the row now playing, and `wrap` is a one-sample pulse when the loop starts over. Durations and repeats are
/// held to 1 to 256, `gate_length` to 0 to 1 and `modes` to 0 to 3.
/// The gate length is measured against the clock, so the first row after a reset gates until the second tick.
fn row_sequencer(
  clock,
  reset = 0,
  values: [num],
  extras: [num] = [0],
  durations: [num] = [1],
  repeats: [num] = [1],
  modes: [num] = [1],
  start: 0..63 = 0,
  length: 1..64 = 64,
  gate_length: 0..1 = 0.5
) -> (value, extra, gate, row, wrap) {
  state _previous = 0
  state _fresh = 1
  state _pos = 0
  state _rep = 0
  state _tick = 0
  state _since = 0
  state _period = 0
  state _elapsed = 0
  _high = if clock.sum > 0.5 { 1 } else { 0 }
  _edge = if _high > 0 and _previous <= 0 { 1 } else { 0 }
  _previous = _high
  _held = if reset.sum > 0.5 { 1 } else { 0 }
  _rows = values.len
  _s = start.max(0).min(_rows - 1).floor
  _n = length.max(1).min(_rows - _s).floor
  _period = if _edge > 0 and _since > 0 { _since + 1 } else { _period }
  _since = if _edge > 0 { 0 } else { (_since + 1).min(10000000) }
  _was = _s + _pos.min(_n - 1)
  _dur = durations[_was.min(durations.len - 1)].max(1).min(256).floor
  _reps = repeats[_was.min(repeats.len - 1)].max(1).min(256).floor
  _tick_done = if _edge > 0 and _fresh <= 0 and _tick + 1 >= _dur { 1 } else { 0 }
  _row_done = if _tick_done > 0 and _rep + 1 >= _reps { 1 } else { 0 }
  _last = if _pos >= _n - 1 { 1 } else { 0 }
  _begin = if _held <= 0 and _edge > 0 and (_fresh > 0 or _tick_done > 0) { 1 } else { 0 }
  _wrapped = if _held <= 0 and _row_done > 0 and _last > 0 { 1 } else { 0 }
  _pos = if _held > 0 { 0 } else { if _row_done > 0 { if _last > 0 { 0 } else { _pos + 1 } } else { _pos } }
  _rep = if _held > 0 { 0 } else { if _row_done > 0 { 0 } else { if _tick_done > 0 { _rep + 1 } else { _rep } } }
  _tick = if _held > 0 { 0 } else { if _tick_done > 0 { 0 } else { if _edge > 0 and _fresh <= 0 { _tick + 1 } else { _tick } } }
  _fresh = if _held > 0 { 1 } else { if _edge > 0 { 0 } else { _fresh } }
  _elapsed = if _begin > 0 { 0 } else { (_elapsed + 1).min(10000000) }
  _row = _s + _pos.min(_n - 1)
  _now = durations[_row.min(durations.len - 1)].max(1).min(256).floor
  _mode = modes[_row.min(modes.len - 1)].max(0).min(3).floor
  _open = if _period > 0 { if _elapsed < gate_length.max(0).min(1) * _now * _period { 1 } else { 0 } } else { 1 }
  _tie = if _mode == 3 { 1 } else { 0 }
  _gate = if _fresh > 0 { 0 } else { if _mode == 1 { _open } else { if _mode == 2 { if _elapsed < 1 { 1 } else { 0 } } else { _tie } } }
  value = values[_row].max(-1000).min(1000)
  extra = extras[_row.min(extras.len - 1)].max(-1000).min(1000)
  gate = _gate
  row = _row
  wrap = _wrapped
}

/// Holds the last `length` of the input and replays it, for the "freeze" and "reverse" of a delay line. Normally the input
/// passes straight through. With `reverse` high (above 0.5) the input is played back backwards in windows of `length`: each
/// window starts from the present and plays the last `length` of the sound in reverse, then jumps to the present again. With
/// `freeze` high the sound stops being recorded and the last `length` of it loops forward until `freeze` goes low again;
/// a freeze wins over a reverse. Each change fades over 5 ms and the loop joins are crossfaded, so there are no clicks.
/// `size` is the memory in samples (about 8 seconds at 48 khz by default); `length` can be up to half of it, and is held to
/// at least 1 ms. The input is held to ±16.
fn freeze_reverse(x, length: sec = 250ms, reverse: 0..1 = 0, freeze: 0..1 = 0, size: const int = 384000) {
  state _buf = zeros(size)
  state _w = 0
  state _phase = 0
  state _anchor = 0
  state _have = 0
  state _fade = 0
  _in = x.sum.max(-16).min(16)
  _len = (length.max(1ms).num * sample_rate.num).floor.max(2).min(size / 2 - 2)
  _f = (0.005 * sample_rate.num).floor.max(2)
  _want = if freeze > 0.5 { 2 } else { if reverse > 0.5 { 1 } else { 0 } }
  _switch = if _want != _have and _fade <= 0 { 1 } else { 0 }
  _have = if _switch > 0 { _want } else { _have }
  _anchor = if _switch > 0 or _phase >= _len { _w } else { _anchor }
  _phase = if _switch > 0 or _phase >= _len { 0 } else { _phase + 1 }
  _target = if _want == _have and _have > 0 { 1 } else { 0 }
  _fade = if _target > 0 { (_fade + 1 / _f).min(1) } else { (_fade - 1 / _f).max(0) }
  _buf[_w] = if _have == 2 { _buf[_w] } else { _in }
  _w = if _have == 2 { _w } else { if _w + 1 >= size { 0 } else { _w + 1 } }
  _edge = (_phase.min(_len - 1 - _phase) / _f).max(0).min(1)
  _backwards = _buf.at(_anchor - 1 - _phase) * _edge
  _join = ((_phase - (_len - _f)) / _f).max(0).min(1)
  _forwards = _buf.at(_anchor - _len + _phase) * (1 - _join) + _buf.at(_anchor - 2 * _len + _phase) * _join
  _wet = if _have == 2 { _forwards } else { _backwards }
  _in * (1 - _fade) + _wet * _fade
}

const _tap_random = [0.37, -0.22, 0.05, 0.41, -0.38, 0.18, -0.07, 0.33, -0.44, 0.09, 0.28, -0.15, 0.4, -0.3, 0.02, -0.26]

/// Where tap `i` (from 0) sits, in samples: `base` times its place on the grid (`curve` bends the spacing, `mode` is the
/// groove: 0 straight, 1 swing, 2 hard swing, 3 reverse swing, 4 random, by `amount`), plus `wobble`, held to 1 to `cap`.
fn _tap_time(i, base, curve, amount, mode, wobble, cap) {
  _odd = i - floor(i / 2) * 2
  _off = if mode == 1 { _odd / 3 } else { if mode == 2 { _odd / 2 } else { if mode == 3 { (_odd - 1) / 3 } else { if mode == 4 { _tap_random[i.min(15)] } else { 0 } } } }
  (base * (pow(i + 1, curve) + amount * _off) + wobble).max(1).min(cap)
}

/// A multi-tap delay with a pitch, a level and a filter for every tap, in the way of a rhythmic pitch-shifting delay.
/// `taps` repeats (1 to 16) come after the input, the first `time` later. Returns `left` and `right`.
/// Timing: `curve` spaces the taps: 1 is evenly, below 1 they bunch up towards the end (a ball bouncing to rest), above 1
/// they spread out. `groove` moves taps off the even grid by `groove_amount` (0 to 1): `swing` and `hard_swing` push every
/// second tap late, `reverse_swing` pulls the first of each pair early, `random` shifts each tap by its own fixed amount.
/// `wobble` (0 to 1, up to 10 ms) moves every tap time with a sine at `wobble_rate`, for chorus and tape flutter.
/// Each tap: `shifts[n]` semitones from the original (a short list repeats its last entry) plus `step` for every tap so
/// far, each held to ±24, so `shifts: [0]` with `step: 7` climbs in fifths; `levels[n]` (0 to 4, so 0 mutes it) times
/// `decay` for every tap so far; and with `filter` set to `lowpass`, `bandpass` or `highpass`, a filter at `cutoffs[n]`
/// with `resonance` (0 to 1). `spread` sends the first tap left, the second right, and so on (0 keeps every tap in the
/// middle). `window` is the grain of the pitch shifters.
/// Feedback: `feedback` (0 to 0.95) feeds tap `feedback_tap` (1 to 16; 0 is the last) back into the input, through its
/// own pitch shift (`feedback_shift`) and a tone control (`feedback_tone`: below 0 darkens, above 0 thins). A soft clip
/// keeps it from running away.
/// `reverse` (above 0.5) plays the input into the taps backwards, in windows as long as the feedback tap's time, and
/// `freeze` (above 0.5) stops recording and loops the last such window while the taps and feedback carry on, so echoes
/// build on the frozen sound; see `freeze_reverse`.
/// `size` is the memory in samples: it holds up to about `size` of delay (4 seconds at 48 khz by default), and the
/// reverse and freeze window can be up to half of it. The output is held to ±4 and the input to ±16.
fn tap_delay(
  x,
  time: sec = 1/8 * clock.beat_length,
  taps: const int = 8,
  shifts: [num] = [0],
  step: -12..12 = 0,
  levels: [num] = [1],
  decay: 0..1 = 0.8,
  curve: 0.5..2 = 1,
  groove: (straight | swing | hard_swing | reverse_swing | random) = straight,
  groove_amount: 0..1 = 1,
  wobble: 0..1 = 0,
  wobble_rate: 0.05hz..10hz = 0.5hz,
  spread: 0..1 = 1,
  filter: (off | lowpass | bandpass | highpass) = off,
  cutoffs: [hz] = [2khz],
  resonance: 0..1 = 0.3,
  feedback: 0..0.95 = 0,
  feedback_tap: 0..16 = 0,
  feedback_shift: -12..12 = 0,
  feedback_tone: -1..1 = 0,
  reverse: 0..1 = 0,
  freeze: 0..1 = 0,
  window: 10ms..100ms = 40ms,
  size: const int = 192000
) -> (left, right) {
  state _buf = zeros(size)
  state _w = 0
  state _gp = 0
  state _swirl = 0
  state _fb = 0
  state _ic1 = zeros(taps)
  state _ic2 = zeros(taps)
  state _tone_low = 0
  state _tone_high = 0
  _sr = sample_rate.num
  _g = (window.max(10ms).min(100ms).num * _sr).floor
  _gp = if _gp + 1 >= _g { 0 } else { _gp + 1 }
  _swirl = fract(_swirl + wobble_rate.max(0.05hz).min(10hz).num / _sr)
  _wob = sin(2 * pi * _swirl) * wobble.max(0).min(1) * 0.01 * _sr
  _base = (time.max(1ms).num * _sr).min(size)
  _cap = size - 8 - 3 * _g
  _curve = curve.max(0.5).min(2)
  _amount = groove_amount.max(0).min(1)
  _mode = if groove == swing { 1 } else { if groove == hard_swing { 2 } else { if groove == reverse_swing { 3 } else { if groove == random { 4 } else { 0 } } } }
  _fbi = (if feedback_tap > 0.5 { feedback_tap } else { taps }).max(1).min(taps).floor - 1
  _ftime = _tap_time(_fbi, _base, _curve, _amount, _mode, _wob, _cap)
  _in = freeze_reverse(x.sum.max(-16).min(16) + _fb * feedback.max(0).min(0.95), length: _ftime / _sr * 1sec, reverse: reverse, freeze: freeze, size: size)
  _buf[_w] = _in
  _w = if _w + 1 >= size { 0 } else { _w + 1 }
  _step = step.max(-12).min(12)
  _decay = decay.max(0).min(1)
  _spread = spread.max(0).min(1)
  _res = resonance.max(0).min(1)
  _k = 1 / (0.5 + _res * _res * 15)
  _state_left = 0
  _state_right = 0
  _gain = 1
  for _i in 0..<taps {
    _gain = _gain * _decay
    _d = _tap_time(_i, _base, _curve, _amount, _mode, _wob, _cap)
    _r = pow(2, (shifts[_i.min(shifts.len - 1)] + (_i + 1) * _step).max(-24).min(24) / 12)
    _hold = (_r - 1).max(0) * _g
    _shifted_phase = _gp + floor(_i * _g / taps)
    _pa = if _shifted_phase >= _g { _shifted_phase - _g } else { _shifted_phase }
    _pb = if _pa + _g / 2 >= _g { _pa - _g / 2 } else { _pa + _g / 2 }
    _ga = 1 - abs(2 * _pa / _g - 1)
    _y = _buf.at(_w - 1 - _d - _hold - (1 - _r) * _pa, interp: linear) * _ga + _buf.at(_w - 1 - _d - _hold - (1 - _r) * _pb, interp: linear) * (1 - _ga)
    _gf = tan(pi * cutoffs[_i.min(cutoffs.len - 1)].max(20hz).min(sample_rate * 0.45).num / _sr)
    _a1 = 1 / (1 + _gf * (_gf + _k))
    _a2 = _gf * _a1
    _v3 = _y - _ic2[_i]
    _v1 = _a1 * _ic1[_i] + _a2 * _v3
    _v2 = _ic2[_i] + _a2 * _ic1[_i] + _gf * _a2 * _v3
    _ic1[_i] = (2 * _v1 - _ic1[_i]).max(-100).min(100)
    _ic2[_i] = (2 * _v2 - _ic2[_i]).max(-100).min(100)
    _out = if filter == lowpass { _v2 } else { if filter == bandpass { _v1 * _k } else { if filter == highpass { _y - _k * _v1 - _v2 } else { _y } } }
    _heard = _out * _gain * levels[_i.min(levels.len - 1)].max(0).min(4)
    _side = _i - floor(_i / 2) * 2
    _state_left = _state_left + _heard * (1 - _side * _spread)
    _state_right = _state_right + _heard * (1 - (1 - _side) * _spread)
  }
  _rf = pow(2, feedback_shift.max(-12).min(12) / 12)
  _hf = (_rf - 1).max(0) * _g
  _fa = if _gp + 1 >= _g { 0 } else { _gp }
  _fb2 = if _fa + _g / 2 >= _g { _fa - _g / 2 } else { _fa + _g / 2 }
  _fw = 1 - abs(2 * _fa / _g - 1)
  _fy = _buf.at(_w - 1 - _ftime - _hf - (1 - _rf) * _fa, interp: linear) * _fw + _buf.at(_w - 1 - _ftime - _hf - (1 - _rf) * _fb2, interp: linear) * (1 - _fw)
  _tone = feedback_tone.max(-1).min(1)
  _lp = exp(-2 * pi * 20000 * pow(0.01, (0 - _tone).max(0)) / _sr)
  _hp = exp(-2 * pi * 20 * pow(500, _tone.max(0)) / _sr)
  _tone_low = _fy * (1 - _lp) + _tone_low * _lp
  _tone_high = _fy * (1 - _hp) + _tone_high * _hp
  _fb = ((if _tone > 0 { _fy - _tone_high } else { _tone_low }) * 0.25).tanh * 4
  left = (_state_left * 0.25).tanh * 4
  right = (_state_right * 0.25).tanh * 4
}

/// A sampler that records into a reel, divides the recording into splices, and plays one splice back as grains (small
/// windows of it). Returns `left` and `right` (the playback),
/// `grain_end` (a 1 ms gate at the end of each grain), `level` (0 to 1, how loud the playback is), `splice` (the splice now
/// playing, from 0) and `count` (how many splices the reel has).
/// Recording: while `record` is high (above 0.5) the input `x` is recorded (stereo is summed to mono). If the reel is empty,
/// or `new_splice` is high when recording starts, it goes into a new splice at the end of the reel; otherwise it
/// records over the splice now playing, round and round for as long as `record` stays high. What is written is `x`
/// with `1 - sos` and the playback with `sos`, so `sos` 0 records only the input, and above 0 layers on top of what is there.
/// Recording and playback are independent, so what you hear while recording (speed, direction, grains) is what is recorded.
/// Splices: `choose` (0 to 1) picks one evenly across the reel, a high `shift` moves to the next, `mark` drops a splice
/// marker at the playback position, `unmark` joins the splice with the next, and `clear` empties the reel. Each is a gate:
/// it acts on the rising edge.
/// Playback: `speed` (-4 to 4, times normal speed) sets speed and direction, 0 stops it, and `play` (high is on; a rising edge
/// starts again from the start) lets the splice loop while high and stop at its end when low. `grain_size` (0 to 1) shrinks the
/// window from the whole splice down to 2 ms, and `slide` (0 to 1) moves where in the splice it starts, wrapping round.
/// `morph` (0 to 1) shapes the grains: below 0.33 there are gaps between them, 0.33 loops them seamlessly, and above it they
/// overlap, up to four at once, with random panning from 0.5 and random pitch-up above 0.8.
/// `clock` (a gate) steps the window through the splice one grain at each tick when `morph` is 0.45 or below, and above that
/// it time-stretches: the splice is played through once per tick whatever `speed` is, which changes only the pitch.
/// `size` is the reel in samples (20 seconds at 48 khz by default), and `splices` how many it can hold.
fn splice_reel(
  x,
  record: 0..1 = 0,
  new_splice: 0..1 = 0,
  sos: 0..1 = 0,
  choose: 0..1 = 0,
  shift: 0..1 = 0,
  mark: 0..1 = 0,
  unmark: 0..1 = 0,
  clear: 0..1 = 0,
  play: 0..1 = 1,
  speed: -4..4 = 1,
  grain_size: 0..1 = 0,
  slide: 0..1 = 0,
  morph: 0..1 = 0.33,
  clock: 0..1 = 0,
  size: const int = 960000,
  splices: const int = 32
) -> (left, right, grain_end, level, splice, count) {
  state _buf = zeros(size)
  state _edges = zeros(splices + 1)
  state _n = 0
  state _end = 0
  state _sel = 0
  state _shift_off = 0
  state _w = 0
  state _rec = 0
  state _oa = 0
  state _ob = 0
  state _rec_prev = 0
  state _org_prev = 0
  state _shift_prev = 0
  state _mark_prev = 0
  state _unmark_prev = 0
  state _clear_prev = 0
  state _play_prev = 0
  state _clk_prev = 0
  state _clk_since = 0
  state _clk_period = 0
  state _cursor = 0
  state _shift_i = 0
  state _since = 0
  state _speed_now = 1
  state _fresh = 1
  state _drawn = 0
  state _last_pos = 0
  state _g_on = zeros(6)
  state _g_start = zeros(6)
  state _g_a = zeros(6)
  state _g_sl = zeros(6)
  state _g_off = zeros(6)
  state _g_trav = zeros(6)
  state _g_len = zeros(6)
  state _g_pitch = zeros(6)
  state _g_pan = zeros(6)
  state _eos = 0
  state _level = 0
  _sr = sample_rate.num
  _in = x.sum.max(-16).min(16)
  _rec_gate = if record > 0.5 { 1 } else { 0 }
  _rec_edge = if _rec_gate > 0 and _rec_prev <= 0 { 1 } else { 0 }
  _rec_fall = if _rec_gate <= 0 and _rec_prev > 0 { 1 } else { 0 }
  _rec_prev = _rec_gate
  _shift_gate = if shift > 0.5 { 1 } else { 0 }
  _shift_edge = if _shift_gate > 0 and _shift_prev <= 0 { 1 } else { 0 }
  _shift_prev = _shift_gate
  _mark_gate = if mark > 0.5 { 1 } else { 0 }
  _mark_edge = if _mark_gate > 0 and _mark_prev <= 0 { 1 } else { 0 }
  _mark_prev = _mark_gate
  _unmark_gate = if unmark > 0.5 { 1 } else { 0 }
  _unmark_edge = if _unmark_gate > 0 and _unmark_prev <= 0 { 1 } else { 0 }
  _unmark_prev = _unmark_gate
  _clear_gate = if clear > 0.5 { 1 } else { 0 }
  _clear_edge = if _clear_gate > 0 and _clear_prev <= 0 { 1 } else { 0 }
  _clear_prev = _clear_gate
  _play_gate = if play > 0.5 { 1 } else { 0 }
  _play_edge = if _play_gate > 0 and _play_prev <= 0 { 1 } else { 0 }
  _play_prev = _play_gate
  _n = if _clear_edge > 0 { 0 } else { _n }
  _end = if _clear_edge > 0 { 0 } else { _end }
  _rec = if _clear_edge > 0 { 0 } else { _rec }
  _fin = if _rec == 1 and (_rec_gate <= 0 or _w >= size - 1) { 1 } else { 0 }
  _edges[_n + 1] = if _fin > 0 { _end } else { _edges[_n + 1] }
  _n = _n + _fin
  _org = choose.max(0).min(0.9999)
  _changed = if abs(_org - _org_prev) > 0.0001 { 1 } else { 0 }
  _org_prev = _org
  _shift_off = if _fin > 0 { _n - 1 - floor(_org * _n) } else { if _changed > 0 { 0 } else { if _shift_edge > 0 { _shift_off + 1 } else { _shift_off } } }
  _nn = _n.max(1)
  _pick = floor(_org * _n) + _shift_off
  _sel = if _n > 0 { _pick - _nn * floor(_pick / _nn) } else { 0 }
  _a = _edges[_sel]
  _b = _edges[_sel + 1]
  _slen = (_b - _a).max(2)
  _start_new = if _rec_edge > 0 and (_n == 0 or new_splice > 0.5) and _n < splices and _end < size - 64 { 1 } else { 0 }
  _start_over = if _rec_edge > 0 and _start_new <= 0 and _n > 0 { 1 } else { 0 }
  _rec = if _rec_gate <= 0 { 0 } else { if _start_new > 0 { 1 } else { if _start_over > 0 { 2 } else { if _fin > 0 { 0 } else { _rec } } } }
  _behind = _last_pos - 2 - _a
  _w = if _start_new > 0 { _end } else { if _start_over > 0 { _a + _behind - _slen * floor(_behind / _slen) } else { _w } }
  _oa = if _start_over > 0 { _a } else { _oa }
  _ob = if _start_over > 0 { _b } else { _ob }
  _gs = grain_size.max(0).min(1)
  _len = exp(log(_slen) * (1 - _gs) + log(96) * _gs).min(_slen).max(2)
  _m = morph.max(0).min(1)
  _fade = (_len * 0.5).min(0.012 * _sr).max(1)
  _over = 1 + 3 * ((_m - 0.33) / 0.57).max(0).min(1)
  _spacing = (if _m < 0.33 { _len + (0.33 - _m) / 0.33 * _len } else { _len / _over }).max(1)
  _speed_now = _speed_now + (speed.max(-4).min(4) - _speed_now) * (1 - exp(-1 / (0.02 * _sr)))
  _sp = _speed_now
  _move = abs(_sp)
  _clk_gate = if clock > 0.5 { 1 } else { 0 }
  _clk_edge = if _clk_gate > 0 and _clk_prev <= 0 { 1 } else { 0 }
  _clk_prev = _clk_gate
  _clk_period = if _clk_edge > 0 and _clk_since > 0 { _clk_since + 1 } else { _clk_period }
  _clk_since = if _clk_edge > 0 { 0 } else { (_clk_since + 1).min(10000000) }
  _clocked = if _clk_period > 0 and _clk_since < 5 * _sr { 1 } else { 0 }
  _stretch = if _clocked > 0 and _m > 0.45 { 1 } else { 0 }
  _gshift = if _clocked > 0 and _m <= 0.45 { 1 } else { 0 }
  _cursor = if _clk_edge > 0 { 0 } else { (_cursor + _slen / _clk_period.max(1)).min(_slen * 4) }
  _shift_i = if _clk_edge > 0 and _gshift > 0 { _shift_i + 1 } else { _shift_i }
  _base = slide.max(0).min(1) * _slen
  _origin = if _stretch > 0 { _base + _cursor } else { if _gshift > 0 { _base + _shift_i * _len } else { _base } }
