// Ready-made effects: `use std/fx`. Each reads the sound coming in as `in`, and `mix` blends it
// with the original where there is one. They are complete on their own, so the tracker copies one
// into a project as it stands and you can edit it from there.

// folder: filters

/// Remove high frequencies. Resonance shapes the filter around cutoff.
fx lowpass(
  cutoff: 20hz..20000hz = 2400hz,
  resonance: 0..0.95 = 0.2,
  mix: 0..1 = 1
) {
  out = in * (1 - mix) + in.lpf(cutoff: cutoff, res: resonance) * mix
}

/// Remove low frequencies. Resonance shapes the filter around cutoff.
fx highpass(
  cutoff: 20hz..20000hz = 200hz,
  resonance: 0..0.95 = 0.2,
  mix: 0..1 = 1
) {
  out = in * (1 - mix) + in.hpf(cutoff: cutoff, res: resonance) * mix
}

/// Keep a band of frequencies around the cutoff.
fx bandpass(
  cutoff: 20hz..20000hz = 1200hz,
  resonance: 0..0.95 = 0.2,
  mix: 0..1 = 1
) {
  out = in * (1 - mix) + in.bpf(cutoff: cutoff, res: resonance) * mix
}

/// Cut a narrow band of frequencies around the cutoff.
fx band_cut(
  cutoff: 20hz..20000hz = 1200hz,
  resonance: 0..0.95 = 0.2,
  mix: 0..1 = 1
) {
  out = in * (1 - mix) + in.notch(cutoff: cutoff, res: resonance) * mix
}

// folder: eq

/// Raise or cut the lows, a band in the middle, and the highs.
fx equalizer(
  low: -18db..18db = 0db,
  low_freq: 20hz..1000hz = 120hz,
  mid: -18db..18db = 0db,
  mid_freq: 100hz..10000hz = 1000hz,
  high: -18db..18db = 0db,
  high_freq: 1000hz..20000hz = 6000hz
) {
  out = in.low_shelf(cutoff: low_freq, gain: low).peak_eq(cutoff: mid_freq, gain: mid, q: 1).high_shelf(cutoff: high_freq, gain: high)
}

// folder: time/delay

/// Echoes with independent left/right timing, feedback and a dry/wet blend.
fx echo(
  left: 1ms..2sec = 250ms,
  right: 1ms..2sec = 375ms,
  feedback: 0..0.95 = 0.35,
  mix: 0..1 = 0.3
) {
  wet = in.delay(time: [left, right], feedback: feedback, max: 2sec)
  out = in * (1 - mix) + wet * mix
}

// folder: time/glitch

/// Glitches on the same sound, one after another: stutter repeats the last piece, rewind plays it backwards,
/// slow winds the sound down like a stopping tape, and crush reduces its sample rate and bit depth. Each is
/// switched on by its own control (automate them, or set them from a command column) and the sound passes
/// through untouched while all are off. A `stutter_shrink` below 1 makes a held stutter roll faster.
fx glitch(
  stutter: 0..1 = 0,
  stutter_length: 1ms..1sec = 125ms,
  stutter_pitch: -24..24 = 0,
  stutter_shrink: 0.5..1 = 1,
  rewind: 0..1 = 0,
  rewind_length: 1ms..1sec = 250ms,
  slow: 0..1 = 0,
  slow_time: 10ms..1sec = 400ms,
  crush: 0..1 = 0,
  crush_bits: 2..16 = 5,
  crush_rate: 200hz..20000hz = 4000hz,
  mix: 0..1 = 1
) {
  glitched = in
    .repeat_last(hold: stutter, length: stutter_length, pitch: stutter_pitch, shrink: stutter_shrink)
    .rewind_last(hold: rewind, length: rewind_length)
    .slow_down(hold: slow, time: slow_time)
    .apply(fn(s) { s.bitcrush(rate: crush_rate, bits: crush_bits) }, when: crush)
  out = in * (1 - mix) + glitched * mix
}
// Run `make` on the sound, as much as `when` says: 0 is not at all, 1 is all of it, and a value between
// mixes the two. `when` moves smoothly over `blend`. Any function of one sound will do:
// `x.apply(fn(s) { s.bitcrush(bits: 5) }, when: gate)`.
fn apply(x, make: fn, when: 0..1, blend: sec = 3ms) {
  state mix = 0
  step = 1 / (blend.num * sample_rate.num).max(1)
  mix = mix + (when - mix).max(-step).min(step)
  x + (make(x) - x) * mix
}
// Repeat the last `length` of the sound for as long as `hold` is above zero, then let the sound
// through again. Each repeat is `fade` times the level of the one before and `shrink` times the
// length, so a `shrink` below 1 rolls faster the longer it is held. `pitch` (in semitones) changes the
// speed the piece is read at. `length`, `pitch` and `fade` can move while it is held. `max` is the
// longest `length`, in samples.
fn repeat_last(x, hold: 0..1, length: sec, pitch: -24..24 = 0, fade: 0..1 = 1, shrink: 0.5..1 = 1, blend: sec = 3ms, max: const int = 96000) {
  state ring = zeros(max)
  state pos = 0
  state frozen = 0
  state phase = 0
  state level = 1
  state scale = 1
  state mix = 0
  held = hold > 0
  if held and prev(hold) <= 0 {
    frozen = pos
    phase = 0
    level = 1
    scale = 1
  }
  seam = 0.001 * sample_rate.num
  size = (length.num * sample_rate.num * scale).max(4 * seam)
  step = 1 / (blend.num * sample_rate.num).max(1)
  mix = mix + (held - mix).max(-step).min(step)
  wet = x
  if held or mix > 0 {
    edge = min(phase, size - phase).min(seam) / seam
    wet = ring.at(frozen - size + phase, interp: linear) * level * edge
    phase = phase + exp(pitch * 0.05776227)
    if phase >= size {
      phase = phase - size
      level = level * fade
      scale = scale * shrink
    }
  }
  if not held {
    ring[pos] = x
    pos = (pos + 1).mod(max)
  }
  x + (wet - x) * mix
}
// Play the last `length` of the sound backwards, over and over, for as long as `hold` is above zero.
fn rewind_last(x, hold: 0..1, length: sec, blend: sec = 3ms, max: const int = 96000) {
  state ring = zeros(max)
  state pos = 0
  state frozen = 0
  state phase = 0
  state mix = 0
  held = hold > 0
  if held and prev(hold) <= 0 {
    frozen = pos
    phase = 0
  }
  seam = 0.001 * sample_rate.num
  size = length.num * sample_rate.num
  step = 1 / (blend.num * sample_rate.num).max(1)
  mix = mix + (held - mix).max(-step).min(step)
  wet = x
  if held or mix > 0 {
    edge = min(phase, size - phase).min(seam) / seam
    wet = ring.at(frozen - phase, interp: linear) * edge
    phase = phase + 1
    if phase >= size {
      phase = phase - size
    }
  }
  if not held {
    ring[pos] = x
    pos = (pos + 1).mod(max)
  }
  x + (wet - x) * mix
}
// Slow the sound down to a stop over `time` while `hold` is above zero, like a tape machine
// switched off, and play it live again when `hold` ends.
fn slow_down(x, hold: 0..1, time: sec, blend: sec = 3ms, max: const int = 96000) {
  state ring = zeros(max)
  state pos = 0
  state read = 0
  state elapsed = 0
  state mix = 0
  held = hold > 0
  ring[pos] = x
  pos = (pos + 1).mod(max)
  if held and prev(hold) <= 0 {
    read = pos - 1
    elapsed = 0
  }
  size = time.num * sample_rate.num
  step = 1 / (blend.num * sample_rate.num).max(1)
  mix = mix + (held - mix).max(-step).min(step)
  wet = x
  if held or mix > 0 {
    speed = if elapsed < size { 1 - elapsed / size } else { 0 }
    wet = ring.at(read, interp: linear) * min(1, speed * 8)
    read = read + speed
    elapsed = elapsed + 1
  }
  x + (wet - x) * mix
}

// folder: time/reverb

/// A room or hall: `room` is its size, `damp` how quickly the highs die away in it.
fx room_reverb(
  room: 0..1 = 0.6,
  damp: 0..1 = 0.5,
  mix: 0..1 = 0.3
) {
  out = in * (1 - mix) + in.reverb(room: room, damp: damp) * mix
}

// folder: modulation

/// Gently widen the signal with a modulated delay chorus.
fx ensemble(
  rate: 0.05hz..8hz = 0.8hz,
  depth: 0..1 = 0.3,
  time: 1ms..40ms = 15ms,
  mix: 0..1 = 0.4
) {
  out = in.chorus(rate: rate, depth: depth, time: time, mix: mix)
}

/// A sweeping phaser: notches that move around `center`, fed back on themselves.
fx swirl(
  rate: 0.05hz..8hz = 0.4hz,
  depth: 0..1 = 0.6,
  center: 100hz..8000hz = 800hz,
  feedback: 0..0.9 = 0.4,
  mix: 0..1 = 0.5
) {
  out = in.phaser(rate: rate, depth: depth, center: center, feedback: feedback, mix: mix)
}

/// Amplitude tremolo. shape selects the LFO: 0 sine, 1 triangle, 2 square, 3 saw.
fx tremolo(
  rate: 0.1hz..20hz = 4hz,
  depth: 0..1 = 0.5,
  shape: 0..3 = 0
) {
  wave = (shape < 0.5) * osc(sine, rate) + (shape >= 0.5 and shape < 1.5) * osc(tri, rate) + (shape >= 1.5 and shape < 2.5) * osc(square, rate) + (shape >= 2.5) * osc(saw, rate)
  out = in * (1 - depth * (wave * 0.5 + 0.5))
}

// folder: dynamics

/// Turn loud parts down: above the threshold the level is reduced by the ratio, and makeup brings
/// the whole signal back up. `knee` rounds the corner at the threshold. `link` is how much the
/// channels of a stereo sound share one squeeze: at 1 the loudest decides for both, so the image
/// stays put; at 0 each side is squeezed on its own.
fx compressor(
  threshold: -60db..0db = -18db,
  ratio: 1..20 = 4,
  attack: 1ms..100ms = 10ms,
  release: 10ms..1sec = 120ms,
  makeup: 0db..24db = 3db,
  knee: 0db..24db = 6db,
  link: 0..1 = 1
) {
  level = in.map(abs(it))
  side = level * (1 - link) + level.max * link
  out = in.compress(threshold: threshold, ratio: ratio, attack: attack, release: release, makeup: makeup, sidechain: side, knee: knee)
}

// folder: distortion

/// Warm or hard distortion. `drive` is how hard the signal is pushed, `tone` how bright it is. It runs
/// at twice the sample rate, so bright sounds pushed hard don't fold harmonics back down as noise.
fx overdrive(
  drive: 0..1 = 0.4,
  tone: 0..1 = 0.5,
  mix: 0..1 = 1
) {
  push = 1 + drive * 12
  bright = tone
  wet = mix
  out = oversample(2) { in.distortion(drive: push, tone: bright, mix: wet) }
}

/// Lo-fi: fewer bits and a lower sample rate, for grit.
fx lofi(
  rate: 1khz..48khz = 12khz,
  bits: 2..16 = 8,
  mix: 0..1 = 1
) {
  out = in * (1 - mix) + in.bitcrush(rate: rate, bits: bits) * mix
}

// folder: dynamics

/// Stop the signal rising above the ceiling.
fx ceiling(
  level: -24db..0db = -1db,
  release: 5ms..500ms = 80ms
) {
  out = in.limiter(ceiling: level, release: release)
}
