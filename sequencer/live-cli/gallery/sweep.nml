// family: modifiers
// The looped sample through a resonant band-pass filter that sweeps up and down.
// rate: 0.05..2 log
// low: 150..600 log
// high: 1500..6000 log
// res: 0.4..0.9
config { channels: stereo }
tempo 100bpm
src = sample("{sample}").loop(forward)
instr voice() {
  centre = lfo({rate}hz).unipolar.range({low}hz..{high}hz)
  filtered = src().bpf(cutoff: centre, res: {res})
  filtered * env[0 5ms 1 | 300ms 0] * 0.9
}
voice() for 2bars
