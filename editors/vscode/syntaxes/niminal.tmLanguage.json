{
  "scopeName": "source.niminal",
  "name": "niminal",
  "patterns": [
    {
      "name": "comment.line.double-slash.niminal",
      "match": "//.*$"
    },
    {
      "name": "string.quoted.double.niminal",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.niminal",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "meta.grid.inline.niminal",
      "begin": "\\b(grid)\\s*(\\[)",
      "end": "\\]",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.niminal"
        },
        "2": {
          "name": "punctuation.bracket.niminal"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.bracket.niminal"
        }
      },
      "patterns": [
        {
          "name": "string.other.hit.niminal",
          "match": "[xXo]+"
        },
        {
          "name": "comment.rest.niminal",
          "match": "[.~]+"
        }
      ]
    },
    {
      "begin": "\\b(grid)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.niminal"
        }
      },
      "patterns": [
        {
          "name": "comment.line.double-slash.niminal",
          "match": "//.*$"
        },
        {
          "begin": "^\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "end": "$",
          "beginCaptures": {
            "1": {
              "name": "entity.name.tag.niminal"
            }
          },
          "patterns": [
            {
              "begin": "\\G\\(",
              "end": "\\)",
              "patterns": [
                {
                  "name": "variable.parameter.niminal",
                  "match": "[A-Za-z_][A-Za-z0-9_]*(?=\\s*:)"
                },
                {
                  "name": "constant.numeric.unit.niminal",
                  "match": "[+-]?\\b\\d+(\\.\\d+)?(hz|khz|db|bpm|sec|ms|samples|beats?|bars?|deg|st|ct|s|%)(?![A-Za-z0-9_])"
                },
                {
                  "name": "constant.numeric.niminal",
                  "match": "[+-]?\\b\\d+(\\.\\d+)?\\b"
                }
              ]
            },
            {
              "name": "string.other.hit.niminal",
              "match": "(?<![A-Za-z0-9_])[xXo]+(?![A-Za-z0-9_])"
            },
            {
              "name": "comment.rest.niminal",
              "match": "[.~]"
            },
            {
              "name": "constant.numeric.unit.niminal",
              "match": "[+-]?\\b\\d+(\\.\\d+)?(hz|khz|db|bpm|sec|ms|samples|beats?|bars?|deg|st|ct|s|%)(?![A-Za-z0-9_])"
            },
            {
              "name": "constant.numeric.niminal",
              "match": "[+-]?\\b\\d+(\\.\\d+)?\\b"
            },
            {
              "name": "keyword.operator.niminal",
              "match": "[*/!@?,<>]"
            },
            {
              "name": "punctuation.bracket.niminal",
              "match": "[\\[\\]()]"
            }
          ]
        }
      ]
    },
    {
      "begin": "\\b(instr|mono|fn|def)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
      "end": "\\)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.niminal"
        },
        "2": {
          "name": "entity.name.function.niminal"
        }
      },
      "patterns": [
        {
          "include": "#params"
        }
      ]
    },
    {
      "match": "\\b(fx)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.niminal"
        },
        "2": {
          "name": "entity.name.function.niminal"
        }
      }
    },
    {
      "match": "\\b(clip|scene|arrangement|bus|buffer|const|ctl|state)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.niminal"
        },
        "2": {
          "name": "entity.name.type.niminal"
        }
      }
    },
    {
      "name": "variable.other.assignment.niminal",
      "match": "(?<![\\w.])[A-Za-z_][A-Za-z0-9_]*(?=\\s*(?:\\+=|=(?!=)))"
    },
    {
      "name": "variable.parameter.niminal",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=:)"
    },
    {
      "name": "keyword.control.niminal",
      "match": "\\b(instr|mono|fn|def|const|bus|buffer|ctl|node|fx|config|clip|scene|arrangement|kit|events|midi_out|over|meter|tempo|state|use|unsolo|hush|panic|reset|reset_on|after|new|at|next|now|if|else|match|for|in|and|or|not|init|control|as|capture|last|spawn|oversample|env|cycle)\\b"
    },
    {
      "name": "keyword.control.command.niminal",
      "match": "(?<=\\.)(start|stop|play|mute|unmute|solo|unsolo|undo|clear|set|reverse|thin)\\b"
    },
    {
      "name": "variable.language.niminal",
      "match": "\\b(out|it|note|clock)\\b"
    },
    {
      "name": "constant.numeric.unit.niminal",
      "match": "[+-]?\\b\\d+(\\.\\d+)?(hz|khz|db|bpm|sec|ms|samples|beats?|bars?|deg|st|ct|s|%)(?![A-Za-z0-9_])"
    },
    {
      "name": "constant.numeric.niminal",
      "match": "[+-]?\\b\\d+(\\.\\d+)?\\b"
    },
    {
      "name": "constant.language.note.niminal",
      "match": "\\b[a-g](#|b)?-?\\d\\b"
    },
    {
      "name": "constant.language.wave.niminal",
      "match": "\\b(sine|saw|square|pulse|tri|stereo|mono|quad|true|false|pi|sample_rate)\\b"
    },
    {
      "name": "keyword.operator.niminal",
      "match": "\\+=|\\.\\.<?|->|==|!=|<=|>=|=|[-+*/<>]|~"
    },
    {
      "name": "support.function.niminal",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\()"
    },
    {
      "name": "entity.name.function.method.niminal",
      "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*"
    }
  ],
  "repository": {
    "params": {
      "patterns": [
        {
          "name": "storage.type.niminal",
          "match": "\\b(hz|khz|db|sec|ms|samples|beats?|bars?|deg|st|ct|bpm|int|num|init|control|const|fn)\\b"
        },
        {
          "begin": "\\(",
          "end": "\\)"
        },
        {
          "match": "(?<=[(,])\\s*\\b([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "variable.parameter.niminal"
            }
          }
        },
        {
          "include": "#numbers"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.unit.niminal",
          "match": "[+-]?\\b\\d+(\\.\\d+)?(hz|khz|db|bpm|sec|ms|samples|beats?|bars?|deg|st|ct|s|%)(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.niminal",
          "match": "[+-]?\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    }
  }
}
