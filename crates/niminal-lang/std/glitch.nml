// Glitch functions: `use std/glitch`. Chain them on a sound, each with a control that switches it on, and
// the sound passes through untouched while every control is at zero. `hold` above zero switches a
// function on and `blend` is how long it takes to fade in and out, so a hold starts and ends without a
// click. They create no effects of their own, so a piece that uses them gets nothing else with them. The
// `glitch` effect in `std/fx` carries the same functions for the tracker, so use one module or the other,
// not both.

// Run `make` on the sound, as much as `when` says: 0 is not at all, 1 is all of it, and a value between
// mixes the two. `when` moves smoothly over `blend`. Any function of one sound will do:
// `x.apply(fn(s) { s.bitcrush(bits: 5) }, when: gate)`.
fn apply(x, make: fn, when: 0..1, blend: sec = 3ms) {
  state mix = 0
  step = 1 / (blend.num * sample_rate.num).max(1)
  mix = mix + (when - mix).max(-step).min(step)
  x + (make(x) - x) * mix
}
// Repeat the last `length` of the sound for as long as `hold` is above zero, then let the sound
// through again. Each repeat is `fade` times the level of the one before and `shrink` times the
// length, so a `shrink` below 1 rolls faster the longer it is held. `pitch` (in semitones) changes the
// speed the piece is read at. `length`, `pitch` and `fade` can move while it is held. `max` is the
// longest `length`, in samples.
fn repeat_last(x, hold: 0..1, length: sec, pitch: -24..24 = 0, fade: 0..1 = 1, shrink: 0.5..1 = 1, blend: sec = 3ms, max: const int = 96000) {
  state ring = zeros(max)
  state pos = 0
  state frozen = 0
  state phase = 0
  state level = 1
  state scale = 1
  state mix = 0
  held = hold > 0
  if held and prev(hold) <= 0 {
    frozen = pos
    phase = 0
    level = 1
    scale = 1
  }
  seam = 0.001 * sample_rate.num
  size = (length.num * sample_rate.num * scale).max(4 * seam)
  step = 1 / (blend.num * sample_rate.num).max(1)
  mix = mix + (held - mix).max(-step).min(step)
  wet = x
  if held or mix > 0 {
    edge = min(phase, size - phase).min(seam) / seam
    wet = ring.at(frozen - size + phase, interp: linear) * level * edge
    phase = phase + exp(pitch * 0.05776227)
    if phase >= size {
      phase = phase - size
      level = level * fade
      scale = scale * shrink
    }
  }
  if not held {
    ring[pos] = x
    pos = (pos + 1).mod(max)
  }
  x + (wet - x) * mix
}
// Play the last `length` of the sound backwards, over and over, for as long as `hold` is above zero.
fn rewind_last(x, hold: 0..1, length: sec, blend: sec = 3ms, max: const int = 96000) {
  state ring = zeros(max)
  state pos = 0
  state frozen = 0
  state phase = 0
  state mix = 0
  held = hold > 0
  if held and prev(hold) <= 0 {
    frozen = pos
    phase = 0
  }
  seam = 0.001 * sample_rate.num
  size = length.num * sample_rate.num
  step = 1 / (blend.num * sample_rate.num).max(1)
  mix = mix + (held - mix).max(-step).min(step)
  wet = x
  if held or mix > 0 {
    edge = min(phase, size - phase).min(seam) / seam
    wet = ring.at(frozen - phase, interp: linear) * edge
    phase = phase + 1
    if phase >= size {
      phase = phase - size
    }
  }
  if not held {
    ring[pos] = x
    pos = (pos + 1).mod(max)
  }
  x + (wet - x) * mix
}
// Slow the sound down to a stop over `time` while `hold` is above zero, like a tape machine
// switched off, and play it live again when `hold` ends.
fn slow_down(x, hold: 0..1, time: sec, blend: sec = 3ms, max: const int = 96000) {
  state ring = zeros(max)
  state pos = 0
  state read = 0
  state elapsed = 0
  state mix = 0
  held = hold > 0
  ring[pos] = x
  pos = (pos + 1).mod(max)
  if held and prev(hold) <= 0 {
    read = pos - 1
    elapsed = 0
  }
  size = time.num * sample_rate.num
  step = 1 / (blend.num * sample_rate.num).max(1)
  mix = mix + (held - mix).max(-step).min(step)
  wet = x
  if held or mix > 0 {
    speed = if elapsed < size { 1 - elapsed / size } else { 0 }
    wet = ring.at(read, interp: linear) * min(1, speed * 8)
    read = read + speed
    elapsed = elapsed + 1
  }
  x + (wet - x) * mix
}
