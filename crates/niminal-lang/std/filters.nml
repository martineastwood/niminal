// Filters written in niminal: `use std/filters`.

/// A four-pole low-pass with a `tanh` in each stage, like a transistor ladder. `res` feeds the output
/// back to the input: 0 is a plain low-pass, and near 1 it rings and then sings at the cutoff.
fn ladder(x, cutoff: hz, res: 0..1 = 0.3) {
  state s1 = 0
  state s2 = 0
  state s3 = 0
  state s4 = 0
  g = 1 - exp(-2 * pi * cutoff / sample_rate)
  inp = x - 4 * res * s4
  s1 = s1 + g * (tanh(inp) - tanh(s1))
  s2 = s2 + g * (tanh(s1) - tanh(s2))
  s3 = s3 + g * (tanh(s2) - tanh(s3))
  s4 = s4 + g * (tanh(s3) - tanh(s4))
  s4
}

/// One biquad section, from its five coefficients (`a0` already divided out): the building block of
/// the `biquad_` filters below.
fn biquad(x, b0, b1, b2, a1, a2) {
  state x1 = 0
  state x2 = 0
  state y1 = 0
  state y2 = 0
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2
  x2 = x1
  x1 = x
  y2 = y1
  y1 = y
  y
}

/// A two-pole low-pass. `q` is the height of the peak at the cutoff: 0.707 is flat.
fn biquad_lp(x, cutoff: hz, q: num = 0.7071) {
  w = 2 * pi * cutoff / sample_rate
  alpha = sin(w) / (2 * q)
  a0 = 1 + alpha
  c = cos(w)
  biquad(x, (1 - c) / 2 / a0, (1 - c) / a0, (1 - c) / 2 / a0, -2 * c / a0, (1 - alpha) / a0)
}

/// A two-pole high-pass.
fn biquad_hp(x, cutoff: hz, q: num = 0.7071) {
  w = 2 * pi * cutoff / sample_rate
  alpha = sin(w) / (2 * q)
  a0 = 1 + alpha
  c = cos(w)
  biquad(x, (1 + c) / 2 / a0, -(1 + c) / a0, (1 + c) / 2 / a0, -2 * c / a0, (1 - alpha) / a0)
}

/// A two-pole band-pass with a constant peak gain of 1; `q` sets how narrow it is.
fn biquad_bp(x, cutoff: hz, q: num = 1) {
  w = 2 * pi * cutoff / sample_rate
  alpha = sin(w) / (2 * q)
  a0 = 1 + alpha
  c = cos(w)
  biquad(x, alpha / a0, 0, -alpha / a0, -2 * c / a0, (1 - alpha) / a0)
}

/// A notch: everything but a narrow band around `cutoff`.
fn biquad_notch(x, cutoff: hz, q: num = 1) {
  w = 2 * pi * cutoff / sample_rate
  alpha = sin(w) / (2 * q)
  a0 = 1 + alpha
  c = cos(w)
  biquad(x, 1 / a0, -2 * c / a0, 1 / a0, -2 * c / a0, (1 - alpha) / a0)
}

/// A one-pole low-pass: 6db an octave above the cutoff.
fn onepole_lp(x, cutoff: hz) {
  state y = 0
  a = exp(-2 * pi * cutoff / sample_rate)
  y = x * (1 - a) + y * a
  y
}

/// A one-pole high-pass: what `onepole_lp` leaves out.
fn onepole_hp(x, cutoff: hz) {
  x - onepole_lp(x, cutoff)
}
