  _alive = 0
  _slot = 99
  for _i in 0..<6 {
    _g_on[_i] = if _retrig > 0 { 0 } else { _g_on[_i] }
    _alive = _alive + _g_on[_i]
    _slot = if _g_on[_i] <= 0 and _slot > 5 { _i } else { _slot }
  }
  _since = (_since + _move).min(1000000000)
  _fresh = if _retrig > 0 or _n <= 0 { 1 } else { _fresh }
  _spawn = if _n > 0 and _b - _a > 8 and _play_gate > 0 and _slot < 6 and (_since >= _spacing or _fresh > 0) { 1 } else { 0 }
  _since = if _spawn > 0 { (if _fresh > 0 { 0 } else { (_since - _spacing).max(0) }) } else { _since }
  _fresh = if _spawn > 0 { 0 } else { _fresh }
  _r1 = fract(sin((_drawn + 1) * 12.9898) * 43758.5453)
  _r2 = fract(sin((_drawn + 1) * 78.233 + 1.7) * 24634.6345)
