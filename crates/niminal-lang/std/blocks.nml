    _g_off[_i] = if _here > 0 { 0 } else { _g_off[_i] }
    _g_trav[_i] = if _here > 0 { 0 } else { _g_trav[_i] }
    _g_len[_i] = if _here > 0 { _len + _fade } else { _g_len[_i] }
    _g_pitch[_i] = if _here > 0 { _pitch } else { _g_pitch[_i] }
