// Programmable score layer: def, for, if, and pattern combinators.
tempo 120bpm

instr pluck(freq: hz, bright: 0..1 = 0.5) {
  osc(saw, freq).lpf(cutoff: freq * (2 + bright * 6)).gain(-9db)
}

def motif(root) {
  stack([root ~ ~ ~], [~ ~ root ~].transpose(+7st))
}

def stairs(n) {
  for i in 0..<n {
    c4 + i * 1st
  }
}

clip line {
  instrument: pluck
  length: 2bars
  notes: cat(motif(c3), stairs(4))
}

clip fill {
  instrument: pluck(bright: 0.8)
  length: 1bar
  notes: stack([c5], [g4].slow(2))
}

scene verse { line }
scene break { fill }

verse.start
// two bars in, the fill takes over for a bar, then the line comes back
at +2bars verse.stop
at +2bars break.start
at +3bars break.stop
at +3bars verse.start
