}

// folder: drums/toms

/// A rounded tom. Notes tune the body; punch sets its initial pitch bend.
instr tom(
  freq: hz = c3,
  decay: 10ms..3sec = 330ms,
  punch: 0..48 = 14,
  rate: 1hz..4khz = 40hz,
  drive: 0..1 = 0,
  gain: db = 0db
) {
  hit = (1 * gain).max(0).min(1)
  drum(
    freq: 110hz * (freq / c3),
    noise_filter: band,
    attack: 0.5ms,
    decay: decay,
    mod_amount: punch,
    mod_rate: rate,
    noise_freq: 500hz,
    noise_q: 0.3,
    noise_attack: 1ms,
    noise_decay: 30ms,
    mix: 0.12,
    drive: drive,
    eq_freq: 1khz,
    eq_gain: 0db,
    amp: -5db,
    vel: hit,
    osc_vel: 0.5,
    noise_vel: 0.5,
    mod_vel: 0.1
  ).gain(gain)
}

// folder: sounds/fx

/// A falling saw laser. Drop sets its pitch sweep in semitones.
instr zap(
  freq: hz = c3,
  decay: 10ms..3sec = 320ms,
  drop: 0..48 = 44,
  rate: 1hz..4khz = 18hz,
  drive: 0..1 = 0,
  gain: db = 0db
) {
  hit = (1 * gain).max(0).min(1)
  drum(
    freq: 180hz * (freq / c3),
    wave: saw,
    attack: 0.5ms,
    decay: decay,
    mod_amount: drop,
    mod_rate: rate,
    noise_freq: 4khz,
    noise_q: 0.3,
    noise_attack: 1ms,
    noise_decay: 150ms,
    mix: 0,
    drive: drive,
    eq_freq: 1khz,
    eq_gain: 0db,
    amp: -9db,
    vel: hit,
    osc_vel: 0.5,
    noise_vel: 0.5,
    mod_vel: 0.1
  ).gain(gain)
}

// folder: sounds/fx

/// Random-pitch bubbles with a band-passed noise edge.
instr blip(
  freq: hz = c3,
  decay: 10ms..3sec = 600ms,
  scatter: 0..48 = 24,
  rate: 1hz..4khz = 14hz,
  drive: 0..1 = 0.3,
  gain: db = 0db
) {
  hit = (1 * gain).max(0).min(1)
  drum(
    freq: 900hz * (freq / c3),
    mod_mode: random,
    noise_filter: band,
    attack: 0.5ms,
    decay: decay,
    mod_amount: scatter,
    mod_rate: rate,
    noise_freq: 3khz,
    noise_q: 0.6,
    noise_attack: 1ms,
    noise_decay: decay,
    mix: 0.2,
    drive: drive,
    eq_freq: 1khz,
    eq_gain: 0db,
    amp: -10db,
    vel: hit,
    osc_vel: 0.5,
    noise_vel: 0.5,
    mod_vel: 0.1
  ).gain(gain)
}

