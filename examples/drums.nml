// Samples and kits. Every .wav in the folder is a sample you can name in a pattern.
// One instrument wraps the whole kit; individual drums can use their own routing.
// Rows can take pan/gain/pitch and mini-notation.
// Render with:  niminal-live render examples/drums.nml --out drums.wav --bars 4
config { channels: stereo }
tempo 100bpm

bus room: stereo
fx room_return {
  out = room.reverb(room: 0.35, damp: 0.5).gain(0.7)
}

drums = kit("drums")

instr drum_voice(sample, gain: db = 0db) { out = drums(sample: sample, gain: gain) }
hits = grid {
  kick:             x... x... x... x..x
  snare(pan: 8deg): [~ x ~ [x o]]
  hat(gain: -4db):  [x*2 x x(3,8)]
}

clip beat {
  instrument: drum_voice
  notes: hits
}
fx snare_fx {
  out = snare_audio.gain(-1db)
  room += out.gain(-12db)
}
bus snare_audio: stereo
instr snare_voice(sample, freq: hz = c4, gain: db = 0db, pan: deg = 0deg) {
  voice = drums(sample: sample, freq: freq, gain: gain).to_layout(mono).pan(azimuth: pan)
  snare_audio += voice
}
clip snare { instrument: snare_voice }
fx hat_fx {
  out = hat_audio.hpf(cutoff: 6khz)
}
bus hat_audio: stereo

instr hat_voice(sample, freq: hz = c4, gain: db = 0db, pan: deg = 0deg) {
  voice = drums(sample: sample, freq: freq, gain: gain).to_layout(mono).pan(azimuth: pan)
  hat_audio += voice
}
clip hat { instrument: hat_voice }

beat.start
