  _norm = (if _m >= 0.33 { 1 / _over } else { 1 }) * (_move * 8).min(1)
  _out_l = (_l * _norm).max(-16).min(16)
  _out_r = (_r * _norm).max(-16).min(16)
  _played = (_out_l + _out_r) * 0.5
  _mix = sos.max(0).min(1)
  _value = (_in * (1 - _mix) + _played * _mix).max(-16).min(16)
  _writing = if _rec > 0 { 1 } else { 0 }
  _buf[_w] = if _writing > 0 { _value } else { _buf[_w] }
  _w_next = _w + _writing
  _w = if _rec == 2 and _w_next >= _ob { _oa } else { _w_next }
  _end = if _rec == 1 { _w } else { _end }
  _can_mark = if _mark_edge > 0 and _n > 0 and _n < splices and _last_pos - _a > 480 and _b - _last_pos > 480 { 1 } else { 0 }
  for _k in 0..<splices {
    _top = splices - _k
