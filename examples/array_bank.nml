// A bank of 32 oscillators, processed together through a writable array.
tempo 100bpm

fn smooth_bank(xs: [num], amount: 0..1 = 0.04) {
  state history = zeros(xs.len)
  for i in xs.indices {
    history[i] = history[i] + (xs[i] - history[i]) * amount
  }
  history
}

instr cloud(freq: hz) {
  frequencies = (0..<32).map(freq * (1 + (it - 15.5) * 0.001))
  level = env[0 30ms 1 500ms 0.6 | 500ms 0]
  osc(saw, frequencies).smooth_bank(amount: 0.04).sum / 32 * level * 0.25
}

cloud(freq: a3) for 2beats
at 2beats cloud(freq: c4) for 2beats
at 4beats cloud(freq: e4) for 2beats
