// Run with: niminal server examples/live_controls.nml
// Send a control event (events.send) through the WebSocket client to turn cutoff or volume.
config { channels: stereo }
tempo 120bpm

ctl cutoff = 1khz.smooth(10ms)
ctl volume = -18db

instr tone(freq: hz) {
  osc(saw, freq)
  .lpf(cutoff: cutoff, res: 0.2)
  .pan(azimuth: 0deg) * env[0 2ms 1 200ms 0]
}

processor lead_fx {
  out = it.gain(volume)
}
part lead {
  instrument = tone
  output = lead_fx
}

lead.play([c4 e4 g4 b4])
