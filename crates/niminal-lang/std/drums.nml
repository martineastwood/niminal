/// A short square-wave rim knock with a noise click.
instr rim(
  freq: hz = c3,
  decay: 10ms..3sec = 38ms,
  knock: 0..24 = 6,
  rate: 1hz..4khz = 400hz,
  drive: 0..1 = 0.3,
  gain: db = 0db
) {
  hit = (1 * gain).max(0).min(1)
  drum(
    freq: 500hz * (freq / c3),
    wave: square,
    attack: 0.2ms,
    decay: decay,
    mod_amount: knock,
    mod_rate: rate,
    noise_freq: 3khz,
    noise_q: 0.3,
    noise_attack: 0.2ms,
    noise_decay: 14ms,
    mix: 0.25,
    drive: drive,
    eq_freq: 1.8khz,
    eq_gain: 3db,
    amp: -8db,
    vel: hit,
    osc_vel: 0.5,
    noise_vel: 0.5,
    mod_vel: 0.1
  ).gain(gain)
}

// folder: drums/claps

/// A dry clap: closely spaced noise bursts. Spread is the burst rate.
instr clap(
  freq: hz = c3,
  decay: 5ms..2sec = 220ms,
  tone: 500hz..16khz = 1.4khz,
  spread: 20hz..300hz = 95hz,
  gain: db = 0db
) {
  hit = (1 * gain).max(0).min(1)
  drum(
    mix: 1,
    noise_filter: band,
    noise_freq: tone * (freq / c3).max(0.1).min(8),
    noise_q: 0.45,
    noise_attack: 0.5ms,
    noise_decay: decay,
    amp: -5db,
    vel: hit,
    noise_vel: 0.5,
    noise_shape: burst,
    mod_rate: spread,
    drive: 0.15
  ).gain(gain)
}

// folder: drums/claps

/// A broad clap with a long noise tail. Spread is the burst rate.
instr clap_room(
  freq: hz = c3,
  decay: 5ms..2sec = 480ms,
  tone: 500hz..16khz = 1.2khz,
  spread: 20hz..300hz = 80hz,
  gain: db = 0db
) {
  hit = (1 * gain).max(0).min(1)
  drum(
    mix: 1,
    noise_filter: band,
    noise_freq: tone * (freq / c3).max(0.1).min(8),
    noise_q: 0.4,
    noise_attack: 0.5ms,
    noise_decay: decay,
    amp: -6db,
    vel: hit,
    noise_vel: 0.5,
    noise_shape: burst,
    mod_rate: spread,
    drive: 0.2
  ).gain(gain)
}

// folder: drums/hats

/// A short noise hi-hat. Tone and note tuning change its brightness.
instr hat_closed(
  freq: hz = c3,
  decay: 5ms..2sec = 45ms,
  tone: 500hz..16khz = 7khz,
  gain: db = 0db
) {
  choke = hats
  hit = (1 * gain).max(0).min(1)
  drum(
    mix: 1,
    noise_filter: high,
    noise_freq: tone * (freq / c3).max(0.1).min(8),
    noise_q: 0.1,
    noise_attack: 0.2ms,
    noise_decay: decay,
    amp: -12db,
    vel: hit,
    noise_vel: 0.5
  ).gain(gain)
}

// folder: drums/hats

/// An open noise hi-hat. A closed hat cuts it off.
instr hat_open(
  freq: hz = c3,
  decay: 5ms..2sec = 320ms,
  tone: 500hz..16khz = 6.5khz,
  gain: db = 0db
) {
  choke = hats
  hit = (1 * gain).max(0).min(1)
  drum(
    mix: 1,
    noise_filter: high,
    noise_freq: tone * (freq / c3).max(0.1).min(8),
    noise_q: 0.1,
    noise_attack: 0.2ms,
    noise_decay: decay,
    amp: -13db,
    vel: hit,
    noise_vel: 0.5
  ).gain(gain)
}

// folder: drums/hats

/// A very short, bright noise tick, in the hats choke group.
instr hat_tick(
  freq: hz = c3,
  decay: 5ms..2sec = 18ms,
  tone: 500hz..16khz = 9khz,
  gain: db = 0db
) {
  choke = hats
  hit = (1 * gain).max(0).min(1)
  drum(
    mix: 1,
    noise_filter: high,
    noise_freq: tone * (freq / c3).max(0.1).min(8),
    noise_q: 0.15,
    noise_attack: 0.1ms,
    noise_decay: decay,
    amp: -12db,
    vel: hit,
    noise_vel: 0.5
  ).gain(gain)
}

// folder: drums/percussion

/// A struck cowbell with two body modes and a short, inharmonic metallic clatter.
/// Metal brings out the higher modes; tone softens the strike. Notes transpose the whole bell.
instr cowbell(
  freq: hz = c3,
  decay: 20ms..2sec = 260ms,
  tone: 500hz..12khz = 4khz,
  metal: 0..1 = 0.6,
  gain: db = 0db
) {
  hit = (1 * gain).max(0).min(1)
  tuning = (freq / c3).max(0).min(16)
  length = decay.max(20ms).min(2sec)
  clang = metal.max(0).min(1)
  bend = 1 + env[0.008 12ms.exp 0]
  body = osc(sine, 540hz * tuning * bend) * perc(attack: 0.3ms, decay: length) + osc(sine, 800hz * tuning * bend) * perc(attack: 0.3ms, decay: length * 0.75) * 0.8
  upper = osc(sine, 1123hz * tuning) * perc(attack: 0.2ms, decay: length * 0.45) + osc(sine, 1645hz * tuning) * perc(attack: 0.2ms, decay: length * 0.3) * 0.7 + osc(sine, 2471hz * tuning) * perc(attack: 0.1ms, decay: length * 0.18) * 0.4
  strike = noise(seed: 31).bpf(cutoff: 2400hz, res: 0.2) * perc(attack: 0.1ms, decay: 25ms) * (0.15 + hit * 0.15)
  (body + upper * clang * (0.5 + hit * 0.5) + strike).lpf(cutoff: tone * (0.5 + hit * 0.5)) * 0.27 * gain
}

// folder: drums/cymbals

/// A synthetic crash: six inharmonic square oscillators under a bright noise wash.
/// Metal balances the ringing oscillators against noise; tone sets the high-pass edge.
instr crash(
  freq: hz = c3,
  decay: 100ms..5sec = 2.2sec,
  tone: 500hz..10khz = 4khz,
  metal: 0..1 = 0.45,
  gain: db = 0db
) {
  tuning = (freq / c3).max(0).min(8)
  ring = osc(square, 205hz * tuning) + osc(square, 304hz * tuning) + osc(square, 369hz * tuning) + osc(square, 522hz * tuning) + osc(square, 800hz * tuning) + osc(square, 1141hz * tuning)
  balance = metal.max(0).min(1)
  voice = ring * balance / 6 + noise(seed: 47) * (1 - balance)
  voice.hpf(cutoff: tone).lpf(cutoff: 14khz) * perc(attack: 1ms, decay: decay) * 0.3 * gain
}

// folder: sounds/fx

/// A rising noise sweep. Rise sets its swell and filter travel; decay is the tail after the swell.
instr sweep(
  freq: hz = c3,
  rise: 10ms..3sec = 180ms,
  decay: 20ms..4sec = 1.2sec,
  tone: 500hz..12khz = 6khz,
  gain: db = 0db
) {
  cutoff = env[200hz rise tone] * (freq / c3).max(0.1).min(8)
  noise(seed: 59).bpf(cutoff: cutoff, res: 0.5) * env[0 rise 1 decay 0] * 0.3 * gain
}
