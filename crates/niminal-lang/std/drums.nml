/// A tom. Play different notes for a set of toms.
instr tom(
  freq: hz = c3,
  attack: 0.1ms..50ms = 0.5ms,
  decay: 5ms..10sec = 330ms,
  mod_amount: -48..48 = 14,
  mod_rate: 1hz..4khz = 40hz,
  noise_freq: 20hz..20khz = 500hz,
  noise_q: 0..1 = 0.3,
  noise_attack: 0.1ms..200ms = 1ms,
  noise_decay: 5ms..10sec = 30ms,
  mix: 0..1 = 0.12,
  drive: 0..1 = 0,
  eq_freq: 20hz..20khz = 1khz,
  eq_gain: -24db..24db = 0db,
  amp: db = -5db,
  gain: db = 0db,
  osc_vel: 0..1 = 0.5,
  noise_vel: 0..1 = 0.5,
  mod_vel: 0..1 = 0.1
) {
  drum(
    freq: 110hz * (freq / c3),
    noise_filter: band,
    attack: attack,
    decay: decay,
    mod_amount: mod_amount,
    mod_rate: mod_rate,
    noise_freq: noise_freq,
