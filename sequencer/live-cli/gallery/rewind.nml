// family: glitch
// The last piece of the break plays backwards, over and over, then the beat carries on.
// every: 2..6 int
// duty: 0.2..0.6
// piece: 0.25..2 log
config { channels: stereo }
tempo 100bpm
src = sample("{sample}").loop(forward)
instr voice() {
  hold = phasor((1 / ({every}beats).num).hz) > 1 - {duty}
  src().rewind_last(hold: hold, length: {piece}beats) * env[0 5ms 1 | 300ms 0] * 0.6
}
voice() for 2bars
