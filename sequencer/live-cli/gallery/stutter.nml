// family: glitch
// The last small piece of the break is held and repeated, rolling faster as it goes.
// every: 1..4 int
// duty: 0.2..0.6
// piece: 0.0625..0.5 log
// shrink: 0.6..1
// reverse: 0..1 int
// pitch: -12..12
config { channels: stereo }
tempo 100bpm
src = sample("{sample}").loop(forward)
instr voice() {
  hold = phasor((1 / ({every}beats).num).hz) > 1 - {duty}
  glitched = src().repeat_last(hold: hold, length: {piece}beats, shrink: {shrink},
    reverse: {reverse}, pitch: {pitch})
  glitched * env[0 5ms 1 | 300ms 0] * 0.6
}
voice() for 2bars
