    freq: 70hz * (freq / c3),
    wave: saw,
    mod_mode: wobble,
    attack: 8ms,
    decay: decay,
    mod_amount: wobble,
    mod_rate: rate,
    noise_freq: 4khz,
    noise_q: 0.3,
    noise_attack: 1ms,
    noise_decay: 150ms,
    mix: 0,
    drive: drive,
    eq_freq: 400hz,
    eq_gain: 5db,
    amp: -9db,
    vel: hit,
    osc_vel: 0.5,
    noise_vel: 0.5,
    mod_vel: 0.1
  ).gain(gain)
}

