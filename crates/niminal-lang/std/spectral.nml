// Spectral effects written with `frames`: `use std/spectral`. Each is `size` samples late.

/// Keep only the part of the spectrum from `lo` to `hi`, as fractions of the way to half the sample rate.
fn band_keep(x, lo: init 0..1 = 0, hi: init 0..1 = 0.25, size: const int = 1024) {
  bins = size / 2 + 1
  keep = (0..<bins).map((it >= lo * (bins - 1)) * (it <= hi * (bins - 1)))
  x.frames(size, fn(w) {
    s = fft(w)
    ifft(s[0] * keep, s[1] * keep)
  })
}

/// Keep every magnitude but make every phase zero: a robotic, pitched buzz at the rate of the frames.
fn robot(x, size: const int = 1024) {
  x.frames(size, fn(w) {
    s = fft(w)
    mag = sqrt(s[0] * s[0] + s[1] * s[1])
    ifft(mag, mag * 0)
  })
}

/// Smear the spectrum over time: each frame is mixed with what came before. `amount` near 1 is a long
/// wash.
fn blur(x, amount: init 0..1 = 0.9, size: const int = 1024) {
  x.frames(size, fn(w) {
    state held = zeros(size / 2 + 1)
    s = fft(w)
    mag = sqrt(s[0] * s[0] + s[1] * s[1])
    phase = atan2(s[1], s[0])
    held = held * amount + mag * (1 - amount)
    ifft(held * cos(phase), held * sin(phase))
  })
}

/// Silence the bins that are quieter than `threshold` (of the loudest possible), keeping the rest: a
/// spectral noise gate.
fn denoise(x, threshold: init 0..1 = 0.01, size: const int = 1024) {
  x.frames(size, fn(w) {
    s = fft(w)
    mag = sqrt(s[0] * s[0] + s[1] * s[1])
    open = mag > threshold * size / 4
    ifft(s[0] * open, s[1] * open)
  })
}

/// Smooth a real FFT's log magnitude with a triangular cepstral lifter. Larger detail keeps finer
/// spectral features; 32 is a useful starting point for broad resonances at size 1024 / 48khz.
/// Returns a positive magnitude envelope, floored at -120dB relative to the frame size.
fn spectral_envelope(re: [num], im: [num], detail: const int = 32) {
  size = (re.len - 1) * 2
  lifter = (0..<size).map(max(0, 1 - min(it, size - it) / max(1, detail)))
  magnitude = sqrt(re * re + im * im)
  cepstrum = ifft(log(max(magnitude, size * 0.000001)), re * 0)
  smooth = fft(cepstrum * lifter)
  exp(smooth[0])
}

/// Give the carrier the donor's broad spectral shape, retaining the carrier's phase and fine detail.
/// Amount 0 is the delayed carrier; 1 transfers the envelope. Gain is limited to 32x per bin.
fn envelope_transfer(carrier, donor, amount: 0..1 = 1, detail: const int = 32, size: const int = 1024) {
  carrier.frames(size, fn(a, b) {
    c = fft(a)
    d = fft(b)
    carrier_envelope = spectral_envelope(c[0], c[1], detail: detail)
    donor_envelope = spectral_envelope(d[0], d[1], detail: detail)
    active = (d[0] * d[0] + d[1] * d[1]).sum > 0
    ratio = min(32, donor_envelope / carrier_envelope) * active
    gain = 1 + (ratio - 1) * amount
    ifft(c[0] * gain, c[1] * gain)
  }, other: donor)
}

/// Instantaneous frequency in cycles/sample from successive real-FFT phases (radians).
/// Call once per frame with the actual hop in samples. Each call site has its own phase history.
fn phase_frequency(phase: [num], size: const int = 2048, hop: const 1..65536 = 512) {
  state previous = zeros(size / 2 + 1)
  centre = (0..<size / 2 + 1).map(it / size)
  difference = phase - previous - 2 * pi * centre * hop
  residual = atan2(sin(difference), cos(difference))
  previous = phase
  centre + residual / (2 * pi * hop)
}

/// Integrate cycles/sample into wrapped radians, once per frame. Use the analysis hop.
/// Paired with phase_frequency at unchanged frequencies, reconstructs the original phases.
fn phase_accumulate(frequency: [num], size: const int = 2048, hop: const 1..65536 = 512) {
  state phase = zeros(size / 2 + 1)
  next = phase + frequency * (2 * pi * hop)
  phase = atan2(sin(next), cos(next))
  phase
}

/// Peak-locked pitch shifting with transient handling and independent spectral-envelope control.
/// preserve: 1 retains the source envelope; formant shifts its colour independently in semitones.
/// transients: 1 resets growing peak regions on attacks; 0 keeps phase integration uninterrupted.
fn spectral_pitch(x, shift: -48..48 = 0, size: const int = 2048, overlap: const int = 4,
                  formant: -48..48 = 0, preserve: 0..1 = 0, transients: 0..1 = 1, detail: const int = 32) {
  spectral_warp(x, shift: shift, formant: formant, preserve: preserve, transients: transients,
                size: size, overlap: overlap, detail: detail)
}
