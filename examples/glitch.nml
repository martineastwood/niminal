// Glitching a break, the way a glitch plugin does it. The one-bar loop in break.wav is chopped into 16
// slices and played for two bars through an effect that is a chain: a stutter, a rewind, a tape-stop and a
// crush, one after another. Each has a control that switches it on, and the sound passes through untouched
// while they are all off. The clip draws when each is on, one row per control: `.` is off and `x` is on, and
// neighbouring `x`s are one long glitch. Change a row and render again.
// `repeat_last`, `rewind_last` and `slow_down` are opcodes, and `apply` comes with the language. The `glitch`
// effect in `std/fx` is the same chain, ready to put on a tracker track.
// Render with:  niminal render examples/glitch.nml --out glitch.wav --bars 4
config { channels: stereo }
tempo 130bpm

brk = sample("break.wav").beats(4)
chops = brk.slices(16)

bus break_audio: stereo

instr break_voice(sample) {
  break_audio += chops(sample: sample)
}

// A persistent fx reads the bus, so every glitch keeps hearing the break across notes. A control above
// zero switches its glitch on. `apply` runs any function on the sound the same way: here a crush, but a
// filter sweep or a reverb throw would go in the chain just like it.
fx break_glitch(
  stutter: 0..1 = 0, stutter_length: 1ms..1sec = 1/4beat, stutter_pitch: -24..24 = 0, stutter_shrink: 0.5..1 = 1,
  rewind: 0..1 = 0, rewind_length: 1ms..1sec = 1/4beat,
  slow: 0..1 = 0, slow_time: 10ms..1sec = 400ms,
  crush: 0..1 = 0, crush_bits: 2..16 = 5
) {
  out = break_audio
    .repeat_last(hold: stutter, length: stutter_length, pitch: stutter_pitch, shrink: stutter_shrink)
    .rewind_last(hold: rewind, length: rewind_length)
    .slow_down(hold: slow, time: slow_time)
    .apply(fn(s) { s.bitcrush(rate: 4000hz, bits: crush_bits) }, when: crush)
}

// bar 1 as recorded, bar 2 re-cut
cuts = [s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13 s14 s15  s0 s0 s2 s3 s4 s4 s6 s7 s8 s9 s2 s11 s12 s5 s14 s15]

clip glitched {
  instrument: break_voice
  length: 2bars
  notes: cuts

  // The rows are the effect's own controls. A row of steps spreads over the clip, and each step is a sixteenth.
  // Where rows overlap they work together: bar 2 ends with a stutter into a rewind, and a crush over its middle.
  break_glitch {
    stutter: .... .... .... .... .... .... .... xxx.
    rewind:  .... .... xx.. .... .... .... .... .xx.
    slow:    ...x xxx. .... .... .... .... .... ....
    crush:   .... .... .... .... .... xxxx xxxx ....

    // anything else is an ordinary lane: this stutter rolls faster the longer it is held, and the crush gets
    // harsher in the second half
    stutter_shrink: 0.7
    crush_bits: [8@16 4@16]
  }
}

glitched.start

// The same controls with chance in them. A row of steps takes the usual mini-notation: `<x .>` takes a turn each
// bar (a clip with no `length:` runs a bar at a time), `x?` happens half the time (the same way every time) and
// `x(3,16)` spreads three hits over sixteen steps. A step that is off, or dropped by `?`, is off.
// Evaluate it live (or swap `glitched.start` for `chancy.start`) and glitch the break differently each bar.
clip chancy {
  instrument: break_voice
  notes: [s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13 s14 s15]
  break_glitch {
    stutter: .... .... <x .>.x?. x?..
    rewind:  <. x>... x?.. .... ..x?.
    crush:   x(3,16)
  }
}
