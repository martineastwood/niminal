{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "@codemirror/language": ["node_modules/@codemirror/language"], "@lezer/highlight": ["node_modules/@lezer/highlight"] }
  },
  "include": ["src", "../editors/codemirror"]
}
