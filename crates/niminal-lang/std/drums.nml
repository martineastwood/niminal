// folder: drums/claps

/// A clap: noise chopped into quick bursts.
instr clap(
  freq: hz = c3,
  attack: 0.1ms..50ms = 0.5ms,
  decay: 5ms..10sec = 5ms,
  mod_amount: -48..48 = 0,
  mod_rate: 1hz..4khz = 95hz,
  noise_freq: 20hz..20khz = 1.4khz,
  noise_q: 0..1 = 0.45,
  noise_attack: 0.1ms..200ms = 0.5ms,
  noise_decay: 5ms..10sec = 220ms,
  mix: 0..1 = 1,
  drive: 0..1 = 0.15,
  eq_freq: 20hz..20khz = 1khz,
  eq_gain: -24db..24db = 0db,
  amp: db = -5db,
  gain: db = 0db,
  osc_vel: 0..1 = 0.5,
  noise_vel: 0..1 = 0.5,
  mod_vel: 0..1 = 0.1
) {
  drum(
    freq: 1khz * (freq / c3),
    noise_filter: band,
    noise_shape: burst,
    attack: attack,
    decay: decay,
    mod_amount: mod_amount,
    mod_rate: mod_rate,
    noise_freq: noise_freq,
    noise_q: noise_q,
    noise_attack: noise_attack,
    noise_decay: noise_decay,
    mix: mix,
    drive: drive,
    eq_freq: eq_freq,
    eq_gain: eq_gain,
    amp: amp,
    vel: 1 * gain,
    osc_vel: osc_vel,
    noise_vel: noise_vel,
    mod_vel: mod_vel
  )
}

