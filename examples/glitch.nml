// Glitching a break, the way a glitch plugin does it. The one-bar loop in break.wav is chopped into 16
// slices and played for seven bars: two of the plain beat, then three clips that ramp the glitching up to a
// peak, then two plain bars again, all through an effect that is a chain: a stutter, a rewind, a tape-stop, a
// scatter, a freeze and a crush, one after another. Each has a control that switches it on, and the sound
// passes through untouched while they are all off. The clip draws when each is on, one row per control: `.`
// is off and `x` is on, and neighbouring `x`s are one long glitch. Change a row and render again.
// `repeat_last`, `rewind_last`, `slow_down`, `scatter` and `freeze` are opcodes, and `apply` comes with the
// language. `scatter` shuffles slices of the last bar (the same seed shuffles the same way) and `freeze`
// holds the last moment as a cloud of grains. The `glitch` effect in `std/fx` is the same chain, ready to
// put on a tracker track. The `gate` row is a trance gate and the one control that starts open.
// Render with:  niminal-live render examples/glitch.nml --out glitch.wav --bars 7
config { channels: stereo }
tempo 130bpm

brk = sample("break.wav").beats(4)
chops = brk.slices(16)

bus break_audio: stereo

instr break_voice(sample) {
  break_audio += chops(sample: sample)
}

// A persistent fx reads the bus, so every glitch keeps hearing the break across notes. A control above
// zero switches its glitch on. `apply` runs any function on the sound the same way: here a crush, but a
// filter sweep or a reverb throw would go in the chain just like it.
fx break_glitch(
  stutter: 0..1 = 0, stutter_length: division = 1/4beat, stutter_pitch: -24..24 = 0, stutter_shrink: 0.5..1 = 1,
  rewind: 0..1 = 0, rewind_length: division = 1/4beat,
  slow: 0..1 = 0, slow_time: 10ms..1sec = 400ms,
  scatter: 0..1 = 0, scatter_slices: 2..32 = 8, scatter_seed: 0..999 = 0, scatter_reverse: 0..1 = 0,
  scatter_repeat: 0..1 = 0, scatter_drop: 0..1 = 0, scatter_detune: 0..12 = 0,
  freeze: 0..1 = 0, freeze_spread: 0..1 = 0.5,
  crush: 0..1 = 0, crush_bits: 2..16 = 5,
  gate: 0..1 = 1, gate_release: 0.1ms..500ms = 8ms
) {
  chain = break_audio
    .repeat_last(hold: stutter, length: stutter_length, pitch: stutter_pitch, shrink: stutter_shrink)
    .rewind_last(hold: rewind, length: rewind_length)
    .slow_down(hold: slow, time: slow_time)
    .scatter(hold: scatter, length: 1bar, slices: scatter_slices, seed: scatter_seed, reverse: scatter_reverse, repeat: scatter_repeat, drop: scatter_drop,
      detune: scatter_detune, max: 4sec)
    .freeze(hold: freeze, length: 1/4beat, spread: freeze_spread)
    .apply(fn(s) { s.bitcrush(rate: 4000hz, bits: crush_bits) }, when: crush)
  out = chain * gate.follow(attack: 2ms, release: gate_release)
}

// One clip per stage of the build, each a single bar (or two). A row of steps spreads over its clip, and each
// step is a sixteenth, so a bar is four groups of four. The rows are the effect's own controls; where they
// overlap they work together. A control that a clip leaves out stays off.

// the plain beat: all 16 slices in the order they were recorded, with every glitch off
clip plain {
  instrument: break_voice
  length: 1bar
  times: 2
  notes: [s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13 s14 s15]
}

// light: a stutter on the last step, a few slices swapped
clip light {
  instrument: break_voice
  length: 1bar
  times: 1
  notes: [s0 s1 s2 s3 s4 s4 s6 s7 s8 s9 s2 s11 s12 s5 s14 s15]
  break_glitch {
    stutter: .... .... .... x...
    rewind:  .... .... .... ..x.
  }
}

// building: more slices swapped, a scatter, a rewind and a crush
clip building {
  instrument: break_voice
  length: 1bar
  times: 1
  notes: [s0 s0 s2 s3 s4 s4 s6 s6 s8 s9 s2 s2 s12 s5 s14 s15]
  break_glitch {
    stutter: .... xx.. .... xxx.
    rewind:  .... .... xx.. ....
    scatter: .... xxxx .... ....
    crush:   .... .... xxxx ....

    scatter_seed: 7
  }
}

// peak: everything at once. It stutters into a rewind while the crush is on, and the trance gate
// (the one row that starts open: `x` lets the break through, `.` cuts it) chops it all up.
clip peak {
  instrument: break_voice
  length: 1bar
  times: 1
  notes: [s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s5 s14 s15]
  break_glitch {
    stutter: .... xx.. .... xxxx
    rewind:  xx.. .... .... .xx.
    slow:    ...x xxx. .... ....
    scatter: xxxx xxxx .... ....
    freeze:  .... .... xx.. .xx.
    crush:   .... xxxx xxxx ....
    gate:    xxx. xx.x x.xx .x.x

    // anything else is an ordinary lane: this stutter rolls faster the longer it is held
    stutter_shrink: 0.7
    scatter_seed: 7
    scatter_reverse: 0.3
    scatter_drop: 0.15
    scatter_detune: 5
    crush_bits: 4
  }
}

// `at +2bars` counts from the moment this is evaluated: the plain beat for two bars, a bar of each stage
// as the glitching ramps up, then the plain beat again.
plain.start
at +2bars light.start
at +3bars building.start
at +4bars peak.start
at +5bars plain.start

// The same controls with chance in them. A row of steps takes the usual mini-notation: `<x .>` takes a turn each
// bar (a clip with no `length:` runs a bar at a time), `x?` happens half the time (the same way every time) and
// `x(3,16)` spreads three hits over sixteen steps. A step that is off, or dropped by `?`, is off.
// Evaluate it live (with `chancy.start`) and glitch the break differently each bar.
clip chancy {
  instrument: break_voice
  notes: [s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13 s14 s15]
  break_glitch {
    stutter: .... .... <x .>.x?. x?..
    rewind:  <. x>... x?.. .... ..x?.
    crush:   x(3,16)
  }
}
