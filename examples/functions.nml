// Instruments built from functions: a plucked string, a wavetable, a filter with a mode switch.
// Render with:  niminal-live render examples/functions.nml --out functions.wav
config { channels: stereo }
tempo 96bpm

bus space: stereo
fx space_return {
  out = space.reverb(room: 0.8, damp: 0.4)
}

/// A plucked string: a delay line fed back through an averaging low-pass (Karplus-Strong).
fn string(x, freq: init hz, decay: 0..1 = 0.996, size: const int = 4096) {
  state buf = zeros(size)
  state pos = 0
  len = sample_rate / freq                        // worked out once per note
  delayed = buf.at(pos - len, interp: linear)
  y = x + (delayed + prev(delayed)) * 0.5 * decay
  buf[pos] = y
  pos = (pos + 1).mod(size)
  y
}

/// A state-variable filter, with all three of its outputs.
fn svf(x, cutoff: hz, res: 0..1 = 0.5) -> (low, band, high) {
  state low = 0
  state band = 0
  f = 2 * sin(pi * cutoff.clamp(20hz..12khz) / sample_rate)
  high = x - low - 2 * (1 - res) * band
  band = band + f * high
  low = low + f * band
}

/// One filter, three shapes: the mode is picked while compiling.
fn filter(x, cutoff: hz, res: 0..1 = 0.5, mode: (low | band | high) = low) {
  f = x.svf(cutoff: cutoff, res: res)
  if mode == low { f.low } else if mode == band { f.band } else { f.high }
}

const organ = harmonics([1, 0, 1/3, 0, 1/5, 0.2, 1/7], size: 2048)

instr pluck(freq: init hz, decay: 0..1 = 0.996) {
  tail = 3sec
  out = (noise() * env[1 4ms 0]).string(freq, decay: decay).filter(freq * 6, mode: low)
  space += out.gain(-12db)
}

instr keys(freq: hz, attack: sec = 20ms, release: sec = 600ms) {
  level = env[0 attack 1 400ms 0.6 | release 0]
  out = osc(organ, freq).filter(freq * 3 + level * 2khz, res: 0.3, mode: band) * level
  space += out.gain(-9db)
}

instr supersaw(freq: hz, detune: 0..1 = 0.4) {
  ratios = for i in 0..<7 { 1 + (i - 3) * detune * 0.01 }
  osc(saw, freq * ratios).sum / 7 * adsr(10ms, 200ms, 0.5, 400ms)
}

pluck(freq: e3) for 1beat
at 1/2beat pluck(freq: b3) for 1beat
at 1beat pluck(freq: g4, decay: 0.99) for 1beat
at 2beats keys(freq: e4) for 2beats
at 2beats keys(freq: g4, attack: 200ms) for 2beats
at 4beats supersaw(freq: e2) for 2beats
