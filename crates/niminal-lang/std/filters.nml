// One-pole filters written in niminal: `use std/filters`. The ladder (`ladder`) and the two-pole sections
// (`biquad`, `biquad_lp`, `biquad_hp`, ...) are opcodes and need no `use`.

/// A one-pole low-pass: 6db an octave above the cutoff.
fn onepole_lp(x, cutoff: hz) {
  state y = 0
  a = exp(-2 * pi * cutoff / sample_rate)
  y = x * (1 - a) + y * a
  y
}

/// A one-pole high-pass: what `onepole_lp` leaves out.
fn onepole_hp(x, cutoff: hz) {
  x - onepole_lp(x, cutoff)
}
