{
  "scopeName": "source.niminal",
  "name": "niminal",
  "patterns": [
    { "name": "comment.line.double-slash.niminal", "match": "//.*$" },
    { "name": "string.quoted.double.niminal", "begin": "\"", "end": "\"", "patterns": [
      { "name": "constant.character.escape.niminal", "match": "\\\\." }
    ]},
    { "name": "keyword.control.niminal", "match": "\\b(instr|mono|fn|def|const|bus|buffer|ctl|node|fx|config|clip|scene|arrangement|sample|kit|midi_out|over|meter|tempo|state|use|unsolo|hush|panic|reset|reset_on|after|new|at|next|now|if|else|match|for|in|and|or|not|init|control|as|capture|last|spawn|oversample|env|cycle)\\b" },
    { "name": "keyword.control.command.niminal", "match": "(?<=\\.)(start|stop|play|mute|unmute|solo|unsolo|undo|clear|set)\\b" },
    { "name": "variable.language.niminal", "match": "\\b(out|it|note|clock)\\b" },
    { "name": "constant.numeric.unit.niminal", "match": "[+-]?\\b\\d+(\\.\\d+)?(hz|khz|db|bpm|sec|ms|samples|beats?|bars?|deg|st|ct|s|%)(?![A-Za-z0-9_])" },
    { "name": "constant.numeric.niminal", "match": "[+-]?\\b\\d+(\\.\\d+)?\\b" },
    { "name": "constant.language.note.niminal", "match": "\\b[a-g](#|b)?-?\\d\\b" },
    { "name": "constant.language.wave.niminal", "match": "\\b(sine|saw|square|tri|stereo|mono|quad|true|false|pi|sample_rate)\\b" },
    { "name": "keyword.operator.niminal", "match": "\\+=|\\.\\.<?|->|==|!=|<=|>=|=|[-+*/<>]|~" },
    { "name": "support.function.niminal", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\()" },
    { "name": "entity.name.function.method.niminal", "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*" },
    { "name": "variable.parameter.niminal", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=:)" }
  ]
}
