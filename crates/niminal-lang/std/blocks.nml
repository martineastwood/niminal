    _y1 = _buf[_g_a[_i] + _q1 - _gl * floor(_q1 / _gl)]
    _y2 = _buf[_g_a[_i] + _q2 - _gl * floor(_q2 / _gl)]
    _y3 = _buf[_g_a[_i] + _q3 - _gl * floor(_q3 / _gl)]
    _idx = _g_a[_i] + _p - _gl * floor(_p / _gl)
