// Drum presets. `drum` (it comes with the language, no `use` needed) is one function with the controls of a
// drum machine voice, and each instrument here is that voice with its settings chosen: `use std/drums.{kick_808, snare_tri}`, then play them by name.
// A note tunes a preset (c3 plays it as designed), and the note's velocity (its `gain`) shapes the
// oscillator, noise and pitch modulation by as much as `osc_vel`, `noise_vel` and `mod_vel` say. The
// hats share a choke group, so a closed hat ends an open one. In the tracker, adding a preset copies the
// voice along with it, so the copy stands alone and every control can be edited.

// folder: drums/kicks

/// A deep sub kick with a long tail. Play a note to tune it.
instr kick_deep(
  freq: hz = c3,
  attack: 0.1ms..50ms = 0.5ms,
  decay: 5ms..10sec = 900ms,
  mod_amount: -48..48 = 24,
  mod_rate: 1hz..4khz = 35hz,
  noise_freq: 20hz..20khz = 2khz,
  noise_q: 0..1 = 0.3,
  noise_attack: 0.1ms..200ms = 1ms,
  noise_decay: 5ms..10sec = 6ms,
  mix: 0..1 = 0.04,
  drive: 0..1 = 0.1,
  eq_freq: 20hz..20khz = 1khz,
  eq_gain: -24db..24db = 0db,
  amp: db = -3db,
  gain: db = 0db,
  osc_vel: 0..1 = 0.5,
  noise_vel: 0..1 = 0.5,
  mod_vel: 0..1 = 0.1
) {
  drum(
    freq: 42hz * (freq / c3),
    noise_filter: high,
    attack: attack,
    decay: decay,
    mod_amount: mod_amount,
    mod_rate: mod_rate,
    noise_freq: noise_freq,
    noise_q: noise_q,
    noise_attack: noise_attack,
    noise_decay: noise_decay,
    mix: mix,
    drive: drive,
    eq_freq: eq_freq,
    eq_gain: eq_gain,
    amp: amp,
    vel: 1 * gain,
    osc_vel: osc_vel,
    noise_vel: noise_vel,
    mod_vel: mod_vel
  )
}

