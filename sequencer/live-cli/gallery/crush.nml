// family: glitch
// The break is crushed to a low sample rate and bit depth in bursts.
// every: 1..4 int
// duty: 0.3..0.8
// rate: 500..5000 log
// bits: 2..6 int
config { channels: stereo }
tempo 100bpm
src = sample("{sample}").loop(forward)
instr voice() {
  hold = phasor((1 / ({every}beats).num).hz) > 1 - {duty}
  src().apply(fn(s) { s.bitcrush(rate: {rate}hz, bits: {bits}) }, when: hold) * env[0 5ms 1 | 300ms 0] * 0.6
}
voice() for 2bars
