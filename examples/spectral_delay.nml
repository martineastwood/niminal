// Spectral delay: each frequency bin has its own delay line. At spread: 0 they echo together;
// raising spread makes the low frequencies arrive before the highs, smearing each pluck in time.
// Render with: nimlive render examples/spectral_delay.nml --out spectral_delay.wav
config { channels: stereo }
tempo 100bpm

instr pluck(freq: hz, spread: 0..1 = 0.8) {
  // Keep the voice alive after the note so the feedback can ring out.
  tail = 10sec
  dry = (osc(saw, freq) + osc(sine, freq * 2) * 0.75) * env[1 80ms 0]
  wet = dry.spectral_delay(time: 800ms, spread: spread, feedback: 0.55, size: 2048)
  out = dry + wet * 0.8
}

// The same note, first with all bins together, then with the spectrum spread out.
pluck(freq: a3, spread: 0) for 1/4beat
at 4beats pluck(freq: a3, spread: 1) for 1/4beat

// Leave space between phrases for the delayed harmonics to answer.
at 8beats pluck(freq: a3) for 1/4beat
at 9beats pluck(freq: c4) for 1/4beat
at 10beats pluck(freq: e4) for 1/4beat
at 12beats pluck(freq: g3) for 1/4beat
at 13beats pluck(freq: b3) for 1/4beat
at 14beats pluck(freq: d4) for 1/4beat
