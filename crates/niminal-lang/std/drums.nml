/// A closed hi-hat from high-passed noise.
instr hat_closed(
  freq: hz = c3,
  attack: 0.1ms..50ms = 0.5ms,
  decay: 5ms..10sec = 5ms,
  mod_amount: -48..48 = 0,
  mod_rate: 1hz..4khz = 100hz,
