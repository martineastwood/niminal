// folder: drums/kicks

/// A saturated sub kick. Drive roughens the body; punch shapes its pitch drop.
instr kick_dirty(
  freq: hz = c3,
  decay: 20ms..3sec = 600ms,
  punch: 0..48 = 28,
  click: 0..0.5 = 0,
  drive: 0..1 = 0.85,
  gain: db = 0db
) {
  hit = (1 * gain).max(0).min(1)
  drum(
    freq: 45hz * (freq / c3),
    attack: 0.5ms,
    decay: decay,
    mod_amount: punch,
    mod_rate: 50hz,
    noise_freq: 4khz,
    noise_q: 0.3,
    noise_attack: 1ms,
    noise_decay: 150ms,
    mix: click,
    drive: drive,
    eq_freq: 120hz,
    eq_gain: 5db,
    amp: -5db,
    vel: hit,
    osc_vel: 0.5,
    noise_vel: 0.5,
    mod_vel: 0.1
  ).gain(gain)
}

// folder: drums/snares

/// A snare with a triangle body and band-passed noise. Snap balances body and wires.
instr snare_tri(
  freq: hz = c3,
  decay: 20ms..2sec = 170ms,
  snap: 0..1 = 0.62,
  tone: 500hz..12khz = 4.2khz,
  drive: 0..1 = 0.2,
  gain: db = 0db
) {
  hit = (1 * gain).max(0).min(1)
  drum(
    freq: 185hz * (freq / c3),
    wave: tri,
    noise_filter: band,
    attack: 0.5ms,
    decay: decay * (110ms / 170ms),
    mod_amount: 10,
    mod_rate: 120hz,
    noise_freq: tone,
    noise_q: 0.3,
    noise_attack: 1ms,
    noise_decay: decay,
    mix: snap,
    drive: drive,
    eq_freq: 2khz,
    eq_gain: 3db,
    amp: -5db,
    vel: hit,
    osc_vel: 0.5,
    noise_vel: 0.5,
    mod_vel: 0.1
  ).gain(gain)
}

// folder: drums/snares

/// A short, dry snare. Decay shapes both body and wires.
instr snare_tight(
  freq: hz = c3,
  decay: 20ms..2sec = 110ms,
  snap: 0..1 = 0.55,
  tone: 500hz..12khz = 5khz,
  drive: 0..1 = 0.2,
  gain: db = 0db
) {
  hit = (1 * gain).max(0).min(1)
  drum(
    freq: 200hz * (freq / c3),
    wave: tri,
    noise_filter: band,
    attack: 0.5ms,
    decay: decay * (70ms / 110ms),
    mod_amount: 8,
    mod_rate: 150hz,
    noise_freq: tone,
    noise_q: 0.3,
    noise_attack: 1ms,
    noise_decay: decay,
    mix: snap,
    drive: drive,
    eq_freq: 1khz,
    eq_gain: 0db,
    amp: -5db,
    vel: hit,
    osc_vel: 0.5,
    noise_vel: 0.5,
    mod_vel: 0.1
  ).gain(gain)
}

