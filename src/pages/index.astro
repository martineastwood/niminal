---
const projects = [
	{
		name: 'nimgent',
		role: 'Library',
		description: 'Build provider-native LLM applications and agents with streaming, typed tools, structured output, and sessions.',
		url: 'https://nimgent.niminal.dev/',
	},
	{
		name: 'nimterm',
		role: 'Library',
		description: 'Build testable terminal interfaces with widgets, Markdown, agent events, and a native POSIX backend.',
		url: 'https://nimterm.niminal.dev/',
	},
	{
		name: 'nimwire',
		role: 'Library',
		description: 'Build MCP servers and backends in Nim.',
		url: 'https://nimwire.niminal.dev/',
	},
	{
		name: 'nimlet',
		role: 'Application',
		description: 'A minimal native coding agent, and the project the libraries were extracted from.',
		url: 'https://nimlet.niminal.dev/',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="A Nim stack for building AI agents, terminal interfaces, and MCP servers."
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Niminal</title>
	</head>
	<body>
		<main>
			<header>
				<p class="eyebrow">Niminal</p>
				<h1>The native Nim stack for building AI agents.</h1>
				<p class="lede">
					One application and a set of libraries, from model call to terminal UI.
					Each project does one job and can be used on its own.
				</p>
				<p class="actions">
					<a class="primary" href="https://nimlet.niminal.dev/">Use nimlet</a>
					<a class="secondary" href="https://nimgent.niminal.dev/">Build with the libraries</a>
				</p>
			</header>

			<section>
				<h2>Projects</h2>
				<ul class="grid">
					{projects.map((project) => (
						<li>
							<a href={project.url}>
								<span class="name">{project.name}</span>
								<span class="role">{project.role}</span>
								<span class="description">{project.description}</span>
							</a>
						</li>
					))}
				</ul>
			</section>

			<footer>
				<p>
					<a href="https://github.com/martineastwood">GitHub</a>
				</p>
			</footer>
		</main>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
		--bg: #0b0b0d;
		--surface: #141417;
		--border: #26262c;
		--text: #ececf1;
		--muted: #9a9aa5;
		--accent: #7c8cf8;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--text);
		font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
		line-height: 1.6;
	}

	main {
		max-width: 56rem;
		margin: 0 auto;
		padding: 5rem 1.5rem 3rem;
	}

	.eyebrow {
		margin: 0;
		color: var(--accent);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0.5rem 0 0;
		font-size: clamp(2rem, 5vw, 3rem);
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.lede {
		max-width: 40rem;
		margin: 1rem 0 0;
		color: var(--muted);
		font-size: 1.125rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 2rem 0 0;
	}

	.actions a {
		border-radius: 0.5rem;
		padding: 0.625rem 1.125rem;
		font-weight: 500;
		text-decoration: none;
	}

	.primary {
		background: var(--text);
		color: var(--bg);
	}

	.secondary {
		border: 1px solid var(--border);
		color: var(--text);
	}

	h2 {
		margin: 4rem 0 1.5rem;
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.grid {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.grid a {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		height: 100%;
		border: 1px solid var(--border);
		border-radius: 0.75rem;
		background: var(--surface);
		padding: 1.25rem;
		color: inherit;
		text-decoration: none;
	}

	.grid a:hover {
		border-color: var(--accent);
	}

	.name {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 1.125rem;
		font-weight: 600;
	}

	.role {
		color: var(--accent);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.description {
		color: var(--muted);
		font-size: 0.9375rem;
	}

	footer {
		margin-top: 4rem;
		border-top: 1px solid var(--border);
		padding-top: 1.5rem;
	}

	footer a {
		color: var(--muted);
	}
</style>
