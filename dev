#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

BUILD_DIR="${BUILD_DIR:-build/dev}"
ASAN_DIR="${ASAN_DIR:-build/asan}"
CMAKE_BUILD_TYPE="${CMAKE_BUILD_TYPE:-Release}"
JOBS="${JOBS:-$(sysctl -n hw.ncpu 2>/dev/null || echo 4)}"
CHECK_FAST=false
CHECK_SANITIZER=true
CHECK_TIDY_ALL=true

log() { printf '==> %s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

find_tool() {
  local name="$1"
  shift
  if command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
    return 0
  fi
  for candidate in "$@"; do
    if [[ -n "$candidate" && -x "$candidate" ]]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

CLANG_FORMAT="$(
  find_tool clang-format \
    "$(xcrun --find clang-format 2>/dev/null || true)" \
    /opt/homebrew/opt/llvm/bin/clang-format \
    /usr/local/opt/llvm/bin/clang-format
)" || die "clang-format not found"

CLANG_TIDY="$(
  find_tool clang-tidy \
    /opt/homebrew/opt/llvm/bin/clang-tidy \
    /usr/local/opt/llvm/bin/clang-tidy
)" || die "clang-tidy not found (install with: brew install llvm)"

RUN_CLANG_TIDY="$(
  find_tool run-clang-tidy \
    /opt/homebrew/opt/llvm/bin/run-clang-tidy \
    /usr/local/opt/llvm/bin/run-clang-tidy
)" || die "run-clang-tidy not found (install with: brew install llvm)"

source_files() {
  find include src tests -type f \( -name '*.cpp' -o -name '*.hpp' -o -name '*.h' \) | sort
}

tidy_files() {
  find src include -type f -name '*.cpp' | sort
}

changed_tidy_files() {
  if ! git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    tidy_files
    return
  fi
  {
    git -C "$ROOT" diff --name-only HEAD
    git -C "$ROOT" diff --name-only --cached
    git -C "$ROOT" ls-files --others --exclude-standard
  } | rg '^src/.*\.cpp$|^include/.*\.cpp$' | sort -u
}

parse_check_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --fast)
        CHECK_FAST=true
        CHECK_SANITIZER=false
        CHECK_TIDY_ALL=false
        ;;
      --no-sanitizer) CHECK_SANITIZER=false ;;
      --all-tidy) CHECK_TIDY_ALL=true ;;
      --changed-tidy) CHECK_TIDY_ALL=false ;;
      *) die "unknown check option: $1" ;;
    esac
    shift
  done
}

cmd_format() {
  local fix=false
  if [[ "${1:-}" == "--fix" ]]; then
    fix=true
  fi
  log "format"
  local files=()
  while IFS= read -r file; do
    files+=("$file")
  done < <(source_files)
  if ((${#files[@]} == 0)); then
    die "no source files found"
  fi
  if $fix; then
    "$CLANG_FORMAT" -i "${files[@]}"
  else
    "$CLANG_FORMAT" --dry-run --Werror "${files[@]}"
  fi
}

cmd_configure() {
  local dir="$BUILD_DIR"
  if [[ $# -gt 0 && "$1" != -* ]]; then
    dir="$1"
    shift
  fi
  log "configure ($dir)"
  if [[ "$dir" == "build/dev" && "$BUILD_DIR" == "build/dev" ]]; then
    cmake --preset dev -DCMAKE_BUILD_TYPE="$CMAKE_BUILD_TYPE" "$@"
  elif [[ "$dir" == "build/asan" && "$ASAN_DIR" == "build/asan" ]]; then
    cmake --preset asan -DCMAKE_BUILD_TYPE="$CMAKE_BUILD_TYPE" "$@"
  else
    cmake -S . -B "$dir" -DCMAKE_BUILD_TYPE="$CMAKE_BUILD_TYPE" "$@"
  fi
}

cmd_build() {
  local dir="$BUILD_DIR"
  if [[ $# -gt 0 && "$1" != -* ]]; then
    dir="$1"
    shift
  fi
  log "build ($dir)"
  if [[ "$dir" == "build/dev" && "$BUILD_DIR" == "build/dev" ]]; then
    cmake --build --preset dev --parallel "$JOBS" "$@"
  elif [[ "$dir" == "build/asan" && "$ASAN_DIR" == "build/asan" ]]; then
    cmake --build --preset asan --parallel "$JOBS" "$@"
  else
    cmake --build "$dir" --parallel "$JOBS" "$@"
  fi
}

cmd_tidy() {
  local fix=false
  local all=true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --fix) fix=true ;;
      --all) all=true ;;
      --changed) all=false ;;
      *) die "unknown tidy option: $1" ;;
    esac
    shift
  done

  log "clang-tidy"
  [[ -f "$BUILD_DIR/compile_commands.json" ]] ||
    die "missing $BUILD_DIR/compile_commands.json; run ./dev configure first"

  local args=(
    -p "$BUILD_DIR"
    -j "$JOBS"
    -quiet
    -clang-tidy-binary "$CLANG_TIDY"
  )
  if $fix; then
    args+=(-fix)
  fi
  local sdkroot
  sdkroot="$(xcrun --sdk macosx --show-sdk-path 2>/dev/null || true)"
  if [[ -n "$sdkroot" ]]; then
    args+=(-extra-arg=-isysroot -extra-arg="$sdkroot")
  fi

  local files=()
  if $all; then
    while IFS= read -r file; do
      files+=("$file")
    done < <(tidy_files)
    if ((${#files[@]} == 0)); then
      die "no source files found for clang-tidy"
    fi
    log "clang-tidy: ${#files[@]} files (parallel)"
    "$RUN_CLANG_TIDY" "${args[@]}" "${files[@]}"
    return
  fi

  while IFS= read -r file; do
    [[ -n "$file" ]] && files+=("$file")
  done < <(changed_tidy_files)
  if ((${#files[@]} == 0)); then
    log "clang-tidy: no changed source files, skipping"
    return
  fi
  log "clang-tidy: ${#files[@]} changed file(s) (parallel)"
  "$RUN_CLANG_TIDY" "${args[@]}" "${files[@]}"
}

cmd_test() {
  local dir="$BUILD_DIR"
  if [[ $# -gt 0 && "$1" != -* ]]; then
    dir="$1"
    shift
  fi
  log "test ($dir)"
  if [[ "$dir" == "build/dev" && "$BUILD_DIR" == "build/dev" ]]; then
    ctest --preset dev --output-on-failure "$@"
  elif [[ "$dir" == "build/asan" && "$ASAN_DIR" == "build/asan" ]]; then
    ctest --preset asan --output-on-failure "$@"
  else
    ctest --test-dir "$dir" --output-on-failure "$@"
  fi
}

cmd_check() {
  parse_check_args "$@"
  if $CHECK_FAST; then
    log "fast check (changed tidy only, no sanitizer)"
  fi
  cmd_format
  cmd_configure "$BUILD_DIR"
  cmd_build "$BUILD_DIR"
  if $CHECK_TIDY_ALL; then
    cmd_tidy --all
  else
    cmd_tidy --changed
  fi
  cmd_test "$BUILD_DIR"
  if $CHECK_SANITIZER; then
    cmd_configure "$ASAN_DIR" -DNIMINAL_SANITIZERS=ON
    cmd_build "$ASAN_DIR"
    cmd_test "$ASAN_DIR"
  fi
}

usage() {
  cat <<EOF
Usage: ./dev <command> [options]

Commands:
  check       format, configure, build, clang-tidy, test, sanitizer test
  format      check formatting (--fix to rewrite)
  configure   configure the build (default: $BUILD_DIR)
  build       compile; pass --target to build one target (default: $BUILD_DIR)
  tidy        run clang-tidy (default: $BUILD_DIR)
  test        run ctest; pass -R to select suites (default: $BUILD_DIR)
  sanitizer   configure, build, and test with ASan/UBSan ($ASAN_DIR)

Focused feedback loop:
  ./dev configure
  ./dev build --target niminal_agent_test
  ./dev test -R '^agent$'
  ./dev check              # full validation before completing a change

Check options:
  --fast          skip sanitizer; tidy only changed src/include .cpp files
  --no-sanitizer  skip the ASan/UBSan build and tests
  --changed-tidy  tidy only changed src/include .cpp files
  --all-tidy      tidy all src/include .cpp files (default)

Tidy options:
  --fix           apply clang-tidy fixes
  --all           tidy all src/include .cpp files (default)
  --changed       tidy only changed src/include .cpp files

Environment:
  JOBS            parallel build/tidy jobs (default: $JOBS)
EOF
}

case "${1:-}" in
  check) shift; cmd_check "$@" ;;
  format) cmd_format "${2:-}" ;;
  configure)
    shift
    cmd_configure "$@"
    ;;
  build)
    shift
    cmd_build "$@"
    ;;
  tidy)
    shift
    cmd_tidy "$@"
    ;;
  test)
    shift
    cmd_test "$@"
    ;;
  sanitizer)
    cmd_configure "$ASAN_DIR" -DNIMINAL_SANITIZERS=ON
    cmd_build "$ASAN_DIR"
    cmd_test "$ASAN_DIR"
    ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $1 (run ./dev help)" ;;
esac
